<!-- snippets/stacked-text.liquid -->

{%- doc -%}
  Renders stacked heading, description, and up to two themed buttons.
  @param {string} [bg_color] - Background color token. Defaults to `transparent`.
  @param {string} [button_link_1] - Primary button URL.
  @param {string} [button_link_2] - Secondary button URL.
  @param {string} [button_style_1] - Primary button style.
  @param {string} [button_style_2] - Secondary button style.
  @param {string} [button_text_1] - Primary button text.
  @param {string} [button_text_2] - Secondary button text.
  @param {string} [color] - Text color token. Defaults to `body`.
  @param {boolean} [cover_link] - Indicate buttons are covered by surrounding link.
  @param {string} [description] - Rich text body.
  @param {string} [description_type] - Description style token. Defaults to `rte-content`.
  @param {string} [heading_type] - Heading style token.
  @param {string} [highlight_color] - Highlight color token.
  @param {string} [highlight_text] - Text to highlight inside title.
  @param {string} [highlight_type] - Highlight style token.
  @param {string} [id] - Transition container id.
  @param {string} [mobile_button_style_1] - Primary mobile button style.
  @param {string} [mobile_button_style_2] - Secondary mobile button style.
  @param {string} [mobile_color] - Mobile text color override.
  @param {boolean} [mobile_hide_description] - Hide description on mobile.
  @param {string} [mobile_x_alignment] - Mobile horizontal alignment.
  @param {string} [mobile_y_alignment] - Mobile vertical alignment.
  @param {string} [overline] - Overline text.
  @param {string} [style] - Text style token.
  @param {string} [title] - Heading text.
  @param {number} [width] - Max text width in px.
  @param {string} [x_alignment] - Desktop horizontal alignment.
  @param {string} [y_alignment] - Desktop vertical alignment.
{%- enddoc -%}

{%- liquid
  assign text_exists = false
  if overline != blank or title != blank or description != blank or button_text_1 != blank or button_text_2 != blank
    assign text_exists = true
  endif

  assign bg_color = bg_color | default: 'transparent'
  assign color = color | default: 'body'
  assign description_type = description_type | default: 'rte-content'
  assign mobile_color = mobile_color | default: color
-%}

{%- if text_exists -%}
  <div
    class="stacked-text--root"
    data-text-color="{{ color }}"
    data-mobile-text-color="{{ mobile_color }}"
    data-mobile-x-alignment="{{ mobile_x_alignment }}"
    data-mobile-y-alignment="{{ mobile_y_alignment }}"
    data-x-alignment="{{ x_alignment }}"
    data-y-alignment="{{ y_alignment }}"
  >
    <div
      class="stacked-text--wrapper"
      data-background-color="{{ bg_color }}"
      data-container="block"
      data-text-style="{{ style }}"
      data-translucent="{{ settings.content--box-translucent }}"
      {% unless settings.transitions--text or id == 'viewport' %}
        data-transition-container="{{ id }}"
        data-transition-type="slide-in"
        data-transition-cascade="vertical"
        data-transition-cascade-interval="500"
      {% endunless %}
      {% unless width == blank %}
        data-text-width
        style="--text-width:{{ width }}px;"
      {% endunless %}
    >
      {%- unless overline == blank -%}
        <div
          class="stacked-text--overline"
          {% unless settings.transitions--text %}
            data-transition-item="{{ id }}"
          {% endunless %}
        >
          <h3 data-item="overline">
            {{- overline | escape -}}
          </h3>
        </div>
      {%- endunless -%}

      {%- unless title == blank -%}
        <div
          {% unless settings.transitions--text %}
            data-transition-item="{{ id }}"
          {% endunless %}
        >
          <h2 class="stacked-text--title" data-item="{{ heading_type }}">
            {%-
              render 'utils',
              name: 'highlighted-text',
              text: title,
              highlight_color: highlight_color,
              highlight_text: highlight_text,
              highlight_type: highlight_type
            -%}
          </h2>
        </div>
      {%- endunless -%}

      {%- unless description == blank -%}
        <div
          class="stacked-text--description"
          data-item="{{ description_type }}"
          {% if mobile_hide_description %}
            data-mq="medium-large"
          {% endif %}
          {% unless settings.transitions--text %}
            data-transition-item="{{ id }}"
          {% endunless %}
        >
          {{- description -}}
        </div>
      {%- endunless -%}

      {%- unless button_text_1 == blank and button_text_2 == blank -%}
        <div
          class="stacked-text--button-container"
          {% unless settings.transitions--text %}
            data-transition-item="{{ id }}"
            data-transition-type="fade-in"
          {% endunless %}
        >
          {%- unless button_text_1 == blank -%}
            {%- if cover_link -%}
              <div
                class="stacked-text--button"
                data-item="{{ button_style_1 }}"
                {% unless mobile_button_style_1 == blank %}
                  data-mobile-item="{{ mobile_button_style_1 }}"
                {% endunless %}
                data-text="{{ button_text_1 }}"
              >
                <span>{{- button_text_1 -}}</span>
              </div>
            {%- else -%}
              <a
                class="stacked-text--button"
                href="{{ button_link_1 }}"
                data-item="{{ button_style_1 }}"
                {% unless mobile_button_style_1 == blank %}
                  data-mobile-item="{{ mobile_button_style_1 }}"
                {% endunless %}
                data-text="{{ button_text_1 }}"
              >
                <span>{{- button_text_1 -}}</span>
              </a>
            {%- endif -%}
          {%- endunless -%}

          {%- unless button_text_2 == blank -%}
            {%- if cover_link -%}
              <div
                class="stacked-text--button"
                data-item="{{ button_style_2 }}"
                {% unless mobile_button_style_2 == blank %}
                  data-mobile-item="{{ mobile_button_style_2 }}"
                {% endunless %}
                data-text="{{ button_text_2 }}"
              >
                <span>{{- button_text_2 -}}</span>
              </div>
            {%- else -%}
              <a
                class="stacked-text--button"
                href="{{ button_link_2 }}"
                data-item="{{ button_style_2 }}"
                {% unless mobile_button_style_2 == blank %}
                  data-mobile-item="{{ mobile_button_style_2 }}"
                {% endunless %}
                data-text="{{ button_text_2 }}"
              >
                <span>{{- button_text_2 -}}</span>
              </a>
            {%- endif -%}
          {%- endunless -%}
        </div>
      {%- endunless -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .stacked-text--root {
    display: flex;
    pointer-events: none; /* image hover effect */
    /* for justify-self/align-self the parent needs to be a grid */
    align-self: var(--y-alignment);
    justify-self: var(--x-alignment);
    justify-content: var(--x-alignment);

    @media (min-width: 768px) {
      align-items: var(--y-alignment);
      width: fit-content;
      z-index: 1;
    }

    @media (max-width: 767px) {
      z-index: 2;
      width: 100%;
    }
  }

  /* padding + [data-text-width]: per-side vars, then --text-padding-y / --text-padding-x, then optional --text-padding shorthand. */
  .stacked-text--wrapper {
    pointer-events: none; /* image hover effect */
    padding: var(--text-padding, var(--text-padding-top, var(--text-padding-y, 0px))
        var(--text-padding-right, var(--text-padding-x, 0px)) var(--text-padding-bottom, var(--text-padding-y, 0px))
        var(--text-padding-left, var(--text-padding-x, 0px)));
    align-items: var(--x-alignment);
    text-align: var(--text-alignment);
    border-radius: var(--image--radius);

    @media (min-width: 768px) {
      .stacked-text--root:not([data-y-alignment='none']) & {
        --text-padding-x: var(--spacing--section--x);
        --text-padding-y: var(--spacing--section--x);
      }

      &[data-background-color]:not([data-background-color='transparent']) {
        --text-padding-x: var(--spacing--block);
        --text-padding-y: var(--spacing--block);
        margin: var(--spacing--block) var(--spacing--section--x);
      }
    }

    @media (max-width: 767px) {
      .stacked-text--root:not([data-y-alignment='none']) & {
        --text-padding-x: var(--spacing--item);
        --text-padding-y: var(--spacing--item);
      }

      &:not([data-background-color='transparent']) {
        margin: var(--spacing--item);
      }
    }
  }

  .stacked-text--overline {
    max-width: 600px;
  }

  .stacked-text--description {
    max-width: 600px;

    a {
      pointer-events: all;
    }
  }

  .stacked-text--button-container {
    display: flex;
    gap: var(--spacing--item);
    flex-wrap: wrap;
    align-items: var(--x-alignment);
    justify-content: var(--x-alignment);
  }
{% endstylesheet %}