<!-- sections/featured-collection.liquid -->

{%- liquid
  assign skip_link_t = 'sections.featured_collection.skip_link' | t

  assign bg_color = section.settings.background-color
  assign border = section.settings.border
  assign button_style = section.settings.button-style
  assign button_text = section.settings.button-text
  assign collection = collections[section.settings.collection]
  assign container_width = section.settings.container-width
  assign columns = section.settings.columns | plus: 0
  assign display_type = section.settings.display-type
  assign heading = section.settings.heading
  assign heading_type = section.settings.heading-type
  assign max_blocks = section.settings.max-blocks
  assign mobile_columns = section.settings.mobile-columns | plus: 0
  assign mobile_full_width = false
  assign mobile_heading_alignment = section.settings.mobile-heading-alignment
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign section_alignment = section.settings.section-alignment
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign text_color = section.settings.text-color

  assign full_width = false
  if container_width == '6'
    assign full_width = true
  endif

  assign onboarding = true
  if collection.handle.size > 0 and collection.products_count != 0
    assign onboarding = false
  endif

  capture sizes
    render 'sizes-grid', columns: columns, container_width: container_width, mobile_columns: mobile_columns, mobile_full_width: mobile_full_width
  endcapture

  assign promo_grid_blocks = 0
  for block in section.blocks
    assign block_position = block.settings.position
    if block_position > max_blocks
      continue
    endif

    assign promo_width = block.settings.promo-width | plus: 0
    assign promo_columns = columns | divided_by: promo_width
    assign mobile_promo_columns = 1
    if promo_width == 1 and mobile_columns == 2
      assign mobile_promo_columns = 2
    endif

    capture promo_sizes
      render 'sizes-grid', columns: promo_columns, container_width: container_width, mobile_columns: mobile_promo_columns, mobile_full_width: mobile_full_width
    endcapture

    comment
      This logic lets a double-wide block render at the end even if there's only space for one block
    endcomment
    if block_position == max_blocks
      assign promo_grid_blocks = promo_grid_blocks | plus: 1
    else
      assign promo_grid_blocks = promo_grid_blocks | plus: promo_width
    endif

    capture promo_html
      unless promo_html == blank
        echo promo_html | append: '<span class="divider"></span>'
      endunless

      assign loading = 'lazy'
      if block_position <= columns and section.index < 3
        assign loading = 'eager'
      endif

      render 'collection-promo', section_id: section.id, block: block, promo_width: promo_width, sizes: promo_sizes, loading: loading, full_width: full_width
    endcapture
  endfor

  assign promo_html_arr = promo_html | split: '<span class="divider"></span>'
  assign max_blocks = max_blocks | minus: promo_grid_blocks | plus: promo_html_arr.size

  capture grid_items
    assign product_index = 0

    for i in (1..max_blocks)
      assign grid_index = forloop.index
      assign promo_index = false
      assign loading = 'lazy'
      if forloop.index <= columns and section.index < 3
        assign loading = 'eager'
      endif

      for block in section.blocks
        if block.settings.position == grid_index
          assign promo_index = forloop.index0
          break
        endif
      endfor

      if promo_index
        echo promo_html_arr[promo_index]
      elsif onboarding
        capture placeholder_index
          cycle '1', '2', '3', '4', '5', '6'
        endcapture

        render 'product-card', onboarding: true, placeholder_index: placeholder_index, transition_id: section.id, full_width: full_width
      elsif product_index < collection.products.size
        assign product = collection.products[product_index]
        assign product_index = product_index | plus: 1
        render 'product-card', product_item: product, transition_id: section.id, sizes: sizes, loading: loading, full_width: full_width
      else
        break
      endif
      echo '<span class="divider"></span>'
    endfor
  endcapture

  assign grid_items_arr = grid_items | split: '<span class="divider"></span>'
-%}

<div
  class="featured-collection--root"
  data-section-id="{{ section.id }}"
  data-background-color="{{ bg_color }}"
  data-border="{{ border }}"
  data-container-width="{{ container_width }}"
  data-mobile-full-width="{{ mobile_full_width }}"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-text-color="{{ text_color }}"
  data-section-type="index_featured_collection"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
>
  <div class="featured-collection--wrapper" data-container="section">
    {%- unless heading == blank and display_type == 'grid' -%}
      <div
        class="featured-collection--header-nav"
        data-container="nav"
        data-x-alignment="{{ section_alignment }}"
        data-mobile-x-alignment="{{ mobile_heading_alignment }}"
      >
        <div class="featured-collection--header" data-container="block">
          {%- unless heading == blank -%}
            <h2
              class="featured-collection--title"
              data-item="{{ heading_type }}"
              {% unless settings.transitions--text %}
                data-transition-item="viewport"
                data-transition-type="slide-in"
              {% endunless %}
            >
              <a href="{{ collection.url }}">
                {{- heading -}}
              </a>
            </h2>
          {%- endunless -%}
        </div>

        {%- liquid
          if display_type == 'slideshow'
            assign blocks_per_slide_desktop = columns | plus: 0.0
            assign blocks_per_slide_mobile = mobile_columns | plus: 0.0
            assign total_slides = grid_items_arr.size | divided_by: blocks_per_slide_desktop | ceil
            assign total_slides_mobile = grid_items_arr.size | divided_by: blocks_per_slide_mobile | ceil
            render 'carousel-nav-arrow', id: section.id, total_slides_mobile: total_slides_mobile, total_slides: total_slides
          endif
        -%}
      </div>
    {%- endunless -%}

    <div
      class="featured-collection--products"
      data-display-type="{{ display_type }}"
      {% if display_type == 'grid' %}
        data-container="panel"
        data-columns="{{ columns }}"
        data-mobile-columns="{{ mobile_columns }}"
      {% endif %}
      {% unless settings.transitions--other %}
        data-transition-container="{{ section.id }}"
        data-transition-type="fade-in"
        data-transition-cascade="horizontal"
        data-transition-cascade-interval="200"
      {% endunless %}
    >
      {%- if collection.products.size > max_blocks -%}
        <a data-item="a11y-button" href="#featured_collection_show_more">
          {{- skip_link_t -}}
        </a>
      {%- endif -%}

      {%- if display_type == 'slideshow' -%}
        {%-
          render 'card-carousel',
          section: section,
          blocks: grid_items_arr,
          blocks_per_slide: columns,
          blocks_per_slide_mobile: mobile_columns,
          spacing_around_blocks: true,
          total_blocks: grid_items_arr.size
        -%}

      {%- else -%}
        {%- liquid
          for grid_item in grid_items_arr
            echo grid_item
          endfor

          assign remainder = grid_items_arr.size | modulo: columns
          assign blank_count = 0
          if remainder > 0
            assign blank_count = columns | minus: remainder
          endif
        -%}

        {%- if blank_count > 0 -%}
          {%- for i in (1..blank_count) -%}
            <div
              data-item="blank"
              aria-hidden="true"
              {% unless settings.transitions--other %}
                data-transition-item="{{ section.id }}"
              {% endunless %}
            ></div>
          {%- endfor -%}
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- unless button_text == blank -%}
      <div data-container="block" data-x-alignment="{{ section_alignment }}">
        <a
          id="featured_collection_show_more"
          href="{{ collection.url }}"
          class="featured-collection--show-more"
          data-text="{{ button_text }}"
          data-item="{{ button_style }}"
        >
          <span>{{- button_text -}}</span>
        </a>
      </div>
    {%- endunless -%}
  </div>
</div>

{% stylesheet %}
  .featured-collection--root {
    :is(.collection-promo--root, .card-carousel--block) {
      height: 100%;
    }
  }

  .featured-collection--item {
    @media (max-width: 767px) {
      width: 100%;

      .placeholder--root {
        min-height: 256px;
      }
    }
  }
{% endstylesheet %}

