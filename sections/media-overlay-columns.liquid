<!-- sections/media-overlay-columns.liquid -->

{%- liquid
  assign aspect_style = section.settings.aspect-ratio
  assign bg_color = section.settings.background-color
  assign block_spacing = section.settings.spacing
  assign block_text_color = section.settings.block-text-color
  assign border = section.settings.border
  assign columns = section.blocks.size | at_least: 2
  assign container_width = section.settings.container-width
  assign heading = section.settings.heading
  assign heading_text_color = section.settings.heading-text-color
  assign heading_type = section.settings.heading-type
  assign mobile_columns = 1
  assign mobile_media_layout = section.settings.mobile-media-layout
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign mobile_heading_alignment = section.settings.mobile-heading-alignment
  assign overline = section.settings.overline
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign heading_alignment = section.settings.heading-alignment
  assign text_style = section.settings.text-style

  assign loading = 'lazy'
  if section.index < 3
    assign loading = 'eager'
  endif

  assign fetchpriority = 'auto'
  if section.index == 1
    assign fetchpriority = 'high'
  endif

  assign header_exists = false
  unless heading == blank and overline == blank
    assign header_exists = true
  endunless

  assign full_width = false
  if container_width == '6' or block_spacing == false
    assign full_width = true
  endif

  assign mobile_full_width = false
  if mobile_media_layout == 'grid'
    assign mobile_full_width = section.settings.mobile-full-width
  endif

  capture sizes
    render 'sizes-grid', container_width: container_width, columns: columns, full_width: full_width, mobile_columns: mobile_columns, mobile_full_width: mobile_full_width
  endcapture
-%}

{%- capture media_blocks -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign block_media_type = block.settings.media-type
      assign block_image = block.settings.image
      assign block_video_upload = block.settings.video-upload
      assign block_video_url = block.settings.video-url
      assign block_overline = block.settings.overline
      assign block_heading = block.settings.heading
      assign block_heading_type = block.settings.heading-type
      assign block_description = block.settings.description
      assign block_button_text = block.settings.button-text
      assign block_button_link = block.settings.button-link
      assign block_button_style = block.settings.button-style
      assign block_mobile_text_x_alignment = block.settings.mobile-text-horizontal-alignment
      assign block_mobile_text_y_alignment = block.settings.mobile-text-vertical-alignment
      assign block_text_x_alignment = block.settings.text-horizontal-alignment
      assign block_text_y_alignment = block.settings.text-vertical-alignment
      assign overlay_style = block.settings.overlay-style

      assign block_description_has_link = false
      if block_description contains '<a'
        assign block_description_has_link = true
      endif

      assign cover_link = false
      assign tag = 'div'
      if block_button_link != blank and block_description_has_link == false
        assign cover_link = true
        assign tag = 'a'
      endif
    -%}

    <{{ tag }}
      class="media-overlay-columns--block"
      {% if cover_link %}
        href="{{ block_button_link }}"
      {% endif %}
      data-media-type="{{ block.settings.media-type }}"
      {{ block.shopify_attributes }}
    >
      <div
        class="media-overlay-columns--block--media"
        data-aspect-ratio="{{ aspect_style }}"
      >
        {%- liquid
          if block_media_type == 'image'
            if block_image
              render 'image', image: block_image, fetchpriority: fetchpriority, full_width: full_width, loading: loading, mobile_full_width: mobile_full_width, mobile_overlay_style: overlay_style, overlay_style: overlay_style, sizes: sizes
            else
              capture placeholder_index
                cycle '1', '2'
              endcapture

              render 'placeholder', type: 'lifestyle', placeholder_index: placeholder_index, full_width: full_width, mobile_full_width: mobile_full_width, mobile_overlay_style: overlay_style, overlay_style: overlay_style, overlay_text_color: block_text_color
            endif
          elsif block_media_type == 'video'
            render 'video', full_width: full_width, id: block.id, loading: loading, mobile_full_width: mobile_full_width, overlay_style: overlay_style, video_upload: block_video_upload, video_url: block_video_url
          endif
        -%}
      </div>

      {%-
        render 'stacked-text',
        button_link_1: block_button_link,
        button_style_1: block_button_style,
        button_text_1: block_button_text,
        color: block_text_color,
        cover_link: cover_link,
        description: block_description,
        heading_type: block_heading_type,
        id: block.id,
        mobile_x_alignment: block_mobile_text_x_alignment,
        mobile_y_alignment: block_mobile_text_y_alignment,
        overline: block_overline,
        style: text_style,
        title: block_heading,
        x_alignment: block_text_x_alignment,
        y_alignment: block_text_y_alignment
      -%}
    </{{ tag }}>

    {%- unless forloop.last -%}
      <span class="divider"></span>
    {%- endunless -%}
  {%- endfor -%}
{%- endcapture -%}

{%- assign block_html_arr = media_blocks | split: '<span class="divider"></span>' -%}

<div
  class="media-overlay-columns--root"
  data-section-id="{{ section.id }}"
  data-background-color="{{ bg_color }}"
  data-block-spacing="{{ block_spacing }}"
  data-border="{{ border }}"
  data-container-width="{{ container_width }}"
  data-mobile-full-width="{{ mobile_full_width }}"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
>
  <div class="media-overlay-columns--wrapper" data-container="section">
    {%- if header_exists or mobile_media_layout == 'slideshow' -%}
      <div
        class="media-overlay-columns--header-nav"
        data-container="nav"
        data-x-alignment="{{ heading_alignment }}"
        data-mobile-x-alignment="{{ mobile_heading_alignment }}"
      >
        <div
          class="media-overlay-columns--header"
          data-container="block"
          data-text-color="{{ heading_text_color }}"
          {% unless settings.transitions--text %}
            data-transition-container="{{ section.id }}-header"
            data-transition-type="slide-in"
            data-transition-cascade="vertical"
            data-transition-cascade-interval="500"
          {% endunless %}
        >
          {%- unless overline == blank -%}
            <div
              class="media-overlay-columns--overline"
              {% unless settings.transitions--text %}
                data-transition-item="{{ section.id }}-header"
              {% endunless %}
            >
              <p data-item="overline">
                {{- overline | escape -}}
              </p>
            </div>
          {%- endunless -%}

          {%- unless heading == blank -%}
            <div
              class="media-overlay-columns--heading"
              {% unless settings.transitions--text %}
                data-transition-item="{{ section.id }}-header"
              {% endunless %}
            >
              <h2 data-item="{{ heading_type }}">
                {{- heading | escape -}}
              </h2>
            </div>
          {%- endunless -%}
        </div>

        {%- if mobile_media_layout == 'slideshow' -%}
          <div
            class="media-overlay-columns--navigation"
            data-mq="small"
          >
            {%-
              render 'carousel-nav-arrow',
              id: section.id,
              total_slides_mobile: block_html_arr.size
            -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if mobile_media_layout == 'grid' -%}
      <div
        class="media-overlay-columns--grid"
        data-container="panel"
        data-columns="{{ columns }}"
        data-mobile-columns="{{ mobile_columns }}"
      >
        {%- liquid
          for block_html in block_html_arr
            echo block_html
          endfor
        -%}
      </div>
    {%- else -%}
      {%-
        render 'card-carousel',
        section: section,
        blocks: block_html_arr,
        blocks_per_slide: columns,
        blocks_per_slide_mobile: mobile_columns,
        mobile_only: true,
        mobile_next_visible: true,
        mobile_spacing_around_blocks: true,
        spacing_around_blocks: block_spacing,
        total_blocks: block_html_arr.size
      -%}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .media-overlay-columns--root {
    @media (max-width: 767px) {
      .stacked-text--root[data-y-alignment] .stacked-text--wrapper {
        --text-padding-x: var(--spacing--item);
        --text-padding-y: var(--spacing--item);
      }
    }

    @media (min-width: 768px) {
      .stacked-text--root[data-y-alignment] .stacked-text--wrapper {
        --text-padding-x: var(--spacing--block);
        --text-padding-y: var(--spacing--block);
      }
    }
  }

  .media-overlay-columns--block {
    display: grid;
    height: 100%;

    > * {
      grid-area: 1 / -1;
    }
  }

  .media-overlay-columns--grid {
    @media (min-width: 768px) {
      .media-overlay-columns--root[data-block-spacing='false'] & {
        --grid-column-gap: 0;
      }
    }
  }
{% endstylesheet %}

