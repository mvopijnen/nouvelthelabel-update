{% comment %}
  Premium Collection Highlights V11 - Typography Choice
  Toegevoegd: Keuze tussen Luxe Fonts (Cormorant/Inter) of je eigen Thema Fonts.
{% endcomment %}

{% unless section.settings.use_theme_fonts %}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&amp;family=Inter:wght@300;400;500&amp;display=swap">
{% endunless %}
<style>

  .ch-wrapper-{{ section.id }} {
    display: block;
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
    width: 100%;
    
    /* Font Keuze Logica */
    {% if section.settings.use_theme_fonts %}
      --ch-font-title: var(--font--heading--family);
      --ch-font-body: var(--font--paragraph--family);
    {% else %}
      --ch-font-title: 'Cormorant Garamond', serif;
      --ch-font-body: 'Inter', sans-serif;
    {% endif %}
  }

  .ch-container {
    margin: 0 auto;
    max-width: var(--page-width, 1200px);
    padding: 0 20px;
  }

  @media screen and (min-width: 990px) {
    .ch-container {
      padding-left: calc(20px + {{ section.settings.desktop_offset_left }}px);
      padding-right: calc(20px + {{ section.settings.desktop_offset_right }}px);
    }
  }

  .ch-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  @media screen and (min-width: 990px) {
    .ch-grid {
      flex-direction: {% if section.settings.img_pos == 'left' %}row{% else %}row-reverse{% endif %};
      align-items: center;
      gap: 60px;
    }
    .ch-image-col { flex: 0 0 52%; }
    .ch-text-col { flex: 0 0 48%; }
  }

  .ch-viewport {
    position: relative;
    aspect-ratio: {{ section.settings.img_ratio | replace: ':', '/' }};
    overflow: hidden;
    background-color: #f0f0f0;
    width: 100%;
    transform: translateZ(0);
  }

  .ch-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.02) translateZ(0);
    transition: opacity 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94), 
                transform 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: opacity, transform;
    visibility: hidden;
  }

  .ch-img.is-active {
    opacity: 1;
    transform: scale(1) translateZ(0);
    visibility: visible;
  }

  .ch-items-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-align: {{ section.settings.text_align }};
  }

  .ch-item {
    border-{% if section.settings.text_align == 'left' %}left{% else %}right{% endif %}: 1px solid rgba(0,0,0,0.08);
    padding: 1rem {% if section.settings.text_align == 'left' %}0 1rem 1.5rem{% else %}1.5rem 1rem 0{% endif %};
    cursor: pointer;
    transition: all 0.4s ease;
    opacity: 0.3;
    text-decoration: none;
    display: block;
  }

  .ch-item.is-active {
    opacity: 1;
    border-{% if section.settings.text_align == 'left' %}left{% else %}right{% endif %}: 2px solid {{ section.settings.active_color }};
    padding-{% if section.settings.text_align == 'left' %}left{% else %}right{% endif %}: 2.2rem;
  }

  .ch-title {
    font-family: var(--ch-font-title);
    font-size: clamp(22px, 2.5vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    color: {{ section.settings.title_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ch-details {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: all 0.5s ease;
  }

  .ch-item.is-active .ch-details {
    max-height: 400px;
    opacity: 1;
    margin-top: 1rem;
  }

  .ch-desc {
    font-family: var(--ch-font-body);
    font-size: {{ section.settings.desc_size }}px;
    line-height: 1.6;
    color: {{ section.settings.desc_color }};
    margin-bottom: 1.2rem;
    {% if section.settings.text_align == 'right' %}margin-left: auto;{% endif %}
    max-width: 450px;
  }

  .ch-btn {
    font-family: var(--ch-font-body);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
    color: {{ section.settings.title_color }};
    border-bottom: 1px solid {{ section.settings.title_color }};
    padding-bottom: 3px;
    display: inline-block;
    text-decoration: none;
  }

  @media screen and (max-width: 989px) {
    {% if section.settings.mobile_layout == 'list' %}
      .ch-item { opacity: 1; border: none; padding: 0; margin-bottom: 3.5rem; text-align: left; }
      .ch-viewport { margin-bottom: 1.5rem; }
      .ch-details { max-height: none; opacity: 1; }
      .ch-img { position: relative; opacity: 1; transform: none; display: none; visibility: visible; }
      .ch-img:first-child { display: block; }
    {% else %}
      .ch-item { padding: 0.8rem 0 0.8rem 1.2rem; text-align: left; border-right: none; border-left: 1px solid rgba(0,0,0,0.08); }
      .ch-item.is-active { padding-left: 1.6rem; border-left: 2px solid {{ section.settings.active_color }}; }
    {% endif %}
  }
</style>

<collection-highlights class="ch-wrapper-{{ section.id }}" data-mobile-layout="{{ section.settings.mobile_layout }}">
  <div class="ch-container">
    <div class="ch-grid">
      
      <div class="ch-image-col">
        <div class="ch-viewport">
          {% for block in section.blocks %}
            {% if block.settings.image != blank %}
              <img 
                src="{{ block.settings.image | image_url: width: 1000 }}"
                srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 700 }} 700w, {{ block.settings.image | image_url: width: 1000 }} 1000w"
                sizes="(min-width: 990px) 50vw, 100vw"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}" 
                class="ch-img {% if forloop.first %}is-active{% endif %}" 
                data-idx="{{ forloop.index0 }}"
                alt="{{ block.settings.title | escape }}"
                loading="{% if forloop.first and section.index <= 2 %}eager{% else %}lazy{% endif %}"
              >
            {% else %}
              <div class="ch-img {% if forloop.first %}is-active{% endif %}" style="background: #eee;"></div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="ch-text-col">
        <div class="ch-items-list">
          {% for block in section.blocks %}
            <div class="ch-item {% if forloop.first %}is-active{% endif %}" data-idx="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <h3 class="ch-title">{{ block.settings.title }}</h3>
              <div class="ch-details">
                <p class="ch-desc">{{ block.settings.description }}</p>
                <a href="{{ block.settings.link }}" class="ch-btn">{{ section.settings.btn_text }}</a>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

    </div>
  </div>
</collection-highlights>

<script>
  (() => {
    if (customElements.get('collection-highlights')) return;
    class CollectionHighlights extends HTMLElement {
      connectedCallback() {
        const wrapper = this;
        wrapper.collectionHighlightsCleanup?.();
        const controller = new AbortController();
        const { signal } = controller;
        let observer;
        let frame = 0;
        let currentIdx = 0;
        let initialized = false;
        let items;
        let images;

        const cleanup = () => {
          observer?.disconnect();
          cancelAnimationFrame(frame);
          controller.abort();
          delete wrapper.dataset.initialized;
          delete wrapper.collectionHighlightsCleanup;
        };
        wrapper.collectionHighlightsCleanup = cleanup;

        const updateActive = (idx) => {
          if (idx === currentIdx || frame || signal.aborted) return;
          frame = requestAnimationFrame(() => {
            frame = 0;
            if (signal.aborted) return;
            items.forEach((item, index) => {
              item.classList.toggle('is-active', index === idx);
              images[index]?.classList.toggle('is-active', index === idx);
            });
            currentIdx = idx;
          });
        };
        const init = () => {
          if (initialized || signal.aborted) return;
          initialized = true;
          items = wrapper.querySelectorAll('.ch-item');
          images = wrapper.querySelectorAll('.ch-img');
          currentIdx = Math.max(0, [...items].findIndex(item => item.classList.contains('is-active')));
          wrapper.dataset.initialized = 'true';
          let bound = false;
          observer = new IntersectionObserver((entries) => {
            if (bound || signal.aborted || !entries.some(entry => entry.isIntersecting)) return;
            bound = true;
            items.forEach((item, index) => {
              item.addEventListener('mouseenter', () => {
                if (window.innerWidth >= 990) updateActive(index);
              }, { signal });
              item.addEventListener('click', (event) => {
                if (window.innerWidth < 990 && wrapper.dataset.mobileLayout === 'interactive') {
                  if (event.target.closest('a')) return;
                  updateActive(index);
                }
              }, { signal });
            });
            observer.disconnect();
          }, { threshold: 0.1 });
          observer.observe(wrapper);
        };
        document.addEventListener('shopify:section:unload', (event) => {
          if (event.target === wrapper || event.target.contains(wrapper)) cleanup();
        }, { signal });
        // The custom element initializes replacement markup even if inline scripts are not re-executed.
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init, { once: true, signal });
        } else {
          queueMicrotask(init);
        }
      }
      disconnectedCallback() {
        this.collectionHighlightsCleanup?.();
      }
    }
    customElements.define('collection-highlights', CollectionHighlights);
  })();
</script>

{% schema %}
{
  "name": "Collection Highlights V11",
  "settings": [
    {
      "type": "header",
      "content": "Typografie"
    },
    {
      "type": "checkbox",
      "id": "use_theme_fonts",
      "label": "Gebruik Thema Lettertypes",
      "default": false,
      "info": "Vink dit aan om de lettertypes van je eigen Shopify thema te gebruiken in plaats van de Luxe Fonts."
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Titel grootte",
      "default": 32
    },
    {
      "type": "range",
      "id": "desc_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Body lettergrootte",
      "default": 15
    },
    {
      "type": "header",
      "content": "Uitlijning & Positie"
    },
    {
      "type": "range",
      "id": "desktop_offset_left",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Inspringing Links (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_offset_right",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Inspringing Rechts (Desktop)",
      "default": 0
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Tekst Uitlijning",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "right", "label": "Rechts" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "img_pos",
      "label": "Positie afbeelding (Desktop)",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "right", "label": "Rechts" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "img_ratio",
      "label": "Beeldverhouding",
      "options": [
        { "value": "4:5", "label": "4:5 (Portret)" },
        { "value": "1:1", "label": "1:1 (Vierkant)" },
        { "value": "3:4", "label": "3:4" }
      ],
      "default": "4:5"
    },
    {
      "type": "header",
      "content": "Kleuren"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Achtergrondkleur",
      "default": "#fafaf9"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Titel kleur",
      "default": "#1c1917"
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Beschrijving kleur",
      "default": "#57534e"
    },
    {
      "type": "color",
      "id": "active_color",
      "label": "Actieve rand kleur",
      "default": "#1c1917"
    },
    {
      "type": "header",
      "content": "Overige Instellingen"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobiele Lay-out",
      "options": [
        { "value": "interactive", "label": "Interactief" },
        { "value": "list", "label": "Lijst" }
      ],
      "default": "interactive"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Knop tekst",
      "default": "Ontdek Collectie"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding Boven",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding Onder",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "Collectie Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Afbeelding"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Nieuwe Collectie"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Beschrijving",
          "default": "Korte beschrijving van deze luxe collectie."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Highlights V11",
      "blocks": [
        { "type": "collection_item" },
        { "type": "collection_item" },
        { "type": "collection_item" }
      ]
    }
  ]
}
{% endschema %}
