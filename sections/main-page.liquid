          },
          {
            "label": "Large",
            "value": "large"
          },
          {
            "label": "Extra large",
            "value": "x-large"
          }
        ],
        "default": "large"
      },
      {
        "id": "spacing-below",
        "label": "Spacing below",
        "type": "select",
        "options": [
          {
            "label": "None",
            "value": "none"
          },
          {
            "label": "Small",
            "value": "small"
          },
          {
            "label": "Medium",
            "value": "medium"
          },
          {
            "label": "Large",
            "value": "large"
          },
          {
            "label": "Extra large",
            "value": "x-large"
          }
        ],
        "default": "large"
      },
      {
        "id": "container-width",
        "label": "Maximum container width",
