      },
      {
        "type": "header",
        "content": "Features"
      },
      {
        "id": "show-title",
        "label": "Show title",
        "type": "checkbox",
        "default": true
      },
      {
        "type": "header",
        "content": "Text layout"
      },
      {
        "id": "heading-type",
