<!-- sections/featured-products.liquid -->

{%- liquid
  assign skip_link_t = 'sections.featured_collection.skip_link' | t

  assign bg_color = section.settings.background-color
  assign border = section.settings.border
  assign button_link = section.settings.button-link
  assign button_style = section.settings.button-style
  assign button_text = section.settings.button-text
  assign columns = section.settings.columns | plus: 0
  assign container_width = section.settings.container-width
  assign display_type = section.settings.display-type
  assign heading = section.settings.heading | escape
  assign heading_type = section.settings.heading-type
  assign mobile_columns = section.settings.mobile-columns | plus: 0
  assign mobile_full_width = false
  assign mobile_heading_alignment = section.settings.mobile-heading-alignment
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign product_list = section.settings.product-list
  assign product_limit = columns | times: 2
  assign section_alignment = section.settings.section-alignment
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign text_color = section.settings.text-color

  assign full_width = false
  if container_width == '6'
    assign full_width = true
  endif

  capture sizes
    render 'sizes-grid', columns: columns, container_width: container_width, mobile_columns: mobile_columns, mobile_full_width: mobile_full_width
  endcapture

  capture product_items
    if product_list == blank
      for i in (1..product_limit)
        capture placeholder_index
          cycle '1', '2', '3', '4', '5', '6'
        endcapture

        render 'product-card', onboarding: true, placeholder_index: placeholder_index, transition_id: section.id, full_width: full_width

        unless forloop.last
          echo '<span class="divider"></span>'
        endunless
      endfor

    else
      for product in product_list
        assign loading = 'lazy'
        if forloop.index <= columns and section.index < 3
          assign loading = 'eager'
        endif

        render 'product-card', product_item: product, transition_id: section.id, sizes: sizes, loading: loading, full_width: full_width

        unless forloop.last
          echo '<span class="divider"></span>'
        endunless
      endfor
    endif
  endcapture

  assign product_items_arr = product_items | split: '<span class="divider"></span>'
  assign total_slides = product_items_arr.size | divided_by: 2
-%}

<div
  class="featured-collection--root"
  data-section-id="{{ section.id }}"
  data-background-color="{{ bg_color }}"
  data-border="{{ border }}"
  data-container-width="{{ container_width }}"
  data-mobile-full-width="{{ mobile_full_width }}"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-section-type="index_featured_products"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
  data-text-color="{{ text_color }}"
>
  <div class="featured-collection--wrapper" data-container="section">
    {%- unless heading == blank and display_type == 'grid' -%}
      <div
        class="featured-collection--header-nav"
        data-container="nav"
        data-x-alignment="{{ section_alignment }}"
        data-mobile-x-alignment="{{ mobile_heading_alignment }}"
      >
        <div
          class="featured-collection--header"
          data-container="block"
          {% unless settings.transitions--text %}
            data-transition-item="viewport"
            data-transition-type="slide-in"
          {% endunless %}
        >
          {%- unless heading == blank -%}
            <h2 class="featured-collection--title" data-item="{{ heading_type }}">
              {{- heading -}}
            </h2>
          {%- endunless -%}
        </div>

        {%- liquid
          if display_type == 'slideshow'
            assign blocks_per_slide_desktop = columns | plus: 0.0
            assign blocks_per_slide_mobile = mobile_columns | plus: 0.0
            assign total_slides = product_items_arr.size | divided_by: blocks_per_slide_desktop | ceil
            assign total_slides_mobile = product_items_arr.size | divided_by: blocks_per_slide_mobile | ceil
            render 'carousel-nav-arrow', id: section.id, total_slides_mobile: total_slides_mobile, total_slides: total_slides
          endif
        -%}
      </div>
    {%- endunless -%}

    <div
      class="featured-collection--products"
      data-display-type="{{ display_type }}"
      data-container="panel"
      {%- if display_type == 'grid' -%}
        data-columns="{{ columns }}"
        data-mobile-columns="{{ mobile_columns }}"
      {%- endif -%}
      {% unless settings.transitions--other %}
        data-transition-container="{{ section.id }}"
        data-transition-type="fade-in"
        data-transition-cascade="horizontal"
        data-transition-cascade-interval="200"
      {% endunless %}
    >
      {%- unless button_text == blank -%}
        <a data-item="a11y-button" href="#featured_products_show_more">
          {{- skip_link_t -}}
        </a>
      {%- endunless -%}

      {%- if display_type == 'slideshow' -%}
        {%-
          render 'card-carousel',
          section: section,
          blocks: product_items_arr,
          blocks_per_slide: columns,
          blocks_per_slide_mobile: mobile_columns,
          spacing_around_blocks: true,
          total_blocks: product_items_arr.size,
          total_slides: total_slides
        -%}

      {%- else -%}
        {%- liquid
          for product in product_items_arr
            echo product
          endfor
        -%}
      {%- endif -%}
    </div>

    {%- unless button_text == blank -%}
      <div data-container="block" data-x-alignment="{{ section_alignment }}">
        <a
          id="featured_products_show_more"
          class="featured-collection--show-more"
          href="{{ button_link }}"
          data-text="{{ button_text }}"
          data-item="{{ button_style }}"
        >
          <span>{{ button_text }}</span>
        </a>
      </div>
    {%- endunless -%}
  </div>
</div>

