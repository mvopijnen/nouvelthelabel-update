<!-- sections/image-with-text.liquid -->

{%- liquid
  assign aspect_ratio = 100.0 | divided_by: section.settings.aspect-ratio
  assign bg_color = section.settings.background-color
  assign border = section.settings.border
  assign container_width = section.settings.container-width
  assign display_type = section.settings.image-display-type
  assign image = section.settings.image
  assign mobile_aspect_ratio = 100.0 | divided_by: section.settings.mobile-aspect-ratio
  assign mobile_display_type = section.settings.mobile-image-display-type
  assign mobile_full_width = section.settings.mobile-full-width
  assign mobile_image = section.settings.mobile-image
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign mobile_text_x_alignment = section.settings.mobile-text-horizontal-alignment
  assign mobile_text_y_alignment = section.settings.mobile-text-vertical-alignment
  assign mobile_text_color = section.settings.mobile-text-color
  assign overlap = section.settings.overlap
  assign overlay_style = section.settings.overlay-style
  assign parallax_enabled = section.settings.parallax-enabled
  assign reverse_layout = section.settings.reverse-layout
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign text_color = section.settings.text-color
  assign text_column_width = section.settings.text-column-width
  assign text_style = section.settings.text-style
  assign text_x_alignment = section.settings.text-horizontal-alignment
  assign text_y_alignment = section.settings.text-vertical-alignment

  assign text_bg_color = 'transparent'
  if overlap
    assign text_bg_color = section.settings.text-background-color
  endif

  assign full_width = false
  if container_width == '6'
    assign full_width = true
  endif

  assign fetchpriority = 'auto'
  if section.index == 1
    assign fetchpriority = 'high'
  endif

  assign loading = 'lazy'
  if section.index < 3
    assign loading = 'eager'
  endif

  capture sizes
    render 'sizes-cover', aspect_ratio: aspect_ratio, container_width: container_width, display_type: display_type, mobile_aspect_ratio: mobile_aspect_ratio, mobile_display_type: mobile_display_type, mobile_full_width: mobile_full_width, mobile_original_aspect_ratio: mobile_image.aspect_ratio, original_aspect_ratio: image.aspect_ratio
  endcapture
-%}

<div
  class="image-with-text--root"
  data-section-id="{{ section.id }}"
  data-background-color="{{ bg_color }}"
  data-border="{{ border }}"
  data-container-width="{{ container_width }}"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-mobile-full-width="{{ mobile_full_width }}"
  data-overlap="{{ overlap }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
  style="--text-column-width:{{ text_column_width }}px;"
>
  <div
    class="image-with-text--wrapper"
    data-container="split"
    data-reverse-layout="{{ reverse_layout }}"
  >
    <div
      class="image-with-text--image"
      {% unless settings.transitions--image %}
        data-transition-item="viewport"
        data-transition-type="image"
      {% endunless %}
    >
      {%- if image -%}
        {%-
          render 'image',
          image: image,
          aspect_ratio: aspect_ratio,
          display_type: display_type,
          fetchpriority: fetchpriority,
          full_width: full_width,
          loading: loading,
          mobile_aspect_ratio: mobile_aspect_ratio,
          mobile_display_type: mobile_display_type,
          mobile_full_width: mobile_full_width,
          mobile_image: mobile_image,
          overlay_style: overlay_style,
          parallax: parallax_enabled,
          sizes: sizes
        -%}
      {%- else -%}
        {%-
          render 'placeholder',
          type: 'lifestyle',
          aspect_ratio: aspect_ratio,
          display_type: display_type,
          full_width: full_width,
          mobile_aspect_ratio: mobile_aspect_ratio,
          mobile_display_type: mobile_display_type,
          mobile_full_width: mobile_full_width,
          overlay_style: overlay_style,
          parallax: parallax_enabled,
          placeholder_index: 2
        -%}
      {%- endif -%}
    </div>

    {%-
      render 'section-blocks',
      section_id: section.id,
      blocks: section.blocks,
      bg_color: text_bg_color,
      mobile_text_color: mobile_text_color,
      mobile_x_alignment: mobile_text_x_alignment,
      text_style: text_style,
      text_color: text_color,
      x_alignment: text_x_alignment
    -%}
  </div>
</div>

{% stylesheet %}
  .image-with-text--root {
    .section-blocks--root {
      z-index: 1;
    }

    @media (min-width: 768px) {
      &[data-overlap='true']
        .image-with-text--wrapper[data-reverse-layout='true']
        .section-blocks--wrapper {
        margin-right: var(--overlap-margin);
      }

      &[data-overlap='true']
        .image-with-text--wrapper[data-reverse-layout='false']
        .section-blocks--wrapper {
        margin-left: var(--overlap-margin);
      }

      &[data-container-width='6']
        .image-with-text--wrapper[data-reverse-layout='true']
        .section-blocks--wrapper {
        margin-left: var(--spacing--section--x);
      }

      &[data-container-width='6']
        .image-with-text--wrapper[data-reverse-layout='false']
        .section-blocks--wrapper {
        margin-right: var(--spacing--section--x);
      }
    }

    @media (max-width: 767px) {
      &[data-overlap='true'] .section-blocks--wrapper {
        margin-top: var(--overlap-margin);
      }
    }
  }

  .image-with-text--wrapper[data-container='split'] {
    --column-width: var(--text-column-width);
    --overlap-margin: calc(-3 * var(--spacing--block));

    align-items: center;

    @media (min-width: 768px) {
      --grid-columns: minmax(0, 1fr) minmax(0, var(--column-width));

      &[data-reverse-layout='true'] {
        --grid-columns: minmax(0, var(--column-width)) minmax(0, 1fr);
      }

      .image-with-text--root[data-overlap='true'] & {
        --column-width: calc(var(--text-column-width) + var(--overlap-margin));
      }

      .image-with-text--root[data-container-width='6'] & {
        --column-width: calc(var(--text-column-width) + var(--spacing--section--x));
      }

      .image-with-text--root[data-container-width='6'][data-overlap='true'] & {
        --column-width: calc(
          var(--text-column-width) + var(--overlap-margin) + var(--spacing--section--x)
        );
      }
    }
  }
{% endstylesheet %}

