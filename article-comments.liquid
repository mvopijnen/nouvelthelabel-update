<!-- sections/article-comments.liquid -->

{%- liquid
  assign comment_t = 'blog.article.comment' | t
  assign email_t = 'blog.comment.email' | t
  assign error_t = 'blog.comment.error' | t
  assign moderated_notice_t = 'blog.comment.moderated_notice' | t
  assign name_t = 'blog.comment.name' | t
  assign no_comments_t = 'blog.article.no_comments' | t

  assign button_style = section.settings.button-style
  assign button_text = section.settings.button-text
  assign canonical_url = shop.url | append: article.url
  assign disqus_enabled = section.settings.disqus-enabled
  assign disqus_shortname = section.settings.disqus-shortname | downcase
  assign heading = section.settings.heading
  assign heading_alignment = section.settings.heading-alignment
  assign heading_type = section.settings.heading-type
  assign mobile_heading_alignment = section.settings.mobile-heading-alignment
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
-%}

{%- if blog.comments_enabled? -%}
  <div
    class="article-comments--root"
    data-section-id="{{ section.id }}"
    data-background-color="none"
    data-container-width="2"
    data-mobile-spacing-above="{{ mobile_spacing_above }}"
    data-mobile-spacing-below="{{ mobile_spacing_below }}"
    data-spacing-above="{{ spacing_above }}"
    data-spacing-below="{{ spacing_below }}"
  >
    <div class="article-comments-wrapper" data-container="section">
      {%- unless heading == blank -%}
        <div
          class="article-comments--header"
          data-container="block"
          data-mobile-x-alignment="{{ mobile_heading_alignment }}"
          data-x-alignment="{{ heading_alignment }}"
          {% unless settings.transitions--text %}
            data-transition-item="viewport"
            data-transition-type="slide-in"
          {% endunless %}
        >
          <h2 class="article-comments--heading" data-item="{{ heading_type }}">
            {{- heading -}}
          </h2>
        </div>
      {%- endunless -%}

      {%- if disqus_enabled -%}
        <div id="disqus_thread" class="article-comments--disqus"></div>
        <script>
          function disqus_config() {
            this.page.identifier = '{{ article.id }}';
            this.page.title = '{{ shop.name }} - {{ article.title }}';
            this.page.url = '{{ canonical_url }}';
          }
        </script>
        <script src="https://{{ disqus_shortname }}.disqus.com/embed.js" defer="defer"></script>

      {%- else -%}
        {%- paginate article.comments by 8 -%}
          <div id="comments" class="article-comments--comments">
            {%- if article.comments.size > 0 -%}
              <div class="article-comments--list">
                {%- for comment in article.comments -%}
                  <div
                    id="{{ comment.id }}-comment"
                    class="article-comments--item"
                    data-container="block"
                  >
                    <div class="article-comments--meta">
                      <span data-item="nav-text">
                        {{- comment.author -}}
                      </span>

                      <span data-item="small-text" data-text-color="gray">
                        {%-
                          render 'utils',
                          name: 'timesince',
                          created_at: comment.created_at
                        -%}
                      </span>
                    </div>

                    <div class="article-comments--content" data-item="paragraph">
                      {{- comment.content -}}
                    </div>
                  </div>
                {%- endfor -%}
              </div>

            {%- else -%}
              <div class="article-comments--none" data-item="paragraph">
                {{- no_comments_t -}}
              </div>

            {%- endif -%}

            {%- liquid
              if paginate.pages > 1
                render 'pagination', paginate: paginate, hash: 'comments'
              endif
            -%}

            {%- form article, class: 'article-comments--form' -%}
              <div class="article-comments--inputs">
                <input
                  data-item="nav-text"
                  type="text"
                  id="comment_name"
                  name="comment[author]"
                  autocomplete="name"
                  size="40"
                  placeholder="{{ name_t }}"
                  required
                />
                <label for="comment_name" data-item="hidden-text">
                  {{- name_t -}}
                </label>

                <input
                  data-item="nav-text"
                  type="email"
                  id="comment_email"
                  name="comment[email]"
                  autocomplete="email"
                  size="40"
                  placeholder="{{ email_t }}"
                  required
                />
                <label for="comment_email" data-item="hidden-text">
                  {{- email_t -}}
                </label>
              </div>

              <textarea
                data-item="nav-text"
                id="comment_body"
                name="comment[body]"
                cols="40"
                rows="4"
                placeholder="{{ comment_t }}"
                required
              >{{ form.body }}</textarea>
              <label for="comment_body" data-item="hidden-text">
                {{- comment_t -}}
              </label>

              {%- if blog.moderated? -%}
                <div class="article-comments--form-moderated" data-item="nav-text">
                  {{- moderated_notice_t -}}
                </div>
              {%- endif -%}

              {%- if form.errors -%}
                <div
                  class="article-comments--form-error"
                  data-item="nav-text"
                  data-text-color="alert"
                >
                  {{- error_t -}}
                </div>
              {%- endif -%}

              {%- if form.posted_successfully? -%}
                <script>window.location.hash = '#feedback-bar--comment{% if blog.moderated? %}--moderated{% endif %}';</script>
              {%- endif -%}

              <button
                class="article-comments--button"
                type="submit"
                data-item="{{ button_style }}"
                data-text="{{ button_text }}"
                aria-busy="false"
                onclick="this.form.checkValidity() && this.setAttribute('aria-busy', true)"
              >
                <span class="article-comments--button-text">
                  {{- button_text -}}
                </span>
                <span class="article-comments--button-spinner">
                  {%- render 'icons', icon: 'spinner' -%}
                </span>
              </button>
            {%- endform -%}
          </div>
        {%- endpaginate -%}

      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .article-comments--comments {
    display: flex;
    flex-direction: column;
    gap: var(--spacing--block);
  }

  .article-comments--item {
    padding: var(--spacing--item) 0;
    border-bottom: 1px solid var(--border--color-dark);

    &:first-child {
      padding-top: 0;
    }

    &:last-child {
      padding-bottom: 0;
      border-bottom: none;
      margin-bottom: var(--spacing--neg-item);
    }
  }

  .article-comments--content {
    padding-left: var(--spacing--item);
  }

  .article-comments--meta {
    display: flex;
    justify-content: space-between;
  }

  .article-comments--form {
    &:before {
      content: '';
      display: block;
      margin-bottom: var(--spacing--block);
      width: 100%;
      height: 1px;
      background-color: var(--border--color-dark);
    }
  }

  .article-comments--inputs {
    display: flex;
    column-gap: var(--spacing--item);

    @media (max-width: 767px) {
      flex-direction: column;
    }
  }

  .article-comments--form-error,
  .article-comments--form-moderated {
    text-align: center;

    @media (min-width: 768px) {
      text-align: left;
    }
  }

  .article-comments--button {
    width: 100%;

    @media (min-width: 768px) {
      width: 50%;
    }

    &[aria-busy='true'] {
      .article-comments--button-text {
        opacity: 0;
      }
    }

    &[aria-busy='false'] {
      .article-comments--button-spinner {
        opacity: 0;
      }
    }
  }

  .article-comments--disqus {
    padding: 0 var(--spacing--item);

    @media (min-width: 768px) {
      padding: 0;
    }
  }
{% endstylesheet %}

