<!-- sections/featured-video.liquid -->

{%- liquid
  assign aspect_ratio = 100.0 | divided_by: section.settings.aspect-ratio | round: 4
  assign autoplay = section.settings.autoplay
  assign bg_color = section.settings.background-color
  assign border = section.settings.border
  assign container_width = section.settings.container-width
  assign display_type = section.settings.video-display-type
  assign mobile_aspect_ratio = 100.0 | divided_by: section.settings.mobile-aspect-ratio | round: 4
  assign mobile_display_type = section.settings.mobile-video-display-type
  assign mobile_full_width = section.settings.mobile-full-width
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign mobile_thumbnail = section.settings.mobile-thumbnail
  assign mobile_x_alignment = section.settings.mobile-text-horizontal-alignment
  assign mobile_y_alignment = section.settings.mobile-text-vertical-alignment
  assign overlay_style = section.settings.overlay-style
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign text_bg_color = section.settings.text-background-color
  assign text_style = section.settings.text-style
  assign thumbnail = section.settings.image
  assign text_width = section.settings.text-width
  assign video_upload = section.settings.video-upload
  assign video_url = section.settings.video-url
  assign text_color = section.settings.text-color
  assign x_alignment = section.settings.text-horizontal-alignment
  assign y_alignment = section.settings.text-vertical-alignment

  assign full_width = false
  if container_width == '6'
    assign full_width = true
  endif

  assign loading = 'lazy'
  if section.index < 3
    assign loading = 'eager'
  endif

  assign video_type = 'youtube'
  assign video_id = '_9VUPq3SxOc'
  if video_upload != blank
    assign video_type = 'plyr'
    assign video_id = false
  elsif video_url
    assign video_type = video_url.type
    assign video_id = video_url.id
  endif

  assign natural_aspect_ratio = 'calc(16 / 9)'
  if video_upload
    assign natural_aspect_ratio = video_upload.aspect_ratio
  endif

  capture css_vars
    echo '--video-aspect-ratio:' | append: aspect_ratio | append: ';'
    echo '--video-mobile-aspect-ratio:' | append: mobile_aspect_ratio | append: ';'
    echo '--natural-aspect-ratio:' | append: natural_aspect_ratio | append: ';'
  endcapture
-%}

<video-element
  class="video--root"
  data-section-id="{{ section.id }}"
  data-api="{{ video_type }}"
  data-autoplay="{{ autoplay }}"
  data-background-color="{{ bg_color }}"
  data-border="{{ border }}"
  data-container-width="{{ container_width }}"
  data-display-type="{{ display_type }}"
  data-full-width="{{ full_width }}"
  data-header-overlap-compatible
  data-id="{{ section.id }}"
  data-mobile-display-type="{{ mobile_display_type }}"
  data-mobile-full-width="{{ mobile_full_width }}"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
  data-overlay-style="{{ overlay_style }}"
  data-video-id="{{ video_id }}"
  style="{{ css_vars }}"
>
  <div class="video--wrapper">
    {%- unless autoplay and section.blocks.size == 0 -%}
      <div class="video--overlay">
        {%- unless autoplay -%}
          <div class="video--thumbnail">
            {%- if thumbnail == blank and video_upload == blank and video_url == blank -%}
              {%-
                render 'placeholder',
                display_type: 'fill-available',
                full_width: full_width,
                mobile_full_width: mobile_full_width,
                mobile_overlay_style: overlay_style,
                overlay_text_color: text_color,
                overlay_style: overlay_style,
                placeholder_index: 1,
                type: 'lifestyle'
              -%}

            {%- else -%}
              {%- liquid
                assign fetchpriority = 'auto'
                if section.index == 1
                  assign fetchpriority = 'high'
                endif

                assign loading = 'lazy'
                if section.index < 3
                  assign loading = 'eager'
                endif
              -%}

              {%-
                render 'image',
                image: thumbnail,
                overlay_style: overlay_style,
                display_type: 'fill-available',
                fetchpriority: fetchpriority,
                full_width: full_width,
                loading: loading,
                mobile_full_width: mobile_full_width,
                mobile_overlay_style: overlay_style,
                mobile_image: mobile_thumbnail,
                sizes: '100vw'
              -%}

            {%- endif -%}
          </div>
        {%- endunless -%}

        {%- unless section.blocks.size == 0 -%}
          {%-
            render 'section-blocks',
            section_id: section.id,
            blocks: section.blocks,
            bg_color: text_bg_color,
            mobile_x_alignment: mobile_x_alignment,
            mobile_y_alignment: mobile_y_alignment,
            text_style: text_style,
            text_width: text_width,
            text_color: text_color,
            x_alignment: x_alignment,
            y_alignment: y_alignment
          -%}
        {%- endunless -%}
      </div>
    {%- endunless -%}

    <div
      class="video--container"
      {% if autoplay %}
        tabindex="-1"
      {% else %}
        data-transition-item="viewport"
        data-transition-type="fade-in"
        data-transition-trigger="custom"
      {% endif %}
    >
      {%- if video_upload -%}
        {%- liquid
          assign video = video_upload | video_tag: autoplay: autoplay, muted: autoplay, loop: autoplay, loading: loading
          assign video = video | replace: '<img', '<img loading="' | append: loading | append: '"'
          echo video
        -%}
      {%- else -%}
        <div id="{{ section.id }}-player"></div>
      {%- endif -%}
    </div>
  </div>
</video-element>

