<!-- sections/materials-craftsmanship.liquid -->

{%- liquid
  assign aspect_ratio = 100.0 | divided_by: section.settings.aspect-ratio
  assign bg_color = section.settings.background-color
  assign border = section.settings.border
  assign button_text = section.settings.button-text
  assign button_link = section.settings.button-link
  assign button_style = section.settings.button-style
  assign container_width = section.settings.container-width
  assign description = section.settings.description
  assign display_type = section.settings.image-display-type
  assign heading = section.settings.heading | escape
  assign heading_type = section.settings.heading-type
  assign image = section.settings.image
  assign mobile_aspect_ratio = 100.0 | divided_by: section.settings.mobile-aspect-ratio
  assign mobile_display_type = section.settings.mobile-image-display-type
  assign mobile_full_width = section.settings.mobile-full-width
  assign mobile_image = section.settings.mobile-image
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign parallax_enabled = section.settings.parallax-enabled
  assign reverse_layout = section.settings.reverse-layout
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign text_color = section.settings.text-color
  assign text_column_width = section.settings.text-column-width

  assign full_width = false
  if container_width == '6'
    assign full_width = true
  endif

  assign fetchpriority = 'auto'
  if section.index == 1
    assign fetchpriority = 'high'
  endif

  assign loading = 'lazy'
  if section.index < 3
    assign loading = 'eager'
  endif

  capture sizes
    render 'sizes-cover', aspect_ratio: aspect_ratio, container_width: container_width, display_type: display_type, mobile_aspect_ratio: mobile_aspect_ratio, mobile_display_type: mobile_display_type, mobile_full_width: mobile_full_width, mobile_original_aspect_ratio: mobile_image.aspect_ratio, original_aspect_ratio: image.aspect_ratio
  endcapture
-%}

<div
  class="materials-craftsmanship--root"
  data-section-id="{{ section.id }}"
  data-background-color="{{ bg_color }}"
  data-border="{{ border }}"
  data-container-width="{{ container_width }}"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-mobile-full-width="{{ mobile_full_width }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
  style="--text-column-width:{{ text_column_width }}px;"
>
  <div
    class="materials-craftsmanship--wrapper"
    data-container="split"
    data-reverse-layout="{{ reverse_layout }}"
  >
    <div
      class="materials-craftsmanship--image"
      {% unless settings.transitions--image %}
        data-transition-item="viewport"
        data-transition-type="image"
      {% endunless %}
    >
      {%- if image -%}
        {%-
          render 'image',
          image: image,
          aspect_ratio: aspect_ratio,
          display_type: display_type,
          fetchpriority: fetchpriority,
          full_width: full_width,
          loading: loading,
          mobile_aspect_ratio: mobile_aspect_ratio,
          mobile_display_type: mobile_display_type,
          mobile_full_width: mobile_full_width,
          mobile_image: mobile_image,
          parallax: parallax_enabled,
          sizes: sizes
        -%}
      {%- else -%}
        {%-
          render 'placeholder',
          type: 'lifestyle',
          aspect_ratio: aspect_ratio,
          display_type: display_type,
          full_width: full_width,
          mobile_aspect_ratio: mobile_aspect_ratio,
          mobile_display_type: mobile_display_type,
          mobile_full_width: mobile_full_width,
          parallax: parallax_enabled,
          placeholder_index: 2
        -%}
      {%- endif -%}
    </div>

    <div
      class="materials-craftsmanship--content"
      {% unless settings.transitions--text %}
        data-transition-container="{{ section.id }}"
        data-transition-type="fade-in"
      {% endunless %}
    >
      {%- unless heading == blank -%}
        <h2
          class="materials-craftsmanship--heading"
          data-item="{{ heading_type }}"
          {% unless settings.transitions--text %}
            data-transition-item="{{ section.id }}"
          {% endunless %}
        >
          {{- heading -}}
        </h2>
      {%- endunless -%}

      {%- unless description == blank -%}
        <div
          class="materials-craftsmanship--description"
          data-item="rte-content"
          {% unless settings.transitions--text %}
            data-transition-item="{{ section.id }}"
          {% endunless %}
        >
          {{- description -}}
        </div>
      {%- endunless -%}

      <div class="materials-craftsmanship--blocks">
        {%- for block in section.blocks -%}
          {%- liquid
            assign block_heading = block.settings.heading
            assign block_description = block.settings.description
            assign block_default_open = block.settings.default-open
            assign block_page_content = block.settings.page-content
          -%}

          <div
            class="materials-craftsmanship--block"
            {% unless settings.transitions--text %}
              data-transition-item="{{ section.id }}"
            {% endunless %}
            {{ block.shopify_attributes }}
          >
            {%-
              render 'collapsible-row',
              heading: block_heading,
              description: block_description,
              default_open: block_default_open,
              page_content: block_page_content,
              id: block.id,
              text_color: text_color
            -%}
          </div>
        {%- endfor -%}
      </div>

      {%- unless button_text == blank -%}
        <a
          class="materials-craftsmanship--button"
          href="{{ button_link }}"
          data-item="{{ button_style }}"
          data-text="{{ button_text }}"
          {% unless reverse_layout %}
            data-x-alignment="right"
          {% endunless %}
          {% unless settings.transitions--text %}
            data-transition-item="{{ section.id }}"
          {% endunless %}
        >
          <span>{{ button_text }}</span>
        </a>
      {%- endunless -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .materials-craftsmanship--root {
    @media (min-width: 768px) {
      &[data-container-width='6']
        .materials-craftsmanship--wrapper[data-reverse-layout='true']
        .section-blocks--wrapper {
        margin-left: var(--spacing--section--x);
      }

      &[data-container-width='6']
        .materials-craftsmanship--wrapper[data-reverse-layout='false']
        .section-blocks--wrapper {
        margin-right: var(--spacing--section--x);
      }
    }
  }

  .materials-craftsmanship--wrapper[data-container='split'] {
    --column-width: var(--text-column-width);

    align-items: center;

    @media (min-width: 768px) {
      --grid-columns: minmax(0, 1fr) minmax(0, var(--column-width));

      &[data-reverse-layout='true'] {
        --grid-columns: minmax(0, var(--column-width)) minmax(0, 1fr);
      }

      .materials-craftsmanship--root[data-container-width='6'] & {
        --column-width: calc(var(--text-column-width) + var(--spacing--section--x));
      }
    }
  }

  .materials-craftsmanship--content {
    display: flex;
    flex-direction: column;
    align-self: flex-start;
    height: 100%;

    @media (min-width: 768px) {
      gap: var(--spacing--block);

      .materials-craftsmanship--root[data-container-width='6'] .materials-craftsmanship--wrapper[data-reverse-layout='false'] & {
        padding-right: var(--spacing--section--x);
      }

      .materials-craftsmanship--root[data-container-width='6'] .materials-craftsmanship--wrapper[data-reverse-layout='true'] & {
        padding-left: var(--spacing--section--x);
      }
    }

    @media (max-width: 767px) {
      gap: var(--spacing--item);

      .materials-craftsmanship--root[data-mobile-full-width='true'] &
        > *:not(.materials-craftsmanship--blocks) {
        padding-left: var(--spacing--item);
        padding-right: var(--spacing--item);
      }
    }
  }

  .materials-craftsmanship--button {
    margin-top: auto;
    padding-top: var(--spacing--item);
  }
{% endstylesheet %}

