<div id="Transparency-{{ section.id }}" class="transparency-wrapper">
  
  <!-- Spacer (Optioneel, wordt verborgen als er geen padding is ingesteld) -->
  <div class="main-spacer"></div>

  <!-- Hero Section -->
  <section class="section-padding bg-primary">
    <div class="container-custom">
      <div class="grid-2">
        <div class="slide-up align-content">
          <div class="divider" style="margin-bottom: 2rem;"></div>
          {% if section.settings.main_title != blank %}
            <h1 class="display-font h-title text-primary" style="margin: 0 0 1rem 0;">{{ section.settings.main_title }}</h1>
          {% endif %}
          {% if section.settings.main_subtitle != blank %}
            <h2 class="text-font h-subtitle text-secondary" style="margin: 0 0 3rem 0; font-weight: 300;">{{ section.settings.main_subtitle }}</h2>
          {% endif %}
          {% if section.settings.hero_story != blank %}
            <div class="text-font p-base text-paragraph hero-text-wrapper" style="line-height: 1.8; margin: 0;">
              {{ section.settings.hero_story }}
            </div>
          {% endif %}
        </div>
        
        <div class="slide-up delay-1 stats-grid">
          <div class="feature-box">
            <div class="stars">
              {% for i in (1..5) %}
                <svg class="star" viewBox="0 0 24 24">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                </svg>
              {% endfor %}
            </div>
            <p class="text-font text-secondary" style="font-size: 11px; margin: 0; letter-spacing: 0px;">
              Geverifieerd door <strong class="text-primary">Judge.me</strong>
            </p>
          </div>
          <div class="feature-box text-center-override">
            <div class="display-font text-primary" style="font-size: 40px; margin: 0 0 0.5rem 0;">{{ section.settings.hero_stat_number }}</div>
            <p class="text-font text-secondary" style="font-size: 11px; margin: 0; letter-spacing: 0px;">{{ section.settings.hero_stat_text }}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="divider-full border-color"></div>

  <!-- Story Section -->
  <section class="section-padding bg-secondary">
    <div class="container-custom">
      <div class="grid-2">
        <div class="slide-up delay-2 align-content">
          <h3 class="display-font h-section text-primary" style="margin: 0 0 2rem 0;">{{ section.settings.story_title }}</h3>
          <div class="text-font p-base text-paragraph" style="line-height: 1.9; margin: 0;">
            {{ section.settings.story_text }}
          </div>
        </div>
        <div class="slide-up delay-3" style="display: flex; flex-direction: column; gap: 1.5rem;">
          <!-- Features 1, 2, 3 -->
          <div class="feature-box">
            <p class="text-font text-secondary" style="font-size: 10px; text-transform: uppercase; margin: 0 0 0.75rem 0;">{{ section.settings.story_f1_title }}</p>
            <p class="text-font text-paragraph" style="font-size: 11px; margin: 0; line-height: 1.6;">{{ section.settings.story_f1_text }}</p>
          </div>
          <div class="feature-box">
            <p class="text-font text-secondary" style="font-size: 10px; text-transform: uppercase; margin: 0 0 0.75rem 0;">{{ section.settings.story_f2_title }}</p>
            <p class="text-font text-paragraph" style="font-size: 11px; margin: 0; line-height: 1.6;">{{ section.settings.story_f2_text }}</p>
          </div>
          <div class="feature-box">
            <p class="text-font text-secondary" style="font-size: 10px; text-transform: uppercase; margin: 0 0 0.75rem 0;">{{ section.settings.story_f3_title }}</p>
            <p class="text-font text-paragraph" style="font-size: 11px; margin: 0; line-height: 1.6;">{{ section.settings.story_f3_text }}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="divider-full border-color"></div>

  <!-- Stats Section -->
  <section class="section-padding bg-primary">
    <div class="container-custom">
      <div class="stats-container">
        <div class="slide-up">
          <div class="display-font text-primary" style="font-size: 44px; margin: 0 0 0.5rem 0;">{{ section.settings.stat1_num }}</div>
          <p class="text-font text-secondary" style="font-size: 11px; margin: 0;">{{ section.settings.stat1_text }}</p>
        </div>
        <div class="slide-up delay-1">
          <div class="display-font text-primary" style="font-size: 44px; margin: 0 0 0.5rem 0;">{{ section.settings.stat2_num }}</div>
          <p class="text-font text-secondary" style="font-size: 11px; margin: 0;">{{ section.settings.stat2_text }}</p>
        </div>
        <div class="slide-up delay-2">
          <div class="display-font text-primary" style="font-size: 44px; margin: 0 0 0.5rem 0;">{{ section.settings.stat3_num }}</div>
          <p class="text-font text-secondary" style="font-size: 11px; margin: 0;">{{ section.settings.stat3_text }}</p>
        </div>
        <div class="slide-up delay-3">
          <div class="display-font text-primary" style="font-size: 44px; margin: 0 0 0.5rem 0;">{{ section.settings.stat4_num }}</div>
          <p class="text-font text-secondary" style="font-size: 11px; margin: 0;">{{ section.settings.stat4_text }}</p>
        </div>
      </div>
    </div>
  </section>

  <div class="divider-full border-color"></div>

  <!-- Process Section -->
  <section class="section-padding bg-primary">
    <div class="container-custom">
      <div class="grid-2">
        <div class="slide-up delay-1 align-content">
          <h3 class="display-font h-section text-primary" style="margin: 0 0 2rem 0;">{{ section.settings.process_title }}</h3>
          <div class="text-font p-base text-paragraph" style="line-height: 1.9; margin: 0;">
            {{ section.settings.process_text }}
          </div>
        </div>
        <div class="slide-up delay-2" style="display: flex; flex-direction: column; gap: 1.5rem;">
          <!-- Process steps -->
          <div class="feature-box">
            <p class="text-font text-secondary" style="font-size: 10px; text-transform: uppercase; margin: 0 0 0.75rem 0;">{{ section.settings.process_s1_title }}</p>
            <p class="text-font text-paragraph" style="font-size: 11px; margin: 0; line-height: 1.6;">{{ section.settings.process_s1_text }}</p>
          </div>
          <div class="feature-box">
            <p class="text-font text-secondary" style="font-size: 10px; text-transform: uppercase; margin: 0 0 0.75rem 0;">{{ section.settings.process_s2_title }}</p>
            <p class="text-font text-paragraph" style="font-size: 11px; margin: 0; line-height: 1.6;">{{ section.settings.process_s2_text }}</p>
          </div>
          <div class="feature-box">
            <p class="text-font text-secondary" style="font-size: 10px; text-transform: uppercase; margin: 0 0 0.75rem 0;">{{ section.settings.process_s3_title }}</p>
            <p class="text-font text-paragraph" style="font-size: 11px; margin: 0; line-height: 1.6;">{{ section.settings.process_s3_text }}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="divider-full border-color"></div>

  <!-- Features/Reviews Section -->
  <section class="section-padding bg-secondary">
    <div class="container-custom">
      <div style="text-align: center; margin-bottom: 4rem;">
        <h3 class="display-font h-section text-primary" style="margin: 0 0 1rem 0;">{{ section.settings.reviews_title }}</h3>
        <div class="divider" style="margin: 0 auto;"></div>
      </div>
      <div class="grid-2-features">
        <div class="feature-box fade-in delay-1">
          <h4 class="text-font text-secondary" style="font-size: 11px; font-weight: 500; margin: 0 0 0.75rem 0; letter-spacing: 1px;">{{ section.settings.review_f1_title }}</h4>
          <p class="text-font text-paragraph" style="font-size: 11px; margin: 0; line-height: 1.6;">{{ section.settings.review_f1_text }}</p>
        </div>
        <div class="feature-box fade-in delay-2">
          <h4 class="text-font text-secondary" style="font-size: 11px; font-weight: 500; margin: 0 0 0.75rem 0; letter-spacing: 1px;">{{ section.settings.review_f2_title }}</h4>
          <p class="text-font text-paragraph" style="font-size: 11px; margin: 0; line-height: 1.6;">{{ section.settings.review_f2_text }}</p>
        </div>
        <div class="feature-box fade-in delay-3">
          <h4 class="text-font text-secondary" style="font-size: 11px; font-weight: 500; margin: 0 0 0.75rem 0; letter-spacing: 1px;">{{ section.settings.review_f3_title }}</h4>
          <p class="text-font text-paragraph" style="font-size: 11px; margin: 0; line-height: 1.6;">{{ section.settings.review_f3_text }}</p>
        </div>
        <div class="feature-box fade-in delay-1">
          <h4 class="text-font text-secondary" style="font-size: 11px; font-weight: 500; margin: 0 0 0.75rem 0; letter-spacing: 1px;">{{ section.settings.review_f4_title }}</h4>
          <p class="text-font text-paragraph" style="font-size: 11px; margin: 0; line-height: 1.6;">{{ section.settings.review_f4_text }}</p>
        </div>
      </div>
    </div>
  </section>

  <div class="divider-full border-color"></div>

  <!-- Closing Section -->
  <section class="section-padding bg-primary">
    <div class="container-custom" style="text-align: center;">
      <div class="text-font p-large text-paragraph" style="margin: 0 auto; line-height: 1.9; max-width: 600px;">
        {{ section.settings.closing_text }}
      </div>
    </div>
  </section>

  <!-- Optional Footer -->
  {% if section.settings.footer_text != blank %}
    <section class="bg-secondary border-top" style="padding: 60px 0;">
      <div class="container-custom" style="text-align: center;">
        <p class="text-font text-secondary" style="font-size: 11px; margin: 0;">{{ section.settings.footer_text }}</p>
      </div>
    </section>
  {% endif %}

</div>

<style>
  /* ------------------- GLOBALS & LAYOUT ------------------- */
  #Transparency-{{ section.id }} {
    margin-top: {{ section.settings.spacing_above }};
    margin-bottom: {{ section.settings.spacing_below }};
    {% if section.settings.border == 'top' %}
      border-top: 1px solid {{ section.settings.border_color }};
    {% elsif section.settings.border == 'bottom' %}
      border-bottom: 1px solid {{ section.settings.border_color }};
    {% elsif section.settings.border == 'all' %}
      border: 1px solid {{ section.settings.border_color }};
    {% endif %}
  }

  #Transparency-{{ section.id }} .bg-primary { background-color: {{ section.settings.bg_primary }}; }
  #Transparency-{{ section.id }} .bg-secondary { background-color: {{ section.settings.bg_secondary }}; }
  #Transparency-{{ section.id }} .text-primary { color: {{ section.settings.title_color }}; }
  #Transparency-{{ section.id }} .text-secondary { color: {{ section.settings.subtitle_color }}; }
  #Transparency-{{ section.id }} .text-paragraph { color: {{ section.settings.text_color }}; }
  #Transparency-{{ section.id }} .border-color { background-color: {{ section.settings.border_color }}; border-color: {{ section.settings.border_color }}; }
  #Transparency-{{ section.id }} .border-top { border-top: 1px solid {{ section.settings.border_color }}; }

  #Transparency-{{ section.id }} .container-custom {
    max-width: {{ section.settings.container_width }};
    margin: 0 auto;
    padding: 0 2rem;
  }

  .align-content { text-align: {{ section.settings.text_alignment }}; }
  
  /* Optionele top-spacer */
  #Transparency-{{ section.id }} .main-spacer {
    height: 60px;
    background-color: {{ section.settings.bg_primary }};
    display: {% if section.settings.spacing_above != '0px' %}block{% else %}none{% endif %};
  }

  /* ------------------- TYPOGRAPHY ------------------- */
  #Transparency-{{ section.id }} .display-font {
    font-weight: 400;
    letter-spacing: 1px;
    /* Mobiel fix: altijd nette regelafstand en woord-afbreking */
    line-height: 1.2;
    overflow-wrap: break-word; 
  }

  #Transparency-{{ section.id }} .text-font {
    font-weight: 300;
  }

  #Transparency-{{ section.id }} .text-paragraph p { margin: 0 0 1rem 0; }
  #Transparency-{{ section.id }} .text-paragraph p:last-child { margin: 0; }
  
  /* Bold text styling */
  #Transparency-{{ section.id }} .text-paragraph strong,
  #Transparency-{{ section.id }} .text-paragraph b {
    font-weight: 400;
    color: {{ section.settings.title_color }};
  }

  /* Hero paragraph specifiek */
  #Transparency-{{ section.id }} .hero-text-wrapper {
    max-width: 420px;
    {% if section.settings.text_alignment == 'center' %}
      margin-left: auto !important;
      margin-right: auto !important;
    {% elsif section.settings.text_alignment == 'right' %}
      margin-left: auto !important;
    {% endif %}
  }

  /* ------------------- COMPONENTS ------------------- */
  #Transparency-{{ section.id }} .divider {
    width: 60px;
    height: 1px;
    background: {{ section.settings.title_color }};
    margin: 0;
    {% if section.settings.text_alignment == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% elsif section.settings.text_alignment == 'right' %}
      margin-left: auto;
    {% endif %}
  }

  #Transparency-{{ section.id }} .divider-full {
    width: 100%;
    height: 1px;
  }

  #Transparency-{{ section.id }} .feature-box {
    padding: 2rem;
    border: 1px solid {{ section.settings.border_color }};
    background: {{ section.settings.bg_secondary }};
    transition: all 0.3s ease;
  }

  #Transparency-{{ section.id }} .feature-box:hover {
    border-color: {{ section.settings.title_color }};
    background: {{ section.settings.bg_primary }};
  }

  #Transparency-{{ section.id }} .stars {
    display: flex;
    gap: 4px;
    margin-bottom: 1rem;
    {% if section.settings.text_alignment == 'center' %}
      justify-content: center;
    {% endif %}
  }

  #Transparency-{{ section.id }} .star {
    width: 16px;
    height: 16px;
    fill: {{ section.settings.title_color }};
  }

  #Transparency-{{ section.id }} .text-center-override { text-align: center; }

  /* ------------------- GRIDS & ANIMATIONS ------------------- */
  #Transparency-{{ section.id }} .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  #Transparency-{{ section.id }} .grid-2-features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  #Transparency-{{ section.id }} .stats-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  #Transparency-{{ section.id }} .stats-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3rem;
    text-align: center;
  }

  @keyframes TransparencyFadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes TransparencySlideUp {
    from { opacity: 0; transform: translateY(40px); }
    to { opacity: 1; transform: translateY(0); }
  }

  #Transparency-{{ section.id }} .fade-in { animation: TransparencyFadeIn 1s ease-out forwards; }
  #Transparency-{{ section.id }} .slide-up { animation: TransparencySlideUp 0.8s ease-out forwards; }

  #Transparency-{{ section.id }} .delay-1 { animation-delay: 0.1s; opacity: 0; }
  #Transparency-{{ section.id }} .delay-2 { animation-delay: 0.3s; opacity: 0; }
  #Transparency-{{ section.id }} .delay-3 { animation-delay: 0.5s; opacity: 0; }

  /* ------------------- RESPONSIVE ------------------- */
  @media (min-width: 1024px) {
    #Transparency-{{ section.id }} .container-custom { padding: 0 4rem; }
    #Transparency-{{ section.id }} .section-padding { padding: 100px 0; }
    #Transparency-{{ section.id }} .h-title { font-size: 27px; line-height: 1.2; }
    #Transparency-{{ section.id }} .h-subtitle { font-size: 24px; line-height: 1.3; }
    #Transparency-{{ section.id }} .h-section { font-size: 13px; line-height: 1.2; }
    #Transparency-{{ section.id }} .p-large,
    #Transparency-{{ section.id }} .p-base { font-size: 11px; line-height: 1.8; }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    #Transparency-{{ section.id }} .container-custom { padding: 0 2.5rem; }
    #Transparency-{{ section.id }} .section-padding { padding: 60px 0; }
    #Transparency-{{ section.id }} .grid-2 { grid-template-columns: 1fr; gap: 3rem; }
    #Transparency-{{ section.id }} .stats-container { grid-template-columns: repeat(2, 1fr); gap: 2rem; }
    #Transparency-{{ section.id }} .h-title { font-size: 27px; line-height: 1.2; }
    #Transparency-{{ section.id }} .h-subtitle { font-size: 24px; line-height: 1.3; }
    #Transparency-{{ section.id }} .h-section { font-size: 13px; line-height: 1.3; }
    #Transparency-{{ section.id }} .p-large,
    #Transparency-{{ section.id }} .p-base { font-size: 11px; }
  }

  @media (max-width: 767px) {
    #Transparency-{{ section.id }} .container-custom { 
      {% if section.settings.mobile_full_width %}
        padding: 0 0;
      {% else %}
        padding: 0 1.25rem; 
      {% endif %}
    }
    
    #Transparency-{{ section.id }} {
      margin-top: {{ section.settings.mobile_spacing_above }};
      margin-bottom: {{ section.settings.mobile_spacing_below }};
    }
    
    .align-content { text-align: {{ section.settings.mobile_text_alignment }} !important; }
    #Transparency-{{ section.id }} .divider {
      {% if section.settings.mobile_text_alignment == 'center' %}
        margin-left: auto; margin-right: auto;
      {% elsif section.settings.mobile_text_alignment == 'right' %}
        margin-left: auto; margin-right: 0;
      {% else %}
        margin-left: 0; margin-right: auto;
      {% endif %}
    }

    #Transparency-{{ section.id }} .section-padding { padding: 50px 0; }
    #Transparency-{{ section.id }} .grid-2 { grid-template-columns: 1fr; gap: 2rem; }
    #Transparency-{{ section.id }} .grid-2-features { grid-template-columns: 1fr; gap: 1rem; }
    #Transparency-{{ section.id }} .stats-container { grid-template-columns: 1fr; gap: 1.5rem; }
    
    #Transparency-{{ section.id }} .h-title { font-size: 24px; line-height: 1.3; }
    #Transparency-{{ section.id }} .h-subtitle { font-size: 20px; margin-bottom: 1.5rem; line-height: 1.4; }
    #Transparency-{{ section.id }} .h-section { font-size: 13px; line-height: 1.3; }
    #Transparency-{{ section.id }} .p-large,
    #Transparency-{{ section.id }} .p-base { font-size: 11px; line-height: 1.7; }
    
    #Transparency-{{ section.id }} .feature-box { padding: 1.25rem; }
    #Transparency-{{ section.id }} .divider { width: 40px; }
    #Transparency-{{ section.id }} .stats-grid { gap: 1.5rem; }
    
    /* Zorg dat de hero tekst mooi lijnt op mobiel */
    #Transparency-{{ section.id }} .hero-text-wrapper {
      margin-left: {% if section.settings.mobile_text_alignment == 'center' or section.settings.mobile_text_alignment == 'right' %}auto{% else %}0{% endif %} !important;
      margin-right: {% if section.settings.mobile_text_alignment == 'center' %}auto{% else %}0{% endif %} !important;
    }
  }
</style>

{% schema %}
{
  "name": "Transparantie Pagina",
  "settings": [
    {
      "type": "header",
      "content": "Layout (Desktop)"
    },
    {
      "type": "select",
      "id": "border",
      "label": "Randen (Gehele sectie)",
      "options": [
        { "value": "none", "label": "Geen" },
        { "value": "top", "label": "Alleen boven" },
        { "value": "bottom", "label": "Alleen onder" },
        { "value": "all", "label": "Rondom" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "spacing_above",
      "label": "Marge boven",
      "options": [
        { "value": "0px", "label": "Geen" },
        { "value": "40px", "label": "Klein" },
        { "value": "80px", "label": "Normaal" },
        { "value": "120px", "label": "Groot" }
      ],
      "default": "0px"
    },
    {
      "type": "select",
      "id": "spacing_below",
      "label": "Marge onder",
      "options": [
        { "value": "0px", "label": "Geen" },
        { "value": "40px", "label": "Klein" },
        { "value": "80px", "label": "Normaal" },
        { "value": "120px", "label": "Groot" }
      ],
      "default": "0px"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Maximale breedte content",
      "options": [
        { "value": "1000px", "label": "Medium" },
        { "value": "1400px", "label": "Large (Aanbevolen)" },
        { "value": "100%", "label": "Volledige breedte" }
      ],
      "default": "1400px"
    },
    {
      "type": "text_alignment",
      "id": "text_alignment",
      "label": "Algemene Tekst uitlijning",
      "default": "left"
    },
    {
      "type": "header",
      "content": "Layout (Mobiel)"
    },
    {
      "type": "checkbox",
      "id": "mobile_full_width",
      "label": "Volledige breedte (geen padding zijkant)",
      "default": false
    },
    {
      "type": "select",
      "id": "mobile_spacing_above",
      "label": "Marge boven (Mobiel)",
      "options": [
        { "value": "0px", "label": "Geen" },
        { "value": "30px", "label": "Klein" },
        { "value": "50px", "label": "Normaal" }
      ],
      "default": "0px"
    },
    {
      "type": "select",
      "id": "mobile_spacing_below",
      "label": "Marge onder (Mobiel)",
      "options": [
        { "value": "0px", "label": "Geen" },
        { "value": "30px", "label": "Klein" },
        { "value": "50px", "label": "Normaal" }
      ],
      "default": "0px"
    },
    {
      "type": "text_alignment",
      "id": "mobile_text_alignment",
      "label": "Tekst uitlijning (Mobiel)",
      "default": "left"
    },
    {
      "type": "header",
      "content": "Kleuren"
    },
    {
      "type": "color",
      "id": "bg_primary",
      "label": "Achtergrondkleur 1 (Wit)",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bg_secondary",
      "label": "Achtergrondkleur 2 (Lichtgrijs)",
      "default": "#fafafa"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Lijnen & Randen",
      "default": "#e5e5e5"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Hoofd Titels & Zwart",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitels & Grijs",
      "default": "#888888"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Normale Tekst",
      "default": "#555555"
    },
    {
      "type": "header",
      "content": "1. Hero Sectie"
    },
    {
      "type": "text",
      "id": "main_title",
      "label": "Titel",
      "default": "KLANT BEOORDELINGEN"
    },
    {
      "type": "text",
      "id": "main_subtitle",
      "label": "Subtitel",
      "default": "Echte reviews van echte klanten"
    },
    {
      "type": "richtext",
      "id": "hero_story",
      "label": "Introductie tekst",
