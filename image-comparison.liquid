<!-- sections/image-comparison.liquid -->

{%- liquid
  assign cursor_t = 'sections.image_comparison.cursor' | t

  assign aspect_ratio = 100.0 | divided_by: section.settings.aspect-ratio
  assign bg_color = section.settings.background-color
  assign border = section.settings.border
  assign button_link = section.settings.button-link
  assign button_style = section.settings.button-style
  assign button_text = section.settings.button-text
  assign cursor_direction = section.settings.cursor-direction
  assign cursor_position = section.settings.cursor-position
  assign container_width = section.settings.container-width
  assign display_type = section.settings.image-display-type
  assign heading = section.settings.heading | escape
  assign heading_type = section.settings.heading-type
  assign mobile_aspect_ratio = 100.0 | divided_by: section.settings.mobile-aspect-ratio
  assign mobile_display_type = section.settings.mobile-image-display-type
  assign mobile_full_width = section.settings.mobile-full-width
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign overline = section.settings.overline | escape
  assign section_alignment = section.settings.section-alignment
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign text_color = section.settings.text-color

  assign full_width = false
  if container_width == '6'
    assign full_width = true
  endif

  assign loading = 'lazy'
  if section.index < 3
    assign loading = 'eager'
  endif

  assign before_block = section.blocks | find: 'type', 'before'
  if before_block
    assign before_image = before_block.settings.image
    assign before_mobile_image = before_block.settings.mobile-image
    assign before_overlay = before_block.settings.overlay-style
    assign before_overline = before_block.settings.overline
    assign before_heading = before_block.settings.title
    assign before_heading_type = before_block.settings.heading-type
    assign before_text_color = before_block.settings.text-color
    assign before_text_pos = before_block.settings.text-position
  endif

  assign after_block = section.blocks | find: 'type', 'after'
  if after_block
    assign after_image = after_block.settings.image
    assign after_mobile_image = after_block.settings.mobile-image
    assign after_overlay = after_block.settings.overlay-style
    assign after_overline = after_block.settings.overline
    assign after_heading = after_block.settings.title
    assign after_heading_type = after_block.settings.heading-type
    assign after_text_color = after_block.settings.text-color
    assign after_text_pos = after_block.settings.text-position
  endif
-%}

<image-comparison-element
  class="image-comparison--root"
  data-section-id="{{ section.id }}"
  data-background-color="{{ bg_color }}"
  data-border="{{ border }}"
  data-container-width="{{ container_width }}"
  data-cursor-direction="{{ cursor_direction }}"
  data-initial-pos="{{ cursor_position }}"
  data-mobile-full-width="{{ mobile_full_width }}"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
>
  <div class="image-comparison--wrapper" data-container="section">
    {%- unless overline == blank and heading == blank -%}
      <div
        class="image-comparison--header"
        data-container="block"
        data-text-color="{{ text_color }}"
        data-x-alignment="{{ section_alignment }}"
        {% unless settings.transitions--text %}
          data-transition-container="{{ section.id }}"
          data-transition-type="slide-in"
          data-transition-cascade="vertical"
          data-transition-cascade-interval="500"
        {% endunless %}
      >
        {%- unless overline == blank -%}
          <div
            class="image-comparison--overline"
            {% unless settings.transitions--text %}
              data-transition-item="{{ section.id }}"
            {% endunless %}
          >
            <p data-item="overline">
              {{- overline -}}
            </p>
          </div>
        {%- endunless -%}

        {%- unless heading == blank -%}
          <div
            class="image-comparison--heading"
            {% unless settings.transitions--text %}
              data-transition-item="{{ section.id }}"
            {% endunless %}
          >
            <h3 data-item="{{ heading_type }}">
              {{- heading -}}
            </h3>
          </div>
        {%- endunless -%}
      </div>
    {%- endunless -%}

    <div class="image-comparison--images">
      <div class="image-comparison--before" {{ before_block.shopify_attributes }}>
        {%- liquid
          if before_image
            capture sizes
              render 'sizes-cover', container_width: container_width, display_type: display_type, mobile_display_type: mobile_display_type, aspect_ratio: aspect_ratio, mobile_aspect_ratio: mobile_aspect_ratio, original_aspect_ratio: before_image.aspect_ratio
            endcapture

            render 'image', aspect_ratio: aspect_ratio, display_type: display_type, full_width: full_width, image: before_image, mobile_aspect_ratio: mobile_aspect_ratio, mobile_display_type: mobile_display_type, mobile_full_width: mobile_full_width, mobile_image: before_mobile_image, mobile_overlay_style: before_overlay, overlay_style: before_overlay, sizes: sizes, loading: loading
          else
            render 'placeholder', aspect_ratio: aspect_ratio, display_type: display_type, full_width: full_width, mobile_aspect_ratio: mobile_aspect_ratio, mobile_display_type: mobile_display_type, mobile_full_width: mobile_full_width, mobile_overlay_style: before_overlay, overlay_style: before_overlay, placeholder_index: 1, type: 'lifestyle', overlay_text_color: before_text_color
          endif
        -%}

        {%- unless before_overline == blank and before_heading == blank -%}
          <div
            class="image-comparison--before-text"
            data-text-color="{{ before_text_color }}"
            data-transition-item="viewport"
            data-transition-type="fade-in"
            data-transition-active="true"
            data-transition-trigger="custom"
            style="--text-position:{{ before_text_pos }};"
          >
            {%- unless before_overline == blank -%}
              <div class="image-comparison--before-overline" data-item="overline">
                {{- before_overline -}}
              </div>
            {%- endunless -%}

            {%- unless before_heading == blank -%}
              <div class="image-comparison--before-heading" data-item="{{ before_heading_type }}">
                {{- before_heading -}}
              </div>
            {%- endunless -%}
          </div>
        {%- endunless -%}
      </div>

      <div class="image-comparison--after" {{ after_block.shopify_attributes }}>
        {%- liquid
          if after_image
            capture sizes
              render 'sizes-cover', container_width: container_width, display_type: display_type, mobile_display_type: mobile_display_type, aspect_ratio: aspect_ratio, mobile_aspect_ratio: mobile_aspect_ratio, original_aspect_ratio: after_image.aspect_ratio
            endcapture

            render 'image', aspect_ratio: aspect_ratio, display_type: display_type, full_width: full_width, image: after_image, mobile_aspect_ratio: mobile_aspect_ratio, mobile_display_type: mobile_display_type, mobile_full_width: mobile_full_width, mobile_image: after_mobile_image, mobile_overlay_style: after_overlay, overlay_style: after_overlay, sizes: sizes, loading: loading
          else
            render 'placeholder', aspect_ratio: aspect_ratio, display_type: display_type, full_width: full_width, mobile_aspect_ratio: mobile_aspect_ratio, mobile_display_type: mobile_display_type, mobile_full_width: mobile_full_width, mobile_overlay_style: after_overlay, overlay_style: after_overlay, placeholder_index: 1, type: 'lifestyle', overlay_text_color: after_text_color
          endif
        -%}

        {%- unless after_overline == blank and after_heading == blank -%}
          <div
            class="image-comparison--after-text"
            data-text-color="{{ after_text_color }}"
            data-transition-item="viewport"
            data-transition-type="fade-in"
            data-transition-active="true"
            data-transition-trigger="custom"
            style="--text-position:{{ after_text_pos }};"
          >
            {%- unless after_overline == blank -%}
              <div class="image-comparison--after-overline" data-item="overline">
                {{- after_overline -}}
              </div>
            {%- endunless -%}

            {%- unless after_heading == blank -%}
              <div class="image-comparison--after-heading" data-item="{{ after_heading_type }}">
                {{- after_heading -}}
              </div>
            {%- endunless -%}
          </div>
        {% endunless %}
      </div>

      <div class="image-comparison--cursor-wrapper">
        <button
          type="button"
          class="image-comparison--cursor"
          aria-label="{{ cursor_t }}"
        >
          {%- render 'icons', icon: 'drag-indicator' -%}
        </button>
      </div>
    </div>

    {%- unless button_text == blank -%}
      <div
        class="image-comparison--footer"
        data-container="block"
        data-text-color="{{ text_color }}"
        data-x-alignment="{{ section_alignment }}"
      >
        <a
          class="image-comparison--button"
          href="{{ button_link }}"
          data-item="{{ button_style }}"
          data-text="{{ button_text }}"
        >
          <span>{{ button_text }}</span>
        </a>
      </div>
    {%- endunless -%}
  </div>
</image-comparison-element>

{% stylesheet %}
  .image-comparison--root {
    --image-comparison--cursor-width: var(--spacing--6);
    --image-comparison--cursor-height: var(--spacing--6);
    --image-comparison--cursor-pos: 10%;
    --image-comparison--transition: all 1.5s var(--transition--ease-out) 0.25s;

    user-select: none;

    .icon--drag-indicator {
      color: black;
    }
  }

  .image-comparison--images {
    display: grid;
    position: relative;

    > * {
      grid-area: 1 / -1;
    }
  }

  .image-comparison--before-text {
    position: absolute;
    top: 0;
    left: 0;
    padding: var(--spacing--block);
    display: flex;
    flex-direction: column;
    row-gap: var(--spacing--1);

    .image-comparison--root[data-cursor-direction='vertical'] & {
      align-items: var(--text-position);
      right: 0;
    }

    .image-comparison--root[data-cursor-direction='horizontal'] & {
      justify-content: var(--text-position);
      bottom: 0;
    }

    @media (max-width: 768px) {
      padding: var(--spacing--item);
    }
  }

  .image-comparison--after-text {
    position: absolute;
    right: 0;
    bottom: 0;
    padding: var(--spacing--block);
    display: flex;
    flex-direction: column;
    row-gap: var(--spacing--1);

    .image-comparison--root[data-cursor-direction='vertical'] & {
      align-items: var(--text-position);
      left: 0;
    }

    .image-comparison--root[data-cursor-direction='horizontal'] & {
      justify-content: var(--text-position);
      top: 0;
      text-align: right;
    }

    @media (max-width: 768px) {
      padding: var(--spacing--item);
    }
  }

  .image-comparison--after {
    z-index: 1;
    transition: var(--image-comparison--transition);

    .image-comparison--root[data-cursor-direction='horizontal'] & {
      clip-path: inset(0 0 0 var(--image-comparison--cursor-pos, 0%));
    }

    .image-comparison--root[data-cursor-direction='vertical'] & {
      clip-path: inset(var(--image-comparison--cursor-pos, 0%) 0 0 0);
    }
  }

  .image-comparison--cursor-wrapper {
    display: grid;
    position: relative;
    transition: var(--image-comparison--transition);

    .image-comparison--root[data-cursor-direction='horizontal'] & {
      justify-self: start;
      place-items: center start;
      inset-inline-start: calc(
        var(--image-comparison--cursor-pos, 0%) - var(--image-comparison--cursor-width) / 2
      );

      &:before {
        height: 100%;
        width: 2px;
        left: calc(50% - 1px);
      }
    }

    .image-comparison--root[data-cursor-direction='vertical'] & {
      align-self: start;
      place-items: start center;
      inset-block-start: calc(
        var(--image-comparison--cursor-pos, 0%) - var(--image-comparison--cursor-height) / 2
      );

      &:before {
        height: 2px;
        width: 100%;
        top: calc(50% - 1px);
      }
    }

    &:before {
      content: '';
      position: absolute;
      background-color: white;
    }
  }

  .image-comparison--cursor {
    padding: 0;
    z-index: 1;
    border: var(--border--dark);
    background-color: white;
    width: var(--image-comparison--cursor-width);
    height: var(--image-comparison--cursor-height);
    border-radius: 50%;

    &:active {
      scale: 0.96;
      cursor: grabbing;

      body:has(&) {
        cursor: grabbing;
      }
    }

    .icon--drag-indicator {
      height: var(--spacing--5);

      .image-comparison--root[data-cursor-direction='horizontal'] & {
        transform: rotate(90deg);
      }
    }
  }

  .image-comparison--button {
    text-align: center;
  }
{% endstylesheet %}

