{% comment %}
  Nouvel Editorial Product Section
  Inspired by Nouvel Brand Language Codex v1.0
  Layout: Editorial / Magazine Spread
{% endcomment %}

{% unless section.settings.use_theme_fonts %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
{% endunless %}

<style>
  .nouvel-product-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --title-color: {{ section.settings.title_color }};
    --desc-color: {{ section.settings.desc_color }};
    --active-color: {{ section.settings.active_color }};
    
    --indent-left: {{ section.settings.indent_left }}px;
    --indent-right: {{ section.settings.indent_right }}px;
    --text-align: {{ section.settings.text_align }};
    
    --title-size: {{ section.settings.title_size }}px;
    --body-size: {{ section.settings.body_size }}px;
    --meta-size: {{ section.settings.meta_size }}px;
    --price-size: {{ section.settings.price_size }}px;
    --button-size: {{ section.settings.button_size }}px;
    --badge-title-size: {{ section.settings.badge_title_size }}px;
    --badge-value-size: {{ section.settings.badge_value_size }}px;
    
    --aspect-ratio: {{ section.settings.aspect_ratio }};
    
    background-color: var(--bg-color);
    padding: {{ section.settings.padding_vertical }}px 20px;
    overflow: hidden;
    
    {% unless section.settings.use_theme_fonts %}
      font-family: Arial, sans-serif;
    {% endunless %}
  }

  .nouvel-container {
    max-width: 1800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  @media (min-width: 768px) {
    .nouvel-container {
      flex-direction: {% if section.settings.layout == 'image_left' %}row{% else %}row-reverse{% endif %};
      align-items: center;
      gap: 80px;
      padding-left: var(--indent-left);
      padding-right: var(--indent-right);
    }
  }

  .nouvel-image-wrapper {
    flex: 1;
    position: relative;
  }

  .nouvel-image-container {
    aspect-ratio: var(--aspect-ratio);
    overflow: hidden;
    background-color: #e5e5e5;
  }

  .nouvel-image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s ease;
    display: block;
  }

  .nouvel-image-wrapper:hover img {
    transform: scale(1.05);
  }

  .nouvel-material-badge {
    position: absolute;
    bottom: -10px;
    {% if section.settings.layout == 'image_left' %}left: 0;{% else %}right: 0;{% endif %}
    background-color: #000000;
    color: #ffffff;
    padding: 15px 20px;
    z-index: 2;
    min-width: 140px;
  }

  @media (min-width: 768px) {
    .nouvel-material-badge {
      bottom: 20px;
      padding: 25px 35px;
      min-width: 200px;
    }
  }

  .nouvel-badge-label {
    font-size: calc(var(--badge-title-size) * 0.8);
    text-transform: uppercase;
    letter-spacing: 0.3em;
    margin-bottom: 4px;
    opacity: 0.8;
    font-weight: 700;
  }

  @media (min-width: 768px) {
    .nouvel-badge-label {
      font-size: var(--badge-title-size);
      margin-bottom: 8px;
    }
  }

  .nouvel-badge-value {
    font-size: calc(var(--badge-value-size) * 0.8);
    font-weight: 300;
    line-height: 1.2;
  }

  @media (min-width: 768px) {
    .nouvel-badge-value {
      font-size: var(--badge-value-size);
    }
  }

  .nouvel-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
    text-align: left;
  }

  @media (min-width: 768px) {
    .nouvel-content {
      text-align: var(--text-align);
      align-items: {% if section.settings.text_align == 'left' %}flex-start{% else %}flex-end{% endif %};
      gap: 32px;
    }
  }

  .nouvel-meta {
    font-size: var(--meta-size);
    text-transform: uppercase;
    letter-spacing: 0.4em;
    color: var(--desc-color);
    opacity: 0.7;
  }

  .nouvel-title {
    font-size: calc(var(--title-size) * 0.8);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0;
    color: var(--title-color);
    {% unless section.settings.use_theme_fonts %}
      font-family: "Playfair Display", serif;
    {% endunless %}
  }

  @media (min-width: 768px) {
    .nouvel-title {
      font-size: var(--title-size);
    }
  }

  .nouvel-description {
    font-size: calc(var(--body-size) * 0.9);
    line-height: 1.6;
    font-weight: 300;
    color: var(--desc-color);
    max-width: 500px;
  }

  @media (min-width: 768px) {
    .nouvel-description {
      font-size: var(--body-size);
    }
  }

  .nouvel-footer {
    padding-top: 32px;
    border-top: 1px solid var(--active-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-top: 20px;
  }

  .nouvel-price {
    font-size: var(--price-size);
    font-weight: 300;
    color: var(--title-color);
  }

  .nouvel-cta {
    display: flex;
    align-items: center;
    gap: 16px;
    text-decoration: none;
    color: var(--title-color);
    text-transform: uppercase;
    font-size: var(--button-size);
    letter-spacing: 0.4em;
    transition: opacity 0.3s ease;
  }

  .nouvel-cta:hover {
    opacity: 0.7;
  }

  .nouvel-plus-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--active-color);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .nouvel-cta:hover .nouvel-plus-icon {
    background-color: var(--active-color);
    color: var(--bg-color);
  }
</style>

<section class="nouvel-product-{{ section.id }}">
  <div class="nouvel-container">
    <div class="nouvel-image-wrapper">
      <div class="nouvel-image-container">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | img_url: '1200x' }}" alt="{{ section.settings.title }}" loading="lazy">
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
      {% if section.settings.material != blank %}
        <div class="nouvel-material-badge">
          <div class="nouvel-badge-label">Materiaal</div>
          <div class="nouvel-badge-value">{{ section.settings.material }}</div>
        </div>
      {% endif %}
    </div>

    <div class="nouvel-content">
      <div class="nouvel-meta">
        {{ section.settings.index_label }} / Product
      </div>
      
      <h2 class="nouvel-title">
        {{ section.settings.title }}
      </h2>

      <div class="nouvel-description">
        {{ section.settings.description }}
      </div>

      <div class="nouvel-footer">
        <div class="nouvel-price">{{ section.settings.price }}</div>
        <a href="{{ section.settings.button_link }}" class="nouvel-cta">
          <span>{{ section.settings.button_label }}</span>
          <div class="nouvel-plus-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Nouvel Editorial Product",
  "settings": [
    {
      "type": "header",
      "content": "Inhoud"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product Afbeelding"
    },
    {
      "type": "text",
      "id": "index_label",
      "label": "Index (bijv. 01)",
      "default": "01"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titel",
      "default": "Double Breasted Blazer"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Beschrijving",
      "default": "Een sculpturale snit, vervaardigd uit zware crêpe. Gebouwd voor levensduur en dagelijkse autoriteit."
    },
    {
      "type": "text",
      "id": "material",
      "label": "Materiaal Label",
      "default": "High-Performance Crêpe"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Prijs",
      "default": "€420"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Knop Tekst",
      "default": "Toevoegen"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Knop Link"
    },
    {
      "type": "header",
      "content": "Typografie"
    },
    {
      "type": "checkbox",
      "id": "use_theme_fonts",
      "label": "Gebruik Thema Lettertypes",
      "info": "Vink dit aan om de lettertypes van je eigen Shopify thema te gebruiken in plaats van de Luxe Fonts.",
      "default": false
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Titel grootte",
      "default": 64
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Body lettergrootte",
      "default": 18
    },
    {
      "type": "range",
      "id": "meta_size",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Meta lettergrootte",
      "default": 10
    },
    {
      "type": "range",
      "id": "price_size",
      "min": 14,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Prijs lettergrootte",
      "default": 24
    },
    {
      "type": "range",
      "id": "button_size",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Knop lettergrootte",
      "default": 10
    },
    {
      "type": "range",
      "id": "badge_title_size",
      "min": 8,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Materiaal Label grootte",
      "default": 10
    },
    {
      "type": "range",
      "id": "badge_value_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Materiaal Waarde grootte",
      "default": 14
    },
    {
      "type": "header",
      "content": "Uitlijning & Positie"
    },
    {
      "type": "range",
      "id": "indent_left",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Inspringing Links (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "indent_right",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Inspringing Rechts (Desktop)",
      "default": 0
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Tekst Uitlijning",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "right", "label": "Rechts" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Positie afbeelding (Desktop)",
      "options": [
        { "value": "image_left", "label": "Links" },
        { "value": "image_right", "label": "Rechts" }
      ],
      "default": "image_left"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Beeldverhouding",
      "options": [
        { "value": "4/5", "label": "4:5 (Portret)" },
        { "value": "1/1", "label": "1:1 (Vierkant)" }
      ],
      "default": "4/5"
    },
    {
      "type": "header",
      "content": "Kleuren"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Achtergrondkleur",
      "default": "#FAFAF9"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Titel kleur",
      "default": "#1C1917"
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Beschrijving kleur",
      "default": "#57534E"
    },
    {
      "type": "color",
      "id": "active_color",
      "label": "Actieve rand kleur",
      "default": "#1C1917"
    },
    {
      "type": "header",
      "content": "Overige Instellingen"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 20,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Verticale Spatiëring",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Nouvel Editorial Product"
    }
  ]
}
{% endschema %}