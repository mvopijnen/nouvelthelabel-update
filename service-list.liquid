<!-- sections/service-list.liquid -->

{%- liquid
  assign bg_color = section.settings.background-color
  assign border = section.settings.border
  assign button_link = section.settings.button-link
  assign button_style = section.settings.button-style
  assign button_text = section.settings.button-text
  assign container_width = section.settings.container-width
  assign heading = section.settings.heading
  assign heading_type = section.settings.heading-type
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign show_description = section.settings.show-description
  assign section_alignment = section.settings.section-alignment
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign text_color = section.settings.text-color
-%}

<service-list-element
  class="service-list--root"
  data-section-id="{{ section.id }}"
  data-section-type="service_list"
  data-background-color="{{ bg_color }}"
  data-border="{{ border }}"
  data-container-width="{{ container_width }}"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-show-description="{{ show_description }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
  data-text-color="{{ text_color }}"
>
  <div class="service-list--wrapper" data-container="section">
    {%- unless heading == blank -%}
      <div
        class="service-list--header"
        data-container="block"
        data-x-alignment="{{ section_alignment }}"
        {% unless settings.transitions--text %}
          data-transition-item="viewport"
          data-transition-type="slide-in"
        {% endunless %}
      >
        <h2 class="service-list--title" data-item="{{ heading_type }}">
          {{- heading | escape -}}
        </h2>
      </div>
    {%- endunless -%}

    <div class="service-list--container">
      {%- if section.blocks.size > 0 -%}
        <div class="service-list--single-column">
          <ul class="service-list--blocks">
            {%- for block in section.blocks -%}
              {%- if block.type == "header" -%}
                {%- unless forloop.first -%}
                  </ul><ul class="service-list--blocks">
                {%- endunless -%}

                <li class="service-list--block-header" {{ block.shopify_attributes }}>
                  <h3 class="service-list--block-header--text" data-item="block-heading">
                    {{- block.settings.title | escape -}}
                  </h3>
                </li>

              {%- else -%}
                <li class="service-list--block" {{ block.shopify_attributes }}>
                  <div class="service-list--info">
                    {%- if block.settings.title.size > 0 -%}
                      <div class="service-list--block-title">
                        <p class="service-list--block-title-text" data-item="paragraph">
                          {{- block.settings.title | escape -}}
                        </p>
                      </div>
                    {%- endif -%}
                    {%- if block.settings.price.size > 0 -%}
                      <div class="service-list--price" data-item="nav-text">
                        {{- block.settings.price | escape -}}
                      </div>
                    {%- endif -%}
                  </div>

                  {%- if show_description -%}
                    {%- if block.settings.description != blank -%}
                      <div class="service-list--description" data-item="rte-content">
                        {{- block.settings.description -}}
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
        <div class="service-list--left-column"></div>
        <div class="service-list--right-column"></div>
      {%- endif -%}
    </div>

    {%- unless button_text == blank -%}
      <div
        class="service-list--footer"
        data-container="block"
        data-x-alignment="{{ section_alignment }}"
      >
        <a
          class="service-list--button"
          href="{{ button_link }}"
          data-item="{{ button_style }}"
          data-text="{{ button_text }}"
        >
          <span>{{ button_text }}</span>
        </a>
      </div>
    {%- endunless -%}
  </div>
</service-list-element>

{% stylesheet %}
  .service-list--container {
    display: flex;
    justify-content: center;
    gap: var(--spacing--block);

    &:has(> .service-list--block-header--text) {
      flex-wrap: wrap;
    }

    > .service-list--block-header--text {
      /* only appears via JS when there is one header block */
      width: 100%;
      text-align: left;
    }

    @media (max-width: 767px) {
      flex-direction: column;
    }
  }

  .service-list--block-header--text {
    @media (min-width: 768px) {
      text-align: center;
    }

    @media (max-width: 767px) {
      text-align: left;
    }
  }

  .service-list--single-column,
  .service-list--left-column,
  .service-list--right-column {
    display: none;
    height: fit-content;

    &:has(.service-list--blocks:empty) {
      display: none;
    }

    &:has(> *) {
      display: flex;
      flex-direction: column;
      gap: var(--spacing--block);
    }

    @media (min-width: 768px) {
      width: calc(50% - (var(--spacing--block) / 2));
    }

    @media (max-width: 767px) {
      width: 100%;
    }
  }

  .service-list--blocks {
    display: flex;
    flex-direction: column;

    .service-list--root[data-show-description='false'] & {
      gap: var(--spacing--item);
    }

    .service-list--root[data-show-description='true'] & {
      gap: var(--spacing--block);
    }
  }

  .service-list--block-header {
    text-align: center;
  }

  .service-list--price {
    padding-left: var(--spacing--6);
    padding-bottom: 2px;

    .service-list--root[data-show-description='false'] & {
      flex-grow: 0;
      flex-shrink: 1;
      padding-left: var(--spacing--2);
      padding-bottom: 0;
    }
  }

  .service-list--description {
    padding-top: var(--spacing--1);
  }

  .service-list--block-title {
    flex-grow: 1;

    .service-list--root[data-show-description='false'] & {
      flex-grow: 0;
      flex-shrink: 1;
      width: 100%;
      position: relative;
      overflow: hidden;

      &:after {
        content: '⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅⋅';
        font-family: Arial, sans-serif;
        margin-left: var(--spacing--2);
        line-height: 2;
        position: absolute;
      }
    }
  }

  .service-list--info {
    display: flex;
    align-items: center;
    border-bottom: var(--border--dark);
    padding-bottom: var(--spacing--1);
    width: 100%;

    .service-list--root[data-show-description='false'] & {
      border-bottom: none;
      padding: 0;
    }

    .service-list--root[data-text-color='white'] & {
      border-bottom: var(--border--light);
    }
  }

  .service-list--block-title-text {
    .service-list--root[data-show-description='false'] & {
      display: inline;
    }
  }
{% endstylesheet %}

