<!-- sections/appointments.liquid -->

{%- liquid
  assign aspect_ratio = 100.0 | divided_by: section.settings.aspect-ratio
  assign bg_color = section.settings.background-color
  assign border = section.settings.border
  assign container_width = section.settings.container-width
  assign display_type = section.settings.image-display-type
  assign image = section.settings.image
  assign mobile_aspect_ratio = 100.0 | divided_by: section.settings.mobile-aspect-ratio
  assign mobile_display_type = section.settings.mobile-image-display-type
  assign mobile_full_width = section.settings.mobile-full-width
  assign mobile_image = section.settings.mobile-image
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign overlay_style = section.settings.overlay-style
  assign parallax_enabled = section.settings.parallax-enabled
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign text_style = section.settings.text-style
  assign text_color = section.settings.text-color

  assign full_width = false
  if container_width == '6'
    assign full_width = true
  endif

  assign fetchpriority = 'auto'
  if section.index == 1
    assign fetchpriority = 'high'
  endif

  assign loading = 'lazy'
  if section.index < 3
    assign loading = 'eager'
  endif

  capture sizes
    render 'sizes-cover', aspect_ratio: aspect_ratio, container_width: container_width, display_type: display_type, mobile_aspect_ratio: mobile_aspect_ratio, mobile_display_type: mobile_display_type, mobile_full_width: mobile_full_width, mobile_original_aspect_ratio: mobile_image.aspect_ratio, original_aspect_ratio: image.aspect_ratio
  endcapture
-%}

<div
  class="appointments--root"
  data-section-id="{{ section.id }}"
  data-background-color="{{ bg_color }}"
  data-border="{{ border }}"
  data-container-width="{{ container_width }}"
  data-header-overlap-compatible
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-mobile-full-width="{{ mobile_full_width }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
>
  <div class="appointments--wrapper" data-container="section">
    <div
      class="appointments--image-container"
      {% unless settings.transitions--image %}
        data-transition-item="viewport"
        data-transition-type="image"
      {% endunless %}
    >
      {%- liquid
        if image
          render 'image', image: image, mobile_image: mobile_image, display_type: display_type, aspect_ratio: aspect_ratio, mobile_display_type: mobile_display_type, mobile_aspect_ratio: mobile_aspect_ratio, mobile_full_width: mobile_full_width, full_width: full_width, overlay_style: overlay_style, parallax: parallax_enabled, loading: loading, sizes: sizes, fetchpriority: fetchpriority
        else
          render 'placeholder', type: 'lifestyle', placeholder_index: 2, display_type: display_type, aspect_ratio: aspect_ratio, mobile_display_type: mobile_display_type, mobile_aspect_ratio: mobile_aspect_ratio, mobile_full_width: mobile_full_width, full_width: full_width, overlay_style: overlay_style, parallax: parallax_enabled, overlay_text_color: text_color
        endif
      -%}
    </div>

    <div
      class="appointments--blocks"
      {% unless settings.transitions--other %}
        data-transition-container="{{ section.id }}"
        data-transition-type="slide-in"
        data-transition-cascade="vertical"
        data-transition-cascade-interval="500"
      {% endunless %}
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign alignment = block.settings.alignment
          assign mobile_alignment = block.settings.mobile-alignment
        -%}

        <div
          class="appointments--block"
          data-text-color="{{ text_color }}"
          data-text-style="{{ text_style }}"
          data-x-alignment="{{ alignment }}"
          data-mobile-x-alignment="{{ mobile_alignment }}"
          {% unless settings.transitions--text %}
            data-transition-item="{{ section.id }}"
          {% endunless %}
          {{ block.shopify_attributes }}
        >
          {%- case block.type -%}
            {%- when 'heading' -%}
              <h2
                class="appointments--heading"
                data-item="{{ block.settings.heading-type }}"
              >
                {{- block.settings.title -}}
              </h2>

            {%- when 'description' -%}
              <div
                class="appointments--description"
                data-item="featured-paragraph"
              >
                {{- block.settings.description -}}
              </div>

            {%- when 'button' -%}
              <a
                class="appointments--button"
                href="{{ block.settings.link }}"
                data-item="{{ block.settings.style }}"
                data-text="{{ block.settings.text }}"
              >
                <span>{{- block.settings.text -}}</span>
              </a>

          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .appointments--image-container {
    align-self: stretch;
    grid-area: 1 / -1;
  }

  .appointments--blocks {
    grid-area: 1 / -1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;

    @media (min-width: 768px) {
      padding: var(--spacing--section--x);
    }

    @media (max-width: 767px) {
      padding: var(--spacing--item);
    }
  }

  .appointments--block {
    align-self: var(--x-alignment);
    z-index: 1;
  }

  .appointments--description {
    text-align: left;

    @media (min-width: 768px) {
      max-width: 500px;
    }

    @media (max-width: 767px) {
      max-width: 300px;
    }
  }
{% endstylesheet %}

