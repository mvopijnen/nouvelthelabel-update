<!-- sections/collection-with-highlight.liquid -->

{%- liquid
  assign aspect_ratio = 100.0 | divided_by: section.settings.aspect-ratio
  assign bg_color = section.settings.background-color
  assign border = section.settings.border
  assign collection = section.settings.collection
  assign container_width = section.settings.container-width
  assign image = section.settings.image
  assign image_enabled = section.settings.image-enabled
  assign image_display_type = section.settings.image-display-type
  assign max_products = section.settings.max-products
  assign mobile_aspect_ratio = 100.0 | divided_by: section.settings.mobile-aspect-ratio
  assign mobile_display_type = section.settings.mobile-image-display-type
  assign mobile_image = section.settings.mobile-image
  assign mobile_media_layout = section.settings.mobile-media-layout
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign mobile_text_x_alignment = section.settings.mobile-text-horizontal-alignment
  assign mobile_text_y_alignment = section.settings.mobile-text-vertical-alignment
  assign overlay_style = section.settings.overlay-style
  assign product_list = section.settings.product-list
  assign columns_str = section.settings.columns
  assign columns = columns_str | plus: 0.0
  assign mobile_columns_str = section.settings.mobile-columns
  assign mobile_columns = mobile_columns_str | plus: 0.0
  assign product_text_color = section.settings.product-text-color
  assign reverse_layout = section.settings.reverse-layout
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign text_style = section.settings.text-style
  assign text_width = section.settings.text-width
  assign text_x_alignment = section.settings.text-horizontal-alignment
  assign text_y_alignment = section.settings.text-vertical-alignment
  assign vertical_alignment = section.settings.vertical-alignment
  assign text_color = section.settings.text-color

  assign loading = 'lazy'
  if section.index < 3
    assign loading = 'eager'
  endif

  assign products = blank
  if product_list != blank
    assign products = product_list
  elsif collection != blank
    assign products = collections[collection].products
  endif

  capture product_sizes
    assign product_columns_desktop = columns | times: 2
    render 'sizes-grid', columns: product_columns_desktop, mobile_columns: mobile_columns
  endcapture

  capture product_blocks
    if products == blank
      for i in (1..max_products)
        capture placeholder_index
          cycle '1', '2', '3', '4', '5', '6'
        endcapture

        render 'product-card', onboarding: true, placeholder_index: placeholder_index, transition_id: section.id
        unless forloop.last
          echo '<span class="divider"></span>'
        endunless
      endfor
    else
      for product in products limit: max_products
        render 'product-card', product_item: product, transition_id: section.id, sizes: product_sizes, loading: loading
        unless forloop.last
          echo '<span class="divider"></span>'
        endunless
      endfor
    endif
  endcapture

  assign product_blocks_arr = product_blocks | split: '<span class="divider"></span>'
  assign total_slides = product_blocks_arr.size | divided_by: mobile_columns
-%}

<div
  class="collection-with-highlight--root"
  data-section-id="{{ section.id }}"
  data-background-color="{{ bg_color }}"
  data-border="{{ border }}"
  data-container-width="{{ container_width }}"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
>
  <div class="collection-with-highlight--wrapper" data-container="section">
    <div
      class="collection-with-highlight--grid"
      data-container="split"
      data-reverse-layout="{{ reverse_layout }}"
    >
      <div
        class="collection-with-highlight--sticky"
        data-container="sticky-block"
        data-vertical-alignment="{{ vertical_alignment }}"
      >
        {%- if image_enabled -%}
          <div
            class="collection-with-highlight--image"
            {% unless settings.transitions--image %}
              data-transition-item="viewport"
              data-transition-type="image"
            {% endunless %}
          >
            {%- if image -%}
              {%- liquid
                capture sizes
                  render 'sizes-grid', columns: 2, mobile_columns: 1
                endcapture
              -%}
              {%-
                render 'image',
                image: image,
                aspect_ratio: aspect_ratio,
                display_type: image_display_type,
                mobile_image: mobile_image,
                mobile_display_type: mobile_display_type,
                mobile_aspect_ratio: mobile_aspect_ratio,
                loading: loading,
                overlay_style: overlay_style,
                sizes: sizes
              -%}
            {%- else -%}
              {%-
                render 'placeholder',
                type: 'lifestyle',
                placeholder_index: 1,
                aspect_ratio: aspect_ratio,
                overlay_text_color: text_color,
                display_type: image_display_type,
                mobile_display_type: mobile_display_type,
                mobile_aspect_ratio: mobile_aspect_ratio,
                overlay_style: overlay_style
              -%}
            {%- endif -%}
          </div>
        {%- endif -%}

        {%-
          render 'section-blocks',
          section_id: section.id,
          blocks: section.blocks,
          mobile_x_alignment: mobile_text_x_alignment,
          mobile_y_alignment: mobile_text_y_alignment,
          text_color: text_color,
          text_style: text_style,
          text_width: text_width,
          x_alignment: text_x_alignment,
          y_alignment: text_y_alignment
        -%}
      </div>

      {%- if mobile_media_layout == 'grid' -%}
        <div
          class="collection-with-highlight--products"
          data-container="panel"
          data-columns="{{ columns_str }}"
          data-mobile-columns="{{ mobile_columns_str }}"
          data-text-color="{{ product_text_color }}"
        >
          {%- liquid
            for product_block in product_blocks_arr
              echo product_block
            endfor
          -%}
        </div>
      {%- else -%}
        <div
          class="collection-with-highlight--products"
          data-text-color="{{ product_text_color }}"
        >
          {%-
            render 'card-carousel',
            section: section,
            blocks: product_blocks_arr,
            blocks_per_slide: columns_str,
            blocks_per_slide_mobile: mobile_columns_str,
            spacing_around_blocks: true,
            mobile_only: true,
            total_blocks: product_blocks_arr.size,
            total_slides: total_slides
          -%}
        </div>
      {%- endif -%}
    </div>

    {%- if mobile_media_layout == 'slideshow' -%}
      {%- assign total_slides_mobile = product_blocks_arr.size | divided_by: mobile_columns | ceil -%}

      <div class="collection-with-highlight--navigation" data-container="block" data-mq="small">
        {%- render 'carousel-nav-arrow', id: section.id, total_slides_mobile: total_slides_mobile -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .collection-with-highlight--root {
    .section-blocks--root:only-child .section-blocks--wrapper {
      @media (min-width: 768px) {
        padding-top: 0;
        padding-bottom: 0;
      }

      @media (max-width: 767px) {
        --text-padding-x: 0px;
        --text-padding-y: 0px;
      }
    }
  }

  .collection-with-highlight--navigation .carousel-nav-arrow {
    @media (max-width: 767px) {
      justify-content: center;
    }
  }
{% endstylesheet %}

