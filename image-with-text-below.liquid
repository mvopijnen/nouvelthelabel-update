<!-- sections/image-with-text-below.liquid -->

{%- liquid
  assign aspect_ratio = 100.0 | divided_by: section.settings.aspect-ratio | round: 4
  assign bg_color = section.settings.background-color
  assign border = section.settings.border
  assign container_width = section.settings.container-width
  assign display_type = section.settings.image-display-type
  assign image = section.settings.image
  assign mobile_aspect_ratio = 100.0 | divided_by: section.settings.mobile-aspect-ratio | round: 4
  assign mobile_display_type = section.settings.mobile-image-display-type
  assign mobile_full_width = section.settings.mobile-full-width
  assign mobile_image = section.settings.mobile-image
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign mobile_text_x_alignment = section.settings.mobile-text-horizontal-alignment
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign text_color = section.settings.text-color
  assign text_x_alignment = section.settings.text-horizontal-alignment
  assign text_width = section.settings.text-width

  assign full_width = false
  if container_width == '6'
    assign full_width = true
  endif

  assign fetchpriority = 'auto'
  if section.index == 1
    assign fetchpriority = 'high'
  endif

  assign loading = 'lazy'
  if section.index < 3
    assign loading = 'eager'
  endif
-%}

<div
  class="image-with-text-below--root"
  data-section-id="{{ section.id }}"
  data-background-color="{{ bg_color }}"
  data-border="{{ border }}"
  data-container-width="{{ container_width }}"
  data-header-overlap-compatible
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-mobile-full-width="{{ mobile_full_width }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
>
  <div class="image-with-text-below--wrapper" data-container="section">
    <div class="image-with-text-below--image-container">
      {%- liquid
        if image
          capture sizes
            render 'sizes-cover', container_width: container_width, display_type: display_type, mobile_display_type: mobile_display_type, aspect_ratio: aspect_ratio, mobile_aspect_ratio: mobile_aspect_ratio, original_aspect_ratio: image.aspect_ratio
          endcapture

          render 'image', image: image, mobile_image: mobile_image, display_type: display_type, aspect_ratio: aspect_ratio, mobile_display_type: mobile_display_type, mobile_aspect_ratio: mobile_aspect_ratio, mobile_full_width: mobile_full_width, full_width: full_width, loading: loading, sizes: sizes, fetchpriority: fetchpriority
        else
          render 'placeholder', type: 'lifestyle', placeholder_index: 2, display_type: display_type, aspect_ratio: aspect_ratio, mobile_display_type: mobile_display_type, mobile_aspect_ratio: mobile_aspect_ratio, mobile_full_width: mobile_full_width, full_width: full_width, overlay_text_color: text_color
        endif
      -%}
    </div>

    {%-
      render 'section-blocks',
      section_id: section.id,
      blocks: section.blocks,
      mobile_x_alignment: mobile_text_x_alignment,
      text_color: text_color,
      text_width: text_width,
      x_alignment: text_x_alignment
    -%}
  </div>
</div>

{% stylesheet %}
  .section-blocks--wrapper {
    @media (min-width: 768px) {
      .image-with-text-below--root[data-container-width='6'] .section-blocks--root:not([data-x-alignment='left']) &,
      .layout--main-content:has(.layout--sidebar:empty) .image-with-text-below--root[data-container-width='6'] & {
        --text-padding-y: 0px;
        --text-padding-x: var(--spacing--section--x);
      }

      .image-with-text-below--root[data-container-width='6'] .section-blocks--root[data-x-alignment='left'] & {
        --text-padding-top: 0px;
        --text-padding-right: var(--spacing--section--x);
        --text-padding-bottom: 0px;
        --text-padding-left: 0px;
      }
    }

    @media (max-width: 767px) {
      .image-with-text-below--root[data-mobile-full-width='true'] & {
        --text-padding-y: 0px;
        --text-padding-x: var(--spacing--item);
      }
    }
  }
{% endstylesheet %}

