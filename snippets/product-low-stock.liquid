<!-- snippets/product-low-stock.liquid -->

{%- doc -%}
  Renders the low stock indicator with optional progress bar.
  @param {object} block_settings - Block settings controlling threshold and display.
  @param {variant} current_variant - Variant providing inventory data.
  @param {string} id - Unique element id.
{%- enddoc -%}

{%- liquid
  assign threshold = block_settings.threshold
  assign width = current_variant.inventory_quantity | times: 100.0 | divided_by: threshold
-%}

<product-low-stock-element
  class="product-low-stock--root"
  data-id="{{ id }}"
  data-initial-availability="{{ current_variant.available }}"
  data-initial-quantity="{{ current_variant.inventory_quantity | default: 0 }}"
  style="--progress-percent:{{ width }}%;"
  {% if threshold > 0 %}
    data-threshold="{{ threshold }}"
  {% endif %}
>
  <p class="product-low-stock--message" data-item="caption"></p>

  {%- if block_settings.progress-bar-enabled -%}
    <div class="product-low-stock--bar"></div>
  {%- endif -%}

  <script type="application/json" id="{{ id }}-low_stock_translations">
    {
      "low_in_stock": {
        "one": "{{ "products.low_in_stock" | t: count: 1 }}",
        "other": "{{ "products.low_in_stock" | t: count: 2 }}"
      }
    }
  </script>
</product-low-stock-element>

{% stylesheet %}
  .product-low-stock--root {
    display: block;
  }

  .product-low-stock--bar {
    margin-top: var(--spacing--1);
    height: var(--spacing--0);
    border-radius: var(--spacing--0);
    position: relative;
    overflow: hidden;

    &:before {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--color--gray);
      opacity: 0.4;
    }

    &:after {
      content: '';
      display: block;
      height: 100%;
      background: var(--progress-bar);
      border-radius: 5px;
      width: var(--progress-percent);
      transition: width 0.4s var(--transition--standard);
    }
  }
{% endstylesheet %}