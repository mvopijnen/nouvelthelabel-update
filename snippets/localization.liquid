<!-- snippets/localization.liquid -->

{%- doc -%}
  Renders the language and region selectors.
  @param {string} [direction] - Direction of the form. Defaults to `horizontal`.
  @param {boolean} [hover_disabled] - Whether hover animation is disabled. Defaults to `false`.
  @param {string} id - Base id used for form controls.
  @param {boolean} [locale_enabled] - Show locale selector.
  @param {boolean} [region_enabled] - Show region selector.
{%- enddoc -%}

{%- liquid
  assign locale_label_t = 'general.localization.language' | t
  assign region_label_t = 'general.localization.region' | t

  assign direction = direction | default: 'horizontal'
  assign hover_disabled = hover_disabled | default: false
  assign form_id = id | append: '_localization'
  assign locale_id = id | append: '_locale'
  assign region_id = id | append: '_region'

  form 'localization', id: form_id, class: 'localization--form', data-direction: direction, data-hover-disabled: hover_disabled
    if locale_enabled
      for locale in localization.available_languages
        capture locale_values
          echo locale_values
          echo locale.iso_code | append: ','
        endcapture

        capture locale_names
          echo locale_names
          echo locale.endonym_name | append: ','
        endcapture
      endfor

      assign locale_values = locale_values | split: ','
      assign locale_names = locale_names | split: ','

      render 'disclosure', label_name: localization.language.endonym_name, option_names: locale_names, option_values: locale_values, current_value: localization.language.iso_code, id: locale_id, input_name: 'locale_code', type: 'localization'
    endif

    if region_enabled
      for country in localization.available_countries
        capture region_values
          echo region_values
          echo country.iso_code | append: ','
        endcapture

        capture region_names
          echo region_names
          echo '<span class="disclosure-option--wrapper">' | append: country.name
          echo '</span><p>'
          echo country.currency.iso_code | append: ' ' | append: country.currency.symbol | append: '</p>,'
        endcapture
      endfor

      assign region_values = region_values | split: ','
      assign region_names = region_names | split: ','

      render 'disclosure', label_name: region_label_t, option_names: region_names, option_values: region_values, current_value: localization.country.iso_code, id: region_id, input_name: 'country_code', type: 'localization'
    endif
  endform
-%}

{%- stylesheet -%}
  .localization--form {
    display: inline-flex;
    column-gap: var(--spacing--item);
    flex-wrap: wrap;

    @media (min-width: 768px) {
      row-gap: var(--spacing--0);
    }

    @media (max-width: 767px) {
      row-gap: var(--spacing--1);
    }

    &[data-direction='vertical'] {
      flex-direction: column;

      .disclosure--toggle[aria-expanded='true'] {
        font-weight: 700;
      }

      @media (hover: hover) {
        &[data-hover-disabled='false'] .disclosure--toggle:hover {
          font-weight: 700;
        }
      }
    }

    &[data-direction='horizontal'] {
      flex-direction: row;

      .disclosure--toggle[aria-expanded='true'] > .disclosure--current-option:before {
        position: absolute;
        top: calc(50% + var(--font--size));
        border-bottom: 1px solid var(--color);
        content: '';
        display: block;
        width: 100%;
      }

      @media (hover: hover) {
        &[data-hover-disabled='false'] .disclosure--toggle:hover > .disclosure--current-option:before {
          position: absolute;
          top: calc(50% + var(--font--size));
          border-bottom: 1px solid var(--color);
          content: '';
          display: block;
          width: 100%;
        }
      }
    }

    [class*='icon--chevron'] {
      display: none;
    }

    .disclosure--toggle {
      padding: 0;
      color: var(--color);
    }

    .disclosure--current-option p {
      display: none;
    }
  }
{%- endstylesheet -%}