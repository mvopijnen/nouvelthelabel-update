<!-- snippets/preload.liquid -->

{%- doc -%}
  Outputs preload hints for fonts and theme scripts.
{%- enddoc -%}

<link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
{%- unless settings.typography--heading.system? and settings.typography--nav.system? and settings.typography--paragraph.system? -%}
  <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
{%- endunless -%}

<script type="importmap">
  {
    "imports": {
      "@troop-themes/main": "{{ 'theme.js' | asset_url }}"
    }
  }
</script>

{%- assign font_heading_url = settings.typography--heading | font_url -%}
{%- unless font_heading_url == blank -%}
  <link
    rel="preload"
    href="{{ font_heading_url }}"
    as="font"
    type="font/woff2"
    crossorigin
  >
{%- endunless -%}

{%- assign font_nav_url = settings.typography--nav | font_url -%}
{%- if font_nav_url != blank and font_nav_url != font_heading_url -%}
  <link
    rel="preload"
    href="{{ font_nav_url }}"
    as="font"
    type="font/woff2"
    crossorigin
  >
{%- endif -%}

{%- assign font_paragraph_url = settings.typography--paragraph | font_url -%}
{%- if font_paragraph_url != blank and font_paragraph_url != font_heading_url and font_paragraph_url != font_nav_url -%}
  <link
    rel="preload"
    href="{{ font_paragraph_url }}"
    as="font"
    type="font/woff2"
    crossorigin
  >
{%- endif -%}