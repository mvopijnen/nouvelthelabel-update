<div id="FaqSection-{{ section.id }}" class="faq-wrapper">
  <div class="container-custom">
    
    <!-- Header -->
    {% if section.settings.main_title != blank %}
      <div class="header">
        <h1 class="main-title">{{ section.settings.main_title }}</h1>
      </div>
    {% endif %}

    <div class="layout">
      <!-- Tabs (Categories) -->
      <div class="sidebar">
        <div class="categories">
          {% assign first_active_set = false %}
          {% for i in (1..6) %}
            {% assign tab_name = blank %}
            {% case i %}
              {% when 1 %}{% assign tab_name = section.settings.cat_1_tab %}
              {% when 2 %}{% assign tab_name = section.settings.cat_2_tab %}
              {% when 3 %}{% assign tab_name = section.settings.cat_3_tab %}
              {% when 4 %}{% assign tab_name = section.settings.cat_4_tab %}
              {% when 5 %}{% assign tab_name = section.settings.cat_5_tab %}
              {% when 6 %}{% assign tab_name = section.settings.cat_6_tab %}
            {% endcase %}
            
            {% if tab_name != blank %}
              <button class="category-btn {% if first_active_set == false %}active{% endif %}" data-category="cat-{{ i }}">
                {{ tab_name | upcase }}
              </button>
              <!-- Separator (Wordt verborgen op mobiel of na de laatste) -->
              <span class="separator separator-{{ i }}">|</span>
              {% assign first_active_set = true %}
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <!-- Content (FAQ Items) -->
      <div class="content">
        {% assign first_content_set = false %}
        {% for i in (1..6) %}
          {% assign tab_name = blank %}
          {% assign sec_title = blank %}
          {% case i %}
            {% when 1 %}
              {% assign tab_name = section.settings.cat_1_tab %}
              {% assign sec_title = section.settings.cat_1_title %}
            {% when 2 %}
              {% assign tab_name = section.settings.cat_2_tab %}
              {% assign sec_title = section.settings.cat_2_title %}
            {% when 3 %}
              {% assign tab_name = section.settings.cat_3_tab %}
              {% assign sec_title = section.settings.cat_3_title %}
            {% when 4 %}
              {% assign tab_name = section.settings.cat_4_tab %}
              {% assign sec_title = section.settings.cat_4_title %}
            {% when 5 %}
              {% assign tab_name = section.settings.cat_5_tab %}
              {% assign sec_title = section.settings.cat_5_title %}
            {% when 6 %}
              {% assign tab_name = section.settings.cat_6_tab %}
              {% assign sec_title = section.settings.cat_6_title %}
          {% endcase %}
          
          {% if tab_name != blank %}
            <div class="faq-section {% if first_content_set == true %}hidden{% endif %}" data-category="cat-{{ i }}">
              {% if sec_title != blank %}
                <h2 class="section-title">{{ sec_title }}</h2>
              {% endif %}
              
              <div class="faq-list">
                {% for block in section.blocks %}
                  {% assign block_cat_value = block.settings.category | plus: 0 %}
                  {% if block_cat_value == i %}
                    <div class="faq-item" {{ block.shopify_attributes }}>
                      <button class="faq-question">
                        <span class="question-text">{{ block.settings.question }}</span>
                        <svg class="chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
                        </svg>
                      </button>
                      <div class="faq-answer">
                        <div class="answer-text">
                          {{ block.settings.answer }}
                        </div>
                      </div>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
            {% assign first_content_set = true %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<style>
  /* ------------------- GLOBALS & LAYOUT ------------------- */
  #FaqSection-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.spacing_above }};
    padding-bottom: {{ section.settings.spacing_below }};
    {% if section.settings.border == 'top' %}
      border-top: 1px solid {{ section.settings.border_color }};
    {% elsif section.settings.border == 'bottom' %}
      border-bottom: 1px solid {{ section.settings.border_color }};
    {% elsif section.settings.border == 'all' %}
      border: 1px solid {{ section.settings.border_color }};
    {% endif %}
  }

  #FaqSection-{{ section.id }} .container-custom {
    max-width: {{ section.settings.container_width }};
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ------------------- TYPOGRAPHY & COLORS ------------------- */
  #FaqSection-{{ section.id }} .header {
    text-align: {{ section.settings.title_alignment }};
    margin-bottom: 5px;
  }

  #FaqSection-{{ section.id }} .main-title {
    font-size: 27px;
    font-weight: 300; /* Aangepast naar het strakke thema font-weight */
    letter-spacing: 1px;
    margin-bottom: 24px;
    color: {{ section.settings.title_color }};
    line-height: 1.2;
    overflow-wrap: break-word;
  }

  /* ------------------- TABS / SIDEBAR ------------------- */
  #FaqSection-{{ section.id }} .layout {
    display: flex;
    flex-direction: column;
    gap: 80px;
  }

  #FaqSection-{{ section.id }} .sidebar {
    width: 100%;
  }

  #FaqSection-{{ section.id }} .categories {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  #FaqSection-{{ section.id }} .category-btn {
    transition: all 0.3s ease;
    border: none;
    background: transparent;
    padding: 12px 16px;
    font-size: 11px;
    font-weight: 400;
    cursor: pointer;
    text-align: center;
    color: {{ section.settings.label_color }};
    letter-spacing: 1px;
    border-bottom: 2px solid transparent;
    min-width: 85px;
    white-space: nowrap;
    font-family: inherit;
  }

  #FaqSection-{{ section.id }} .category-btn:hover,
  #FaqSection-{{ section.id }} .category-btn.active {
    color: {{ section.settings.title_color }};
  }

  #FaqSection-{{ section.id }} .category-btn.active {
    font-weight: 600;
    border-bottom: 2px solid {{ section.settings.title_color }};
  }

  #FaqSection-{{ section.id }} .separator {
    color: {{ section.settings.border_color }};
    font-size: 14px;
    font-weight: 300;
  }
  
  /* Verberg altijd de laatste separator dynamisch via CSS */
  #FaqSection-{{ section.id }} .categories > .separator:last-of-type {
    display: none;
  }

  /* ------------------- FAQ CONTENT ------------------- */
  #FaqSection-{{ section.id }} .content {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
  }

  #FaqSection-{{ section.id }} .faq-section {
    margin-bottom: 80px;
  }

  #FaqSection-{{ section.id }} .faq-section.hidden {
    display: none;
  }

  #FaqSection-{{ section.id }} .section-title {
    font-weight: 400;
    letter-spacing: 1px;
    font-size: 13px;
    color: {{ section.settings.title_color }};
    margin-bottom: 40px;
    padding-bottom: 16px;
    border-bottom: 1px solid {{ section.settings.border_color }};
  }

  #FaqSection-{{ section.id }} .faq-list {
    display: flex;
    flex-direction: column;
  }

  #FaqSection-{{ section.id }} .faq-item {
    border-bottom: 1px solid {{ section.settings.border_color }};
    transition: all 0.3s ease;
  }

  #FaqSection-{{ section.id }} .faq-item:hover {
    background-color: {{ section.settings.hover_bg_color }};
  }

  #FaqSection-{{ section.id }} .faq-question {
    width: 100%;
    padding: 24px 0;
    text-align: left;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }

  #FaqSection-{{ section.id }} .question-text {
    font-weight: 400;
    color: {{ section.settings.title_color }};
    font-size: 11px;
  }

  #FaqSection-{{ section.id }} .chevron {
    width: 12px;
    height: 12px;
    color: {{ section.settings.label_color }};
    transition: all 0.3s ease;
    stroke-width: 1;
    flex-shrink: 0;
    margin-left: 16px;
  }

  #FaqSection-{{ section.id }} .chevron.rotate {
    transform: rotate(180deg);
    color: {{ section.settings.title_color }};
  }

  #FaqSection-{{ section.id }} .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease, opacity 0.4s ease, padding 0.4s ease;
    opacity: 0;
  }

  #FaqSection-{{ section.id }} .faq-answer.open {
    max-height: 800px; /* Voldoende ruimte voor lange antwoorden */
    opacity: 1;
    padding-bottom: 24px;
  }

  #FaqSection-{{ section.id }} .answer-text {
    color: {{ section.settings.text_color }};
    font-size: 11px;
    line-height: 1.7;
    font-weight: 300;
  }

  /* Styling voor de Shopify Editor opsommingstekens en bolds in de FAQ antwoorden */
  #FaqSection-{{ section.id }} .answer-text p {
    margin-bottom: 12px;
  }
  #FaqSection-{{ section.id }} .answer-text p:last-child {
    margin-bottom: 0;
  }
  #FaqSection-{{ section.id }} .answer-text strong, 
  #FaqSection-{{ section.id }} .answer-text b {
    font-weight: 500;
    color: {{ section.settings.title_color }};
  }
  #FaqSection-{{ section.id }} .answer-text ul {
    list-style-type: none;
    margin-top: 12px;
    padding-left: 0;
  }
  #FaqSection-{{ section.id }} .answer-text ul li {
    margin-bottom: 8px;
    padding-left: 16px;
    position: relative;
  }
  #FaqSection-{{ section.id }} .answer-text ul li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: {{ section.settings.label_color }};
  }

  /* ------------------- MOBILE RESPONSIVENESS ------------------- */
  @media (max-width: 1024px) {
    #FaqSection-{{ section.id }} .container-custom { padding: 60px 24px; }
    #FaqSection-{{ section.id }} .main-title { font-size: 27px; }
    #FaqSection-{{ section.id }} .header { margin-bottom: 60px; }
    #FaqSection-{{ section.id }} .layout { gap: 60px; }
  }

  @media (max-width: 768px) {
    #FaqSection-{{ section.id }} {
      padding-top: {{ section.settings.mobile_spacing_above }};
      padding-bottom: {{ section.settings.mobile_spacing_below }};
    }
    
    #FaqSection-{{ section.id }} .container-custom {
      {% if section.settings.mobile_full_width %}
        padding: 0 0;
      {% else %}
        padding: 0 16px; 
      {% endif %}
    }

    #FaqSection-{{ section.id }} .main-title { font-size: 24px; margin-bottom: 0; }
    #FaqSection-{{ section.id }} .header { margin-bottom: 32px; text-align: {{ section.settings.mobile_title_alignment }}; }
    #FaqSection-{{ section.id }} .layout { gap: 50px; }

    /* Mobiele Tabs Grid (Twee naast elkaar) */
    #FaqSection-{{ section.id }} .categories {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      max-width: 400px;
      margin: 0 auto;
    }

    #FaqSection-{{ section.id }} .separator { display: none !important; }

    #FaqSection-{{ section.id }} .category-btn {
      font-size: 11px;
      padding: 14px 12px;
      width: 100%;
      min-width: auto;
      border: 1px solid {{ section.settings.border_color }};
      border-radius: 6px;
      background-color: {{ section.settings.bg_color }};
    }

    #FaqSection-{{ section.id }} .category-btn:hover {
      background-color: {{ section.settings.hover_bg_color }};
    }

    #FaqSection-{{ section.id }} .category-btn.active {
      background-color: {{ section.settings.title_color }};
      color: {{ section.settings.bg_color }};
      border-color: {{ section.settings.title_color }};
    }

    #FaqSection-{{ section.id }} .faq-section { margin-bottom: 32px; }
    #FaqSection-{{ section.id }} .section-title {
      margin-bottom: 20px;
      padding-bottom: 10px;
      text-align: center;
    }

    #FaqSection-{{ section.id }} .faq-item {
      border-radius: 8px;
      border: 1px solid {{ section.settings.border_color }};
      margin-bottom: 8px;
      background-color: {{ section.settings.bg_color }};
    }

    #FaqSection-{{ section.id }} .faq-question { padding: 18px 16px; }
    #FaqSection-{{ section.id }} .question-text { padding-right: 8px; line-height: 1.4; }
    
    #FaqSection-{{ section.id }} .faq-answer.open {
      padding-bottom: 18px;
      padding-left: 16px;
      padding-right: 16px;
    }
  }
</style>

<script>
  (function() {
    const wrapper = document.getElementById('FaqSection-{{ section.id }}');
    if (!wrapper) return;

    // Voorkom dubbele events in de Theme Editor
    if (wrapper.dataset.jsInit === 'true') return;
    wrapper.dataset.jsInit = 'true';

    // We gebruiken Event Delegation zonder DOMContentLoaded, 
    // zodat het direct werkt in de Shopify Theme Editor!
    wrapper.addEventListener('click', function(e) {
      
      // 1. Tabblad functionaliteit
      const categoryBtn = e.target.closest('.category-btn');
      if (categoryBtn) {
        const category = categoryBtn.dataset.category;
        
        // Verwijder active state van alle knoppen
        wrapper.querySelectorAll('.category-btn').forEach(btn => btn.classList.remove('active'));
        categoryBtn.classList.add('active');
        
        // Verberg/toon de juiste content secties
        wrapper.querySelectorAll('.faq-section').forEach(sec => {
          if (sec.dataset.category === category) {
            sec.classList.remove('hidden');
          } else {
            sec.classList.add('hidden');
          }
        });
      }

      // 2. Accordeon functionaliteit (Vragen openklappen)
      const faqQuestion = e.target.closest('.faq-question');
      if (faqQuestion) {
        const faqItem = faqQuestion.parentElement;
        const answer = faqItem.querySelector('.faq-answer');
        const chevron = faqQuestion.querySelector('.chevron');
        
        if (answer) answer.classList.toggle('open');
        if (chevron) chevron.classList.toggle('rotate');
      }
    });
  })();
</script>

