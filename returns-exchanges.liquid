<div id="ReturnsSection-{{ section.id }}" class="returns-wrapper">

  <!-- Hero Section -->
  <header class="section-padding bg-secondary text-center">
    <div class="container-custom">
      <h1 class="custom-title fade-in stagger-1">{{ section.settings.hero_title }}</h1>
      <p class="custom-subtitle font-italic text-muted fade-in stagger-2 mb-6">{{ section.settings.hero_subtitle }}</p>
      <div class="divider mx-auto fade-in stagger-3 mb-6"></div>
      <p class="custom-text text-muted max-w-2xl mx-auto fade-in stagger-4">
        {{ section.settings.hero_text }}
      </p>
    </div>
  </header>

  <!-- USPs Section -->
  <section class="section-padding bg-primary">
    <div class="container-custom">
      <div class="grid-3 gap-6">
        <!-- USP 1 -->
        <div class="text-center p-6 slide-up stagger-1">
          <div class="icon-circle mx-auto mb-4 bg-dark text-light">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="custom-block-title mb-1">{{ section.settings.usp1_title }}</h3>
          <p class="custom-text text-muted">{{ section.settings.usp1_text }}</p>
        </div>
        <!-- USP 2 -->
        <div class="text-center p-6 slide-up stagger-2">
          <div class="icon-circle mx-auto mb-4 bg-dark text-light">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="custom-block-title mb-1">{{ section.settings.usp2_title }}</h3>
          <p class="custom-text text-muted">{{ section.settings.usp2_text }}</p>
        </div>
        <!-- USP 3 -->
        <div class="text-center p-6 slide-up stagger-3">
          <div class="icon-circle mx-auto mb-4 bg-dark text-light">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="custom-block-title mb-1">{{ section.settings.usp3_title }}</h3>
          <p class="custom-text text-muted">{{ section.settings.usp3_text }}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA 1 Section -->
  <section class="section-padding bg-secondary">
    <div class="container-custom max-w-3xl text-center">
      <h2 class="custom-title mb-6">{{ section.settings.cta1_title }}</h2>
      <div class="flex-center gap-4 flex-col-mobile">
        {% if section.settings.cta1_btn1_text != blank %}
          <a href="{{ section.settings.cta1_btn1_link }}" class="custom-btn btn-dark slide-up stagger-1">
            {{ section.settings.cta1_btn1_text }}
          </a>
        {% endif %}
        {% if section.settings.cta1_btn2_text != blank %}
          <a href="{{ section.settings.cta1_btn2_link }}" class="custom-btn btn-outline slide-up stagger-2">
            {{ section.settings.cta1_btn2_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </section>

  <!-- Steps Section -->
  <section class="section-padding bg-primary">
    <div class="container-custom">
      <div class="text-center mb-12">
        <p class="custom-text tracking-widest uppercase text-muted mb-2">{{ section.settings.steps_super }}</p>
        <h2 class="custom-title">{{ section.settings.steps_title }}</h2>
        <p class="custom-text tracking-wide uppercase text-muted mt-2">{{ section.settings.steps_sub }}</p>
      </div>
      
      <div class="max-w-3xl mx-auto space-y-10">
        <!-- Step 1 -->
        <div class="slide-up stagger-1 flex-start gap-6">
          <div class="flex-shrink-0">
            <div class="step-circle bg-dark text-light flex-center">
              <span class="step-number">1</span>
            </div>
          </div>
          <div>
            <h3 class="custom-block-title mb-1">{{ section.settings.step1_title }}</h3>
            <p class="custom-text text-muted">{{ section.settings.step1_text }}</p>
          </div>
        </div>
        <!-- Step 2 -->
        <div class="slide-up stagger-2 flex-start gap-6">
          <div class="flex-shrink-0">
            <div class="step-circle bg-dark text-light flex-center">
              <span class="step-number">2</span>
            </div>
          </div>
          <div>
            <h3 class="custom-block-title mb-1">{{ section.settings.step2_title }}</h3>
            <p class="custom-text text-muted">{{ section.settings.step2_text }}</p>
          </div>
        </div>
        <!-- Step 3 -->
        <div class="slide-up stagger-3 flex-start gap-6">
          <div class="flex-shrink-0">
            <div class="step-circle bg-dark text-light flex-center">
              <span class="step-number">3</span>
            </div>
          </div>
          <div>
            <h3 class="custom-block-title mb-1">{{ section.settings.step3_title }}</h3>
            <p class="custom-text text-muted">{{ section.settings.step3_text }}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Policy Details -->
  <section class="section-padding bg-secondary">
    <div class="container-custom">
      <div class="text-center mb-12">
        <p class="custom-text tracking-widest uppercase text-muted mb-2">{{ section.settings.policy_super }}</p>
        <h2 class="custom-title">{{ section.settings.policy_title }}</h2>
      </div>
      <div class="grid-2 gap-6">
        <div class="bg-primary p-6 shadow-sm slide-up stagger-1">
          <h3 class="custom-block-title mb-2">{{ section.settings.policy1_title }}</h3>
          <p class="custom-text text-muted">{{ section.settings.policy1_text }}</p>
        </div>
        <div class="bg-primary p-6 shadow-sm slide-up stagger-2">
          <h3 class="custom-block-title mb-2">{{ section.settings.policy2_title }}</h3>
          <p class="custom-text text-muted">{{ section.settings.policy2_text }}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Processing & Exchange -->
  <section class="section-padding bg-primary">
    <div class="container-custom">
      <div class="grid-2 gap-10">
        <!-- Verwerking -->
        <div class="slide-up stagger-1">
          <h2 class="custom-title mb-6">{{ section.settings.process_title }}</h2>
          <div class="space-y-6">
            <div>
              <h3 class="custom-block-title mb-1">{{ section.settings.process1_title }}</h3>
              <p class="custom-text text-muted">{{ section.settings.process1_text }}</p>
            </div>
            <div>
              <h3 class="custom-block-title mb-1">{{ section.settings.process2_title }}</h3>
              <p class="custom-text text-muted">{{ section.settings.process2_text }}</p>
            </div>
          </div>
        </div>
        <!-- Omruilen -->
        <div class="slide-up stagger-2">
          <h2 class="custom-title mb-6">{{ section.settings.exchange_title }}</h2>
          <div class="space-y-6">
            <div>
              <h3 class="custom-block-title mb-1">{{ section.settings.exchange1_title }}</h3>
              <p class="custom-text text-muted">{{ section.settings.exchange1_text }}</p>
            </div>
            <div>
              <h3 class="custom-block-title mb-1">{{ section.settings.exchange2_title }}</h3>
              <p class="custom-text text-muted">{{ section.settings.exchange2_text }}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Dark Service Section -->
  <section class="section-padding bg-dark text-light">
    <div class="container-custom max-w-4xl">
      <div class="grid-2 gap-10 align-center">
        <div class="slide-up stagger-1">
          <p class="custom-text tracking-widest uppercase text-dark-muted mb-2">{{ section.settings.service_super }}</p>
          <h2 class="custom-title mb-4">{{ section.settings.service_title }}</h2>
          <p class="custom-subtitle font-italic text-dark-muted mb-4">{{ section.settings.service_sub }}</p>
          <p class="custom-text text-dark-muted">{{ section.settings.service_text }}</p>
        </div>
        <div class="slide-up stagger-2 space-y-4">
          <div class="bg-dark-light p-6">
            <h3 class="custom-block-title mb-2">Email</h3>
            <a href="mailto:{{ section.settings.service_email }}" class="custom-text text-dark-muted hover-text-light break-all transition-colors">
              {{ section.settings.service_email }}
            </a>
          </div>
          <div class="bg-dark-light p-6">
            <h3 class="custom-block-title mb-2">WhatsApp</h3>
            <a href="https://wa.me/{{ section.settings.service_wa_clean }}" target="_blank" rel="noopener noreferrer" class="custom-text text-dark-muted hover-text-light transition-colors">
              {{ section.settings.service_wa_display }}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section-padding bg-secondary">
    <div class="container-custom max-w-3xl text-center">
      <p class="custom-text tracking-widest uppercase text-muted mb-2">{{ section.settings.cta2_super }}</p>
      <h2 class="custom-title mb-8">{{ section.settings.cta2_title }}</h2>
      <div class="flex-center gap-4 flex-col-mobile">
        {% if section.settings.cta2_btn1_text != blank %}
          <a href="{{ section.settings.cta2_btn1_link }}" class="custom-btn btn-dark slide-up stagger-1">
            {{ section.settings.cta2_btn1_text }}
          </a>
        {% endif %}
        {% if section.settings.cta2_btn2_text != blank %}
          <a href="{{ section.settings.cta2_btn2_link }}" class="custom-btn btn-outline slide-up stagger-2">
            {{ section.settings.cta2_btn2_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </section>

</div>

<style>
  /* ------------------- GLOBALS & LAYOUT ------------------- */
  #ReturnsSection-{{ section.id }} {
    color: {{ section.settings.text_color }};
    margin-top: {{ section.settings.spacing_above }};
    margin-bottom: {{ section.settings.spacing_below }};
  }

  /* Colors */
  #ReturnsSection-{{ section.id }} .bg-primary { background-color: {{ section.settings.bg_primary }}; }
  #ReturnsSection-{{ section.id }} .bg-secondary { background-color: {{ section.settings.bg_secondary }}; }
  #ReturnsSection-{{ section.id }} .bg-dark { background-color: {{ section.settings.bg_dark }}; color: {{ section.settings.text_light }}; }
  #ReturnsSection-{{ section.id }} .bg-dark-light { background-color: {{ section.settings.bg_dark_light }}; }
  
  #ReturnsSection-{{ section.id }} .text-light { color: {{ section.settings.text_light }}; }
  #ReturnsSection-{{ section.id }} .text-muted { color: {{ section.settings.text_muted }}; }
  #ReturnsSection-{{ section.id }} .text-dark-muted { color: {{ section.settings.text_dark_muted }}; }
  
  #ReturnsSection-{{ section.id }} .hover-text-light:hover { color: {{ section.settings.text_light }}; }

  /* Containers & Padding */
  #ReturnsSection-{{ section.id }} .container-custom {
    margin: 0 auto;
    padding: 0 24px;
    width: 100%;
    max-width: {{ section.settings.container_width }};
  }
  #ReturnsSection-{{ section.id }} .max-w-2xl { max-width: 42rem; }
  #ReturnsSection-{{ section.id }} .max-w-3xl { max-width: 48rem; }
  #ReturnsSection-{{ section.id }} .max-w-4xl { max-width: 56rem; }
  
  #ReturnsSection-{{ section.id }} .section-padding { padding: 64px 0; }

  /* ------------------- TYPOGRAPHY ------------------- */
  
  /* Hoofdtitels (Normaal gewicht, Hoofdletters) */
  #ReturnsSection-{{ section.id }} .custom-title {
    font-size: 24px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 1px;
    line-height: 1.3;
    margin: 0;
  }
  
  /* Sub-kopjes en Tussenkopjes (Normaal gewicht, Hoofdletters) */
  #ReturnsSection-{{ section.id }} .custom-block-title {
    font-size: 13px;
    line-height: 1.4;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0;
  }
  
  /* Voor overige (schuingedrukte) zinnetjes */
  #ReturnsSection-{{ section.id }} .custom-subtitle {
    font-size: 16px;
    line-height: 1.4;
    font-weight: normal;
    margin: 0;
  }
  
  #ReturnsSection-{{ section.id }} .custom-text {
    font-size: 11px;
    line-height: 1.6;
    margin: 0;
  }
  
  #ReturnsSection-{{ section.id }} .step-number {
    font-size: 16px;
    font-weight: 400;
  }

  /* Modifiers */
  #ReturnsSection-{{ section.id }} .font-italic { font-style: italic; }
  #ReturnsSection-{{ section.id }} .uppercase { text-transform: uppercase; }
  #ReturnsSection-{{ section.id }} .tracking-widest { letter-spacing: 0.1em; }
  #ReturnsSection-{{ section.id }} .tracking-wide { letter-spacing: 0.05em; }
  #ReturnsSection-{{ section.id }} .text-center { text-align: center; }
  #ReturnsSection-{{ section.id }} .break-all { word-break: break-all; }

  #ReturnsSection-{{ section.id }} .mb-1 { margin-bottom: 0.25rem; }
  #ReturnsSection-{{ section.id }} .mb-2 { margin-bottom: 0.5rem; }
  #ReturnsSection-{{ section.id }} .mb-4 { margin-bottom: 1rem; }
  #ReturnsSection-{{ section.id }} .mb-6 { margin-bottom: 1.5rem; }
  #ReturnsSection-{{ section.id }} .mb-8 { margin-bottom: 2rem; }
  #ReturnsSection-{{ section.id }} .mb-12 { margin-bottom: 3rem; }
  #ReturnsSection-{{ section.id }} .mt-2 { margin-top: 0.5rem; }
  #ReturnsSection-{{ section.id }} .mx-auto { margin-left: auto; margin-right: auto; }

  /* ------------------- COMPONENTS ------------------- */
  #ReturnsSection-{{ section.id }} .divider {
    width: 48px;
    height: 1px;
    background-color: {{ section.settings.text_color }};
  }

  #ReturnsSection-{{ section.id }} .icon-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #ReturnsSection-{{ section.id }} .step-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    transition: transform 0.3s;
  }

  /* Buttons */
  #ReturnsSection-{{ section.id }} .custom-btn {
    font-size: 12px;
    letter-spacing: 1px;
    padding: 12px 24px;
    font-weight: 500;
    text-decoration: none;
    text-align: center;
    display: inline-block;
    transition: all 0.3s ease;
  }
  
  #ReturnsSection-{{ section.id }} .btn-dark {
    background-color: {{ section.settings.bg_dark }};
    color: {{ section.settings.text_light }};
    border: 1px solid {{ section.settings.bg_dark }};
  }
  #ReturnsSection-{{ section.id }} .btn-dark:hover { opacity: 0.9; }

  #ReturnsSection-{{ section.id }} .btn-outline {
    background-color: {{ section.settings.bg_primary }};
    color: {{ section.settings.text_color }};
    border: 1px solid {{ section.settings.text_color }};
  }
  #ReturnsSection-{{ section.id }} .btn-outline:hover { background-color: {{ section.settings.bg_secondary }}; }

  #ReturnsSection-{{ section.id }} .shadow-sm { box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05); }
  #ReturnsSection-{{ section.id }} .p-6 { padding: 1.5rem; }

  /* ------------------- LAYOUT GRIDS ------------------- */
  #ReturnsSection-{{ section.id }} .grid-3 { display: grid; grid-template-columns: 1fr; gap: 24px; }
  #ReturnsSection-{{ section.id }} .grid-2 { display: grid; grid-template-columns: 1fr; gap: 24px; }
  
  #ReturnsSection-{{ section.id }} .flex-center { display: flex; justify-content: center; align-items: center; }
  #ReturnsSection-{{ section.id }} .flex-start { display: flex; justify-content: flex-start; align-items: flex-start; }
  #ReturnsSection-{{ section.id }} .flex-shrink-0 { flex-shrink: 0; }
  #ReturnsSection-{{ section.id }} .align-center { align-items: center; }
  #ReturnsSection-{{ section.id }} .gap-4 { gap: 16px; }
  #ReturnsSection-{{ section.id }} .gap-6 { gap: 24px; }
  #ReturnsSection-{{ section.id }} .gap-10 { gap: 40px; }
  #ReturnsSection-{{ section.id }} .space-y-4 > * + * { margin-top: 16px; }
  #ReturnsSection-{{ section.id }} .space-y-6 > * + * { margin-top: 24px; }
  #ReturnsSection-{{ section.id }} .space-y-10 > * + * { margin-top: 40px; }

  /* ------------------- ANIMATIONS ------------------- */
  @keyframes returnsFadeIn { to { opacity: 1; } }
  @keyframes returnsSlideUp { to { opacity: 1; transform: translateY(0); } }

  #ReturnsSection-{{ section.id }} .fade-in { animation: returnsFadeIn 0.6s ease forwards; opacity: 0; }
  #ReturnsSection-{{ section.id }} .slide-up { animation: returnsSlideUp 0.5s ease forwards; opacity: 0; transform: translateY(12px); }
  
  #ReturnsSection-{{ section.id }} .stagger-1 { animation-delay: 0.05s; }
  #ReturnsSection-{{ section.id }} .stagger-2 { animation-delay: 0.1s; }
  #ReturnsSection-{{ section.id }} .stagger-3 { animation-delay: 0.15s; }
  #ReturnsSection-{{ section.id }} .stagger-4 { animation-delay: 0.2s; }

  /* Hover effect for steps */
  #ReturnsSection-{{ section.id }} .flex-start:hover .step-circle { transform: scale(1.1); }

  /* ------------------- RESPONSIVE ------------------- */
  @media (min-width: 768px) {
    #ReturnsSection-{{ section.id }} .section-padding { padding: 96px 0; }
    #ReturnsSection-{{ section.id }} .grid-3 { grid-template-columns: repeat(3, 1fr); }
    #ReturnsSection-{{ section.id }} .grid-2 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 767px) {
    #ReturnsSection-{{ section.id }} {
      margin-top: {{ section.settings.mobile_spacing_above }};
      margin-bottom: {{ section.settings.mobile_spacing_below }};
    }
    #ReturnsSection-{{ section.id }} .custom-title { font-size: 20px; }
    #ReturnsSection-{{ section.id }} .custom-block-title { font-size: 12px; }
    #ReturnsSection-{{ section.id }} .custom-btn { font-size: 11px; width: 100%; }
    #ReturnsSection-{{ section.id }} .flex-col-mobile { flex-direction: column; width: 100%; }
    
    #ReturnsSection-{{ section.id }} .container-custom {
      {% if section.settings.mobile_full_width %}
        padding: 0 0;
      {% else %}
        padding: 0 24px; 
      {% endif %}
    }
  }
</style>

{% schema %}
{
  "name": "Retourneren & Omruilen",
  "settings": [
    {
      "type": "header",
      "content": "Layout Desktop"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Maximale breedte content",
      "options": [
        { "value": "1000px", "label": "Medium" },
        { "value": "1024px", "label": "Large (Aanbevolen)" },
        { "value": "100%", "label": "Volledige breedte" }
      ],
      "default": "1024px"
    },
    {
      "type": "select",
      "id": "spacing_above",
      "label": "Marge boven sectie",
      "options": [
        { "value": "0px", "label": "Geen" },
        { "value": "40px", "label": "Klein" },
        { "value": "80px", "label": "Normaal" }
      ],
      "default": "0px"
    },
    {
      "type": "select",
      "id": "spacing_below",
      "label": "Marge onder sectie",
      "options": [
        { "value": "0px", "label": "Geen" },
        { "value": "40px", "label": "Klein" },
        { "value": "80px", "label": "Normaal" }
      ],
      "default": "0px"
    },
    {
      "type": "header",
      "content": "Layout Mobiel"
    },
    {
      "type": "checkbox",
      "id": "mobile_full_width",
      "label": "Volledige breedte (geen padding zijkant)",
      "default": false
    },
    {
      "type": "select",
      "id": "mobile_spacing_above",
      "label": "Marge boven sectie",
      "options": [
        { "value": "0px", "label": "Geen" },
        { "value": "30px", "label": "Klein" },
        { "value": "60px", "label": "Normaal" }
      ],
      "default": "0px"
    },
    {
      "type": "select",
      "id": "mobile_spacing_below",
      "label": "Marge onder sectie",
      "options": [
        { "value": "0px", "label": "Geen" },
        { "value": "30px", "label": "Klein" },
        { "value": "60px", "label": "Normaal" }
      ],
      "default": "0px"
    },
    {
      "type": "header",
      "content": "Kleuren Lichte Secties"
    },
    {
      "type": "color",
      "id": "bg_primary",
      "label": "Achtergrond 1 (Wit)",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bg_secondary",
      "label": "Achtergrond 2 (Lichtgrijs)",
      "default": "#f5f5f4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Titel Kleur (Zwart)",
      "default": "#1c1917"
    },
    {
      "type": "color",
      "id": "text_muted",
      "label": "Subtekst Kleur (Grijs)",
      "default": "#57534e"
    },
    {
      "type": "header",
      "content": "Kleuren Donkere Secties"
    },
    {
      "type": "color",
      "id": "bg_dark",
      "label": "Achtergrond Donker",
      "default": "#1c1917"
    },
    {
      "type": "color",
      "id": "bg_dark_light",
      "label": "Achtergrond Donkere Box",
      "default": "#292524"
    },
    {
      "type": "color",
      "id": "text_light",
      "label": "Tekstkleur op Donker (Wit)",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_dark_muted",
      "label": "Subtekst op Donker (Lichtgrijs)",
      "default": "#a8a29e"
    },
    {
      "type": "header",
      "content": "1. Hero Sectie"
    },
    { "type": "text", "id": "hero_title", "label": "Titel", "default": "RETOURNEREN & OMRUILEN" },
    { "type": "text", "id": "hero_subtitle", "label": "Subtitel", "default": "Niet tevreden? Geen probleem." },
    { "type": "textarea", "id": "hero_text", "label": "Tekst", "default": "Wij maken het makkelijk voor je. Gratis retourneren, snelle terugbetaling en persoonlijke hulp. Jouw tevredenheid is onze prioriteit." },
    {
      "type": "header",
      "content": "2. USP's (Voordelen)"
    },
    { "type": "text", "id": "usp1_title", "label": "Voordeel 1 Titel", "default": "GRATIS RETOUR" },
    { "type": "text", "id": "usp1_text", "label": "Voordeel 1 Tekst", "default": "Altijd gratis retourneren binnen Nederland & België" },
