<!-- sections/logo-list.liquid -->

{%- liquid
  assign auto_rotate = section.settings.auto-rotate
  assign bg_color = section.settings.background-color
  assign block_heading_type = section.settings.block-heading-type
  assign border = section.settings.border
  assign container_width = section.settings.container-width
  assign button_link = section.settings.button-link
  assign button_style = section.settings.button-style
  assign button_text = section.settings.button-text
  assign heading = section.settings.heading
  assign heading_type = section.settings.heading-type
  assign image_height = section.settings.image-height
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign mobile_text_alignment = section.settings.mobile-alignment
  assign rotate_frequency = section.settings.rotate-frequency
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign text_color = section.settings.text-color
  assign text_width = section.settings.text-width
-%}

{%- for block in section.blocks -%}
  {%- liquid
    assign block_heading = block.settings.heading
    assign image = block.settings.image
    assign image_aspect_ratio = image.aspect_ratio | default: 2.5
    assign max_image_width = image_height | times: 8
    assign image_width = image_height | times: image_aspect_ratio | round | at_most: max_image_width
    assign sizes = image_width | append: 'px'

    capture image_html
      if image == blank
        render 'placeholder', type: 'logo', aspect_ratio: image_aspect_ratio
      else
        echo image | image_url: width: image_width | image_tag: width: image_width, loading: 'lazy', sizes: sizes
      endif
    endcapture
  -%}

  {%- capture block_html -%}
    {{- block_html -}}

    <div
      class="logo-list--block"
      data-index="{{ forloop.index0 }}"
      data-container="block"
      aria-hidden="true"
      {{ block.shopify_attributes }}
    >
      <h3 class="logo-list--block-heading" data-item="{{ block_heading_type }}">
        {{- block_heading -}}
      </h3>

      <div
        class="logo-list--block-image"
        data-mq="small"
        style="--image-width:{{ image_width }}px;"
      >
        {{- image_html -}}
      </div>
    </div>
  {%- endcapture -%}

  {%- capture block_image_html -%}
    {{- block_image_html -}}

    <button
      class="logo-list--image"
      data-index="{{ forloop.index0 }}"
      data-container="block"
      aria-current="false"
      style="--image-width:{{ image_width }}px;"
      {% unless settings.transitions--other %}
        data-transition-item="{{ section.id }}"
      {% endunless %}
    >
     {{- image_html -}}
    </button>
  {%- endcapture -%}
{%- endfor -%}

<logo-list-element
  class="logo-list--root"
  data-section-id="{{ section.id }}"
  data-auto-rotate="{{ auto_rotate }}"
  data-background-color="{{ bg_color }}"
  data-border="{{ border }}"
  data-container-width="{{ container_width }}"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-text-color="{{ text_color }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
  {% if auto_rotate %}
    style="--rotate-frequency:{{ rotate_frequency }}s;"
  {% endif %}
>
  <div
    class="logo-list--wrapper"
    data-container="section"
    data-mobile-x-alignment="{{ mobile_text_alignment }}"
  >
    {%- unless heading == blank -%}
      <div class="logo-list--heading-container" data-container="block">
        <h2 class="logo-list--heading" data-item="{{ heading_type }}">
          {{- heading | escape -}}
        </h2>
      </div>
    {%- endunless -%}

    <div
      class="logo-list--blocks"
      {% if text_width %}
        data-text-width
        style="--text-width:{{ text_width }}px;"
      {% endif %}
    >
      {{- block_html -}}
    </div>

    <div class="logo-list--pagination" data-mq="small">
      {%- for slide_index in (1..section.blocks.size) -%}
        <button
          class="logo-list--pagination-index"
          data-item="pagination-dot"
          data-index="{{ forloop.index0 }}"
          aria-label="{{ slide_index }}"
          aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
        >
          <div></div>
        </button>
      {%- endfor -%}
    </div>

    <div
      class="logo-list--images"
      data-mq="medium-large"
      {% unless settings.transitions--other %}
        data-transition-container="{{ section.id }}"
        data-transition-type="fade-in"
        data-transition-cascade="horizontal"
        data-transition-cascade-interval="300"
      {% endunless %}
    >
      {{- block_image_html -}}
    </div>

    {%- unless button_text == blank -%}
      <div class="logo-list--button" data-container="block">
        <a
          href="{{ button_link }}"
          data-item="{{ button_style }}"
          data-text="{{ button_text }}"
        >
          <span>{{- button_text -}}</span>
        </a>
      </div>
    {%- endunless -%}
  </div>
</logo-list-element>

{% stylesheet %}
  .logo-list--wrapper {
    --grid-row-gap: var(--spacing--block);

    @media (min-width: 768px) {
      justify-content: var(--section--alignment);
    }

    @media (max-width: 767px) {
      justify-content: var(--x-alignment);
    }

    .placeholder--root, img {
      --image--radius: 0;
    }

    .placeholder--root svg {
      scale: 2;
    }
  }

  .logo-list--blocks {
    --text-padding-x: 0px;
    --text-padding-y: 0px;
    display: grid;
    padding-bottom: var(--spacing--item);

    @media (min-width: 768px) {
      justify-self: var(--section--alignment);
    }

    @media (max-width: 767px) {
      justify-self: var(--x-alignment);
    }
  }

  .logo-list--block {
    --transition-duration: 0.6s;
    grid-area: 1 / -1;
    opacity: 1;
    transform: translate3d(0, 0, 0);
    transition: opacity var(--transition-duration) var(--transition--standard), transform var(--transition-duration) var(--transition--standard);

    @media (min-width: 768px) {
      align-items: var(--section--alignment);
    }

    @media (max-width: 767px) {
      align-items: var(--x-alignment);
    }

    &[aria-hidden='pending'] {
      --transition-duration: 0.3s;
      opacity: 0;
      transform: translate3d(0, calc(var(--spacing--item) * -1), 0);
    }

    &[aria-hidden='true'] {
      opacity: 0;
      transform: translate3d(0, var(--spacing--item), 0);
    }
  }

  .logo-list--images {
    display: flex;
    gap: var(--spacing--6);
    flex-wrap: wrap;
    align-items: center;
  }

  .logo-list--heading,
  .logo-list--button {
    @media (min-width: 768px) {
      justify-self: var(--section--alignment);
      text-align: var(--section--text-alignment);
    }

    @media (max-width: 767px) {
      justify-self: var(--x-alignment);
      text-align: var(--text-alignment);
    }
  }

  .logo-list--image {
    padding: 0;
    width: var(--image-width);
    height: fit-content;

    > * {
      opacity: 1;
      transition: opacity 0.2s var(--transition--standard);
      pointer-events: none;
    }

    &[aria-current='false'] > * {
      opacity: 0.25;
    }

    &:hover:not([aria-current='true']) > * {
      opacity: 0.5;
    }
  }

  .logo-list--block-image {
    width: var(--image-width);
  }

  .logo-list--block-heading {
    @media (max-width: 767px) {
      text-align: var(--text-alignment);
    }

    @media (min-width: 768px) {
      text-align: var(--section--text-alignment);
    }
  }

  .logo-list--pagination {
    display: flex;
    gap: var(--spacing--1);
    justify-content: var(--x-alignment);
  }
{% endstylesheet %}

