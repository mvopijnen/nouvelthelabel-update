<!-- sections/contact.liquid -->

{%- liquid
  assign bg_color = section.settings.background-color
  assign border = section.settings.border
  assign container_width = section.settings.container-width
  assign heading = section.settings.heading
  assign heading_type = section.settings.heading-type
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign outer_background = section.settings.outer-background
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign text_color = section.settings.text-color
  assign x_alignment = section.settings.x-alignment
-%}

<div
  class="contact--root"
  data-section-id="{{ section.id }}"
  data-background-color="{{ bg_color }}"
  data-border="{{ border }}"
  data-container-width="{{ container_width }}"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-outer-background="{{ outer_background }}"
  data-text-color="{{ text_color }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
>
  <div class="contact--wrapper" data-container="section">
    {%- unless heading == blank -%}
      <div
        class="contact--header"
        data-container="block"
        data-x-alignment="{{ x_alignment }}"
        {% unless settings.transitions--text %}
          data-transition-item="viewport"
          data-transition-type="slide-in"
        {% endunless %}
      >
        <h2 class="contact--title" data-item="{{ heading_type }}">
          {{- heading -}}
        </h2>
      </div>
    {%- endunless -%}

    {%- form 'contact', id: section.id, class: 'contact--form' -%}
      <div class="contact--blocks">
        {%- for block in section.blocks -%}
          {%- liquid
            unless block.type == 'checkbox' or block.type == 'custom-liquid'
              assign placeholder = block.settings.placeholder
              if block.settings.required
                assign placeholder = placeholder | append: '*'
              endif
            endunless
          -%}

          <div
            class="contact--block"
            data-block-type="{{ block.type }}"
            {% if block.settings.half-width %}
              data-half-width="true"
            {% endif %}
            {% if block.type == 'empty-space' %}
              style="--desktop-height:{{ block.settings.desktop-height }}px;--mobile-height:{{ block.settings.mobile-height }}px;"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {%- case block.type -%}
              {%- when 'text' -%}
                {%- assign field_name = block.settings.placeholder | handleize -%}
                <label for="{{ section.id }}-contact_{{ block.id }}" data-item="hidden-text">
                  {{- placeholder -}}
                </label>
                <input
                  id="{{ section.id }}-contact_{{ block.id }}"
                  type="text"
                  name="contact[{{ field_name }}]"
                  value="{{ contact.fields[field_name] }}"
                  placeholder="{{ placeholder }}"
                  autocomplete="{{ block.settings.autocomplete }}"
                  {% if form.errors contains field_name %}
                    aria-invalid="true"
                    data-text-color="alert"
                  {% endif %}
                  {% if block.settings.required %}
                    required
                  {% endif %}
                />

              {%- when 'email' -%}
                <label for="{{ section.id }}-contact_email" data-item="hidden-text">
                  {{- block.settings.placeholder -}}
                </label>
                <input
                  id="{{ section.id }}-contact_email"
                  type="email"
                  name="contact[email]"
                  value="{{ contact.fields.email }}"
                  placeholder="{{ placeholder }}"
                  autocomplete="email"
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                    data-text-color="alert"
                  {% endif %}
                  {% if block.settings.required %}
                    required
                  {% endif %}
                />

              {%- when 'phone' -%}
                <label for="{{ section.id }}-contact_phone" data-item="hidden-text">
                  {{- block.settings.placeholder -}}
                </label>
                <input
                  id="{{ section.id }}-contact_phone"
                  type="tel"
                  name="contact[phone]"
                  value="{{ contact.fields.phone }}"
                  placeholder="{{ placeholder }}"
                  autocomplete="tel"
                  {% if form.errors contains 'phone' %}
                    aria-invalid="true"
                    data-text-color="alert"
                  {% endif %}
                  {% if block.settings.required %}
                    required
                  {% endif %}
                />

              {%- when 'message' -%}
                <label for="{{ section.id }}-contact_textarea" data-item="hidden-text">
                  {{- block.settings.placeholder -}}
                </label>
                <textarea
                  id="{{ section.id }}-contact_textarea"
                  rows="5"
                  cols="60"
                  name="contact[body]"
                  placeholder="{{ placeholder }}"
                  {% if form.errors contains 'body' %}
                    data-text-color="alert"
                  {% endif %}
                  {% if block.settings.required %}
                    required
                  {% endif %}
                >{{ contact.fields.body }}</textarea>

              {%- when 'checkbox' -%}
                <input
                  id="{{ section.id }}-checkbox-{{ block.id }}"
                  type="checkbox"
                  name="contact[{{ block.settings.label | strip_html | handleize }}]"
                  value="yes"
                  {% if block.settings.required %}
                    required
                  {% endif %}
                />
                <label for="{{ section.id }}-checkbox-{{ block.id }}" data-item="rte-content">
                  {%- if block.settings.required %}*{% endif -%}{{- block.settings.label -}}
                </label>

              {%- when 'select' -%}
                <label for="{{ section.id }}-contact_select_{{ block.id }}">
                  {{- block.settings.label }}{% if block.settings.required %}*{% endif -%}
                </label>

                <select
                  id="{{ section.id }}-contact_select_{{ block.id }}"
                  name="contact[{{ block.settings.label | handleize }}]"
                  {% if block.settings.required %}
                    required
                  {% endif %}
                >
                  {%- assign options = 'placeholder,a,b,c,d,e' | split: ',' -%}
                  {%- for option_key in options -%}
                    {%- assign option_id = 'option_' | append: option_key -%}
                    {%- assign option_value = block.settings[option_id] -%}
                    {%- if option_key == 'placeholder' -%}
                      <option value="">
                        {{- option_value | default: '- Pick an option -' -}}
                      </option>
                    {%- elsif option_value != blank -%}
                      <option value="{{ option_value }}">
                        {{- option_value -}}
                      </option>
                    {%- endif -%}
                  {%- endfor -%}
                </select>

              {%- when 'heading' -%}
                {%- unless block.settings.heading == blank -%}
                  <h3
                    class="contact--heading"
                    data-item="{{ block.settings.heading-type }}"
                  >
                    {{- block.settings.heading | escape -}}
                  </h3>
                {%- endunless -%}

              {%- when 'description' -%}
                {%- unless block.settings.description == blank -%}
                  <div class="contact--description" data-item="paragraph">
                    {{- block.settings.description -}}
                  </div>
                {%- endunless -%}

              {%- when 'empty-space' -%}
                {%- comment -%}
                  Empty space is handled by CSS variables in the block wrapper
                {%- endcomment -%}

              {%- when 'custom-liquid' -%}
                {{- block.settings.liquid -}}

            {%- endcase -%}
          </div>
        {%- endfor -%}

        <div
          {% if section.settings.show-recaptcha-terms %}
            data-item="caption"
          {% else %}
            data-item="hidden-text"
          {% endif %}
        >
          {{ 'shopify.online_store.spam_detection.disclaimer_html' | t }}
        </div>
      </div>

      <div
        class="contact--button-container"
        data-container="block"
        data-x-alignment="{{ x_alignment }}"
      >
        <button
          type="submit"
          class="contact--button"
          data-item="{{ section.settings.button-style }}"
          data-text="{{ section.settings.button-text }}"
          aria-busy="false"
          onclick="this.form.checkValidity() && this.setAttribute('aria-busy', true)"
        >
          <span class="contact--button-text">
            {{- section.settings.button-text -}}
          </span>
          <span class="contact--button-spinner">
            {%- render 'icons', icon: 'spinner' -%}
          </span>
        </button>
      </div>

      {%- if form.posted_successfully? -%}
        <script>window.location.hash = '#feedback-bar--contact-form';</script>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  .contact--blocks {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing--item);

    @media (min-width: 768px) {
      flex-direction: row;
    }

    @media (max-width: 767px) {
      flex-direction: column;
    }
  }

  .contact--block {
    flex: 1 1 100%;
    width: 100%;
    align-self: flex-end;

    &[data-block-type='checkbox'] {
      display: flex;
      align-items: center;
      gap: var(--spacing--2);

      & label {
        display: inline-flex;
        padding: 0;
      }
    }

    &[data-block-type='empty-space'] {
      @media (min-width: 768px) {
        min-height: var(--desktop-height);
        margin-top: var(--spacing--neg-item);
      }

      @media (max-width: 767px) {
        min-height: var(--mobile-height);
        margin-top: var(--spacing--neg-item);
      }
    }

    @media (min-width: 768px) {
      &[data-half-width='true'] {
        max-width: calc(50% - var(--spacing--item) / 2);
      }
    }

    & input,
    & select,
    & textarea {
      margin: 0;
    }
  }

  .contact--button-container {
    margin-top: var(--spacing--item);
  }

  .contact--button {
    &[aria-busy='true'] {
      .contact--button-text {
        opacity: 0;
      }
    }

    &[aria-busy='false'] {
      .contact--button-spinner {
        opacity: 0;
      }
    }

    @media (min-width: 768px) {
      .contact--root[data-container-width='1'] & {
        width: 100%;
      }
    }

    @media (max-width: 767px) {
      width: 100%;
    }
  }
{% endstylesheet %}

