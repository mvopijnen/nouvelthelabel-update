<div id="ShippingSection-{{ section.id }}" class="shipping-wrapper">
  
  <!-- Spacer (Optioneel) -->
  <div class="main-spacer"></div>

  <!-- Hero Section -->
  <header class="hero-section">
    <div class="hero-bg-pattern"></div>
    <div class="container-custom relative text-center">
      {% if section.settings.hero_title != blank %}
        <h1 class="banner-heading fade-in stagger-1">{{ section.settings.hero_title }}</h1>
      {% endif %}
      {% if section.settings.hero_subtitle != blank %}
        <p class="section-heading fade-in stagger-2" style="margin-bottom: 2rem;">{{ section.settings.hero_subtitle }}</p>
      {% endif %}
      <div class="hero-divider fade-in stagger-3"></div>
      {% if section.settings.hero_text != blank %}
        <div class="paragraph-text hero-text fade-in stagger-4">
          {{ section.settings.hero_text }}
        </div>
      {% endif %}
    </div>
  </header>

  <!-- How It Works Section -->
  <section class="content-section bg-secondary">
    <div class="container-custom">
      <div class="text-center section-header">
        <p class="overline-text">{{ section.settings.timeline_label }}</p>
        <h2 class="featured-heading">{{ section.settings.timeline_title }}</h2>
      </div>
      
      <div class="timeline-container">
        <!-- Vertical Line (Desktop only) -->
        <div class="timeline-line"></div>
        
        <div class="timeline-steps">
          
          <!-- Step 1 -->
          <div class="step-card step-left slide-up stagger-1">
            <div class="step-content text-right-desktop">
              <span class="large-number">{{ section.settings.step1_num }}</span>
              <h3 class="block-heading">{{ section.settings.step1_title }}</h3>
              <p class="paragraph-text">{{ section.settings.step1_text }}</p>
            </div>
            <div class="step-icon-container icon-left">
              <div class="step-circle">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>
              </div>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="step-card step-right slide-up stagger-2 step-mt">
            <div class="step-icon-container icon-right">
              <div class="step-circle">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
              </div>
            </div>
            <div class="step-content">
              <span class="large-number">{{ section.settings.step2_num }}</span>
              <h3 class="block-heading">{{ section.settings.step2_title }}</h3>
              <p class="overline-text" style="margin-bottom: 0.75rem;">{{ section.settings.step2_sub }}</p>
              <p class="paragraph-text">{{ section.settings.step2_text }}</p>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="step-card step-left slide-up stagger-3 step-mt">
            <div class="step-content text-right-desktop">
              <span class="large-number">{{ section.settings.step3_num }}</span>
              <h3 class="block-heading">{{ section.settings.step3_title }}</h3>
              <p class="paragraph-text">{{ section.settings.step3_text }}</p>
            </div>
            <div class="step-icon-container icon-left">
              <div class="step-circle">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
              </div>
            </div>
          </div>

          <!-- Step 4 -->
          <div class="step-card step-right slide-up stagger-4 step-mt">
            <div class="step-icon-container icon-right">
              <div class="step-circle">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              </div>
            </div>
            <div class="step-content">
              <span class="large-number">{{ section.settings.step4_num }}</span>
              <h3 class="block-heading">{{ section.settings.step4_title }}</h3>
              <p class="paragraph-text">{{ section.settings.step4_text }}</p>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Delivery Times Section -->
  <section class="content-section bg-primary">
    <div class="container-custom">
      <div class="text-center section-header">
        <p class="overline-text">{{ section.settings.times_label }}</p>
        <h2 class="featured-heading">{{ section.settings.times_title }}</h2>
      </div>
      
      <div class="grid-3">
        <!-- NL & BE -->
        <div class="delivery-card slide-up stagger-1">
          <div class="icon-box">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9" /></svg>
          </div>
          <h3 class="block-heading">{{ section.settings.region1_name }}</h3>
          <p class="large-number text-primary">{{ section.settings.region1_days }}</p>
          <p class="overline-text">{{ section.settings.region1_sub }}</p>
          <p class="paragraph-text">{{ section.settings.region1_text }}</p>
        </div>
        
        <!-- Europe -->
        <div class="delivery-card slide-up stagger-2">
          <div class="icon-box">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h3 class="block-heading">{{ section.settings.region2_name }}</h3>
          <p class="large-number text-primary">{{ section.settings.region2_days }}</p>
          <p class="overline-text">{{ section.settings.region2_sub }}</p>
          <p class="paragraph-text">{{ section.settings.region2_text }}</p>
        </div>
        
        <!-- Worldwide -->
        <div class="delivery-card slide-up stagger-3">
          <div class="icon-box">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>
          </div>
          <h3 class="block-heading">{{ section.settings.region3_name }}</h3>
          <p class="large-number text-primary">{{ section.settings.region3_days }}</p>
          <p class="overline-text">{{ section.settings.region3_sub }}</p>
          <p class="paragraph-text">{{ section.settings.region3_text }}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Shipping Costs Section -->
  <section class="content-section bg-secondary">
    <div class="container-custom">
      <div class="text-center section-header">
        <p class="overline-text">{{ section.settings.costs_label }}</p>
        <h2 class="featured-heading">{{ section.settings.costs_title }}</h2>
      </div>
      
      <div class="grid-2 costs-grid">
        <!-- Free Shipping (Dark Box) -->
        <div class="slide-up stagger-1 h-full">
          <div class="cost-card dark-cost-card">
            <div class="cost-header">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7" /></svg>
              <h3 class="section-heading">{{ section.settings.free_title }}</h3>
            </div>
            
            <div class="cost-row divider-dark">
              <p class="overline-text">{{ section.settings.free_r1_region }}</p>
              <p class="block-heading">{{ section.settings.free_r1_title }}</p>
              <p class="paragraph-text">{{ section.settings.free_r1_text }}</p>
            </div>
            
            <div class="cost-row" style="padding-top: 1.5rem;">
              <p class="overline-text">{{ section.settings.free_r2_region }}</p>
              <p class="block-heading">{{ section.settings.free_r2_title }}</p>
              <p class="paragraph-text">{{ section.settings.free_r2_text }}</p>
            </div>
          </div>
        </div>
        
        <!-- Standard Rates (Light Box) -->
        <div class="slide-up stagger-2 h-full">
          <div class="cost-card light-cost-card">
            <h3 class="section-heading" style="margin-bottom: 2rem;">{{ section.settings.standard_title }}</h3>
            
            <div class="cost-row divider-light flex-between">
              <div>
                <p class="overline-text">{{ section.settings.std_r1_region }}</p>
                <p class="paragraph-text">{{ section.settings.std_r1_text }}</p>
              </div>
              <p class="section-heading">{{ section.settings.std_r1_price }}</p>
            </div>
            
            <div class="cost-row flex-between" style="padding-top: 1.5rem;">
              <div>
                <p class="overline-text">{{ section.settings.std_r2_region }}</p>
                <p class="paragraph-text">{{ section.settings.std_r2_text }}</p>
              </div>
              <p class="section-heading">{{ section.settings.std_r2_price }}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why 1-2 Days Section -->
  <section class="content-section dark-section">
    <div class="container-custom" style="max-width: 900px;">
      <div class="grid-2 align-center">
        <div class="slide-up stagger-1">
          <p class="overline-text">{{ section.settings.why_label }}</p>
          <h2 class="featured-heading" style="margin-bottom: 1.5rem;">{{ section.settings.why_title }}</h2>
          <p class="paragraph-text" style="color: #ffffff; margin-bottom: 1.5rem;">{{ section.settings.why_subtitle }}</p>
          <p class="paragraph-text" style="line-height: 1.7;">{{ section.settings.why_text }}</p>
        </div>
        
        <div class="slide-up stagger-2">
          <div class="check-box">
            <h3 class="overline-text" style="margin-bottom: 1.5rem;">{{ section.settings.why_list_title }}</h3>
            <ul class="check-list">
              <li><span class="dot"></span><span class="paragraph-text" style="color: #ffffff;">{{ section.settings.why_l1 }}</span></li>
              <li><span class="dot"></span><span class="paragraph-text" style="color: #ffffff;">{{ section.settings.why_l2 }}</span></li>
              <li><span class="dot"></span><span class="paragraph-text" style="color: #ffffff;">{{ section.settings.why_l3 }}</span></li>
              <li><span class="dot"></span><span class="paragraph-text" style="color: #ffffff;">{{ section.settings.why_l4 }}</span></li>
            </ul>
            
            <div class="badge-container">
              <p class="paragraph-text">{{ section.settings.why_result }}</p>
              <div class="quality-badge shimmer">
                <span class="section-heading" style="margin: 0; padding: 0;">{{ section.settings.badge_num }}</span> 
                <span class="overline-text" style="margin: 0;">{{ section.settings.badge_text }}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="content-section bg-primary">
    <div class="container-custom" style="max-width: 800px;">
      <div class="text-center section-header">
        <p class="overline-text">{{ section.settings.contact_label }}</p>
        <h2 class="featured-heading">{{ section.settings.contact_title }}</h2>
      </div>
      
      <div class="grid-2 gap-small">
        <!-- Email -->
        <a href="mailto:{{ section.settings.email }}" class="contact-card slide-up stagger-1">
          <div class="contact-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          </div>
          <h3 class="block-heading">Email</h3>
          <p class="paragraph-text font-bold text-primary" style="margin-bottom: 0.5rem;">{{ section.settings.email }}</p>
          <p class="paragraph-text">{{ section.settings.email_sub }}</p>
        </a>
        
        <!-- WhatsApp -->
        <a href="https://wa.me/{{ section.settings.whatsapp_clean }}" target="_blank" rel="noopener noreferrer" class="contact-card slide-up stagger-2">
          <div class="contact-icon">
            <svg fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" /></svg>
          </div>
          <h3 class="block-heading">WhatsApp</h3>
          <p class="paragraph-text font-bold text-primary" style="margin-bottom: 0.5rem;">{{ section.settings.whatsapp_display }}</p>
          <p class="paragraph-text">{{ section.settings.whatsapp_sub }}</p>
        </a>
      </div>
    </div>
  </section>

</div>

<style>
  /* ------------------- GLOBALS & LAYOUT ------------------- */
  #ShippingSection-{{ section.id }} {
    margin-top: {{ section.settings.spacing_above }};
    margin-bottom: {{ section.settings.spacing_below }};
  }

  #ShippingSection-{{ section.id }} .bg-primary { background-color: {{ section.settings.bg_primary }}; }
  #ShippingSection-{{ section.id }} .bg-secondary { background-color: {{ section.settings.bg_secondary }}; }
  
  #ShippingSection-{{ section.id }} .text-primary { color: {{ section.settings.title_color }}; }
  
  #ShippingSection-{{ section.id }} .container-custom {
    max-width: 1024px;
    margin: 0 auto;
    padding: 0 24px;
  }

  #ShippingSection-{{ section.id }} .content-section {
    padding: 80px 0;
  }
  
  #ShippingSection-{{ section.id }} .section-header {
    margin-bottom: 64px;
  }

  /* ------------------- TYPOGRAPHY ------------------- */
  #ShippingSection-{{ section.id }} .banner-heading {
    font-size: 27px;
    letter-spacing: 1px;
    color: {{ section.settings.title_color }};
    text-transform: uppercase;
    font-weight: 400;
    line-height: 1.2;
    overflow-wrap: break-word;
    margin: 0 0 1rem 0;
  }
  
  #ShippingSection-{{ section.id }} .featured-heading {
    font-size: 24px;
    letter-spacing: 1px;
    color: {{ section.settings.title_color }};
    text-transform: uppercase;
    font-weight: 400;
    line-height: 1.2;
    overflow-wrap: break-word;
    margin: 0 0 1rem 0;
  }
  
  #ShippingSection-{{ section.id }} .section-heading {
    font-size: 13px;
    letter-spacing: 1px;
    color: {{ section.settings.title_color }};
    text-transform: uppercase;
    font-weight: 400;
    margin: 0 0 1rem 0;
  }
  
  #ShippingSection-{{ section.id }} .block-heading {
    font-size: 11px;
    letter-spacing: 1px;
    color: {{ section.settings.title_color }};
    text-transform: uppercase;
    font-weight: 400;
    margin: 0 0 0.75rem 0;
  }
  
  #ShippingSection-{{ section.id }} .paragraph-text {
    font-size: 11px;
    letter-spacing: 0px;
    color: {{ section.settings.text_color }};
    text-transform: none;
    font-weight: 300;
    line-height: 1.6;
    margin: 0;
  }
  
  #ShippingSection-{{ section.id }} .paragraph-text p { margin: 0 0 1rem 0; }
  #ShippingSection-{{ section.id }} .paragraph-text p:last-child { margin: 0; }
  
  #ShippingSection-{{ section.id }} .overline-text {
    font-size: 10px;
    letter-spacing: 1px;
    color: {{ section.settings.subtitle_color }};
    text-transform: uppercase;
    font-weight: 400;
    margin: 0 0 0.5rem 0;
  }
  
  #ShippingSection-{{ section.id }} .large-number {
    font-size: 40px;
    font-weight: 300;
    line-height: 1;
    color: {{ section.settings.border_color }};
    display: block;
    margin-bottom: 0.5rem;
  }

  #ShippingSection-{{ section.id }} .font-bold { font-weight: 500; }
  #ShippingSection-{{ section.id }} .text-center { text-align: center; }

  /* ------------------- HERO ------------------- */
  #ShippingSection-{{ section.id }} .hero-section {
    position: relative;
    background-color: {{ section.settings.bg_primary }};
    padding: 80px 0;
    overflow: hidden;
  }

  #ShippingSection-{{ section.id }} .hero-bg-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.05;
    background-image: radial-gradient(circle at 20% 50%, {{ section.settings.title_color }} 1px, transparent 1px);
    background-size: 40px 40px;
  }

  #ShippingSection-{{ section.id }} .hero-divider {
    width: 64px;
    height: 1px;
    background-color: {{ section.settings.title_color }};
    margin: 0 auto 2rem auto;
  }

  #ShippingSection-{{ section.id }} .hero-text {
    max-width: 600px;
    margin: 0 auto;
  }

  /* ------------------- TIMELINE ------------------- */
  #ShippingSection-{{ section.id }} .timeline-container {
    position: relative;
  }

  #ShippingSection-{{ section.id }} .timeline-line {
    display: none;
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(to bottom, {{ section.settings.border_color }} 0%, {{ section.settings.border_color }} 100%);
    transform: translateX(-50%);
  }

  #ShippingSection-{{ section.id }} .timeline-steps {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  #ShippingSection-{{ section.id }} .step-card {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  #ShippingSection-{{ section.id }} .step-icon-container {
    display: none;
  }

  #ShippingSection-{{ section.id }} .step-circle {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-color: {{ section.settings.title_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  #ShippingSection-{{ section.id }} .step-circle svg {
    width: 28px;
    height: 28px;
    color: {{ section.settings.bg_primary }};
  }

  #ShippingSection-{{ section.id }} .step-card:hover .step-circle {
    transform: scale(1.1);
    box-shadow: 0 0 0 8px rgba(0, 0, 0, 0.05);
  }

  /* ------------------- DELIVERY CARDS ------------------- */
  #ShippingSection-{{ section.id }} .grid-3 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  #ShippingSection-{{ section.id }} .delivery-card {
    background-color: {{ section.settings.bg_secondary }};
    border: 1px solid {{ section.settings.border_color }};
    padding: 32px;
    text-align: center;
    transition: all 0.3s ease;
  }

  #ShippingSection-{{ section.id }} .delivery-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
  }

  #ShippingSection-{{ section.id }} .icon-box {
    width: 48px;
    height: 48px;
    margin: 0 auto 24px auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  #ShippingSection-{{ section.id }} .icon-box svg {
    width: 40px;
    height: 40px;
    color: {{ section.settings.title_color }};
  }

  /* ------------------- COSTS SECTION ------------------- */
  #ShippingSection-{{ section.id }} .costs-grid {
    max-width: 800px;
    margin: 0 auto;
  }

  #ShippingSection-{{ section.id }} .cost-card {
    padding: 32px;
    height: 100%;
  }

  #ShippingSection-{{ section.id }} .dark-cost-card {
    background-color: {{ section.settings.dark_bg }};
  }

  #ShippingSection-{{ section.id }} .light-cost-card {
    background-color: {{ section.settings.bg_primary }};
    border: 1px solid {{ section.settings.border_color }};
  }

  #ShippingSection-{{ section.id }} .cost-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
  }

  #ShippingSection-{{ section.id }} .cost-header svg {
    width: 24px;
    height: 24px;
    color: {{ section.settings.dark_text }};
  }
  
  #ShippingSection-{{ section.id }} .dark-cost-card .section-heading,
  #ShippingSection-{{ section.id }} .dark-cost-card .block-heading { color: {{ section.settings.dark_text }}; }
  #ShippingSection-{{ section.id }} .dark-cost-card .paragraph-text { color: {{ section.settings.dark_subtext }}; }
  #ShippingSection-{{ section.id }} .dark-cost-card .overline-text { color: {{ section.settings.dark_subtext }}; opacity: 0.8; }

  #ShippingSection-{{ section.id }} .divider-dark { border-bottom: 1px solid {{ section.settings.dark_border }}; padding-bottom: 1rem; }
  #ShippingSection-{{ section.id }} .divider-light { border-bottom: 1px solid {{ section.settings.border_color }}; padding-bottom: 1rem; }

  #ShippingSection-{{ section.id }} .flex-between {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  /* ------------------- WHY 1-2 DAYS SECTION ------------------- */
  #ShippingSection-{{ section.id }} .dark-section {
    background-color: {{ section.settings.dark_bg }};
  }

  #ShippingSection-{{ section.id }} .dark-section .banner-heading,
  #ShippingSection-{{ section.id }} .dark-section .featured-heading,
  #ShippingSection-{{ section.id }} .dark-section .section-heading,
  #ShippingSection-{{ section.id }} .dark-section .block-heading { color: {{ section.settings.dark_text }}; }
  
  #ShippingSection-{{ section.id }} .dark-section .paragraph-text { color: {{ section.settings.dark_subtext }}; }
  #ShippingSection-{{ section.id }} .dark-section .overline-text { color: {{ section.settings.dark_subtext }}; opacity: 0.8; }

  #ShippingSection-{{ section.id }} .check-box {
    background-color: {{ section.settings.dark_bg_lighter }};
    padding: 32px;
    border: 1px solid {{ section.settings.dark_border }};
  }

  #ShippingSection-{{ section.id }} .check-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  #ShippingSection-{{ section.id }} .check-list li {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  #ShippingSection-{{ section.id }} .dot {
    width: 8px;
    height: 8px;
    background-color: {{ section.settings.dark_text }};
    border-radius: 50%;
    flex-shrink: 0;
  }

  #ShippingSection-{{ section.id }} .badge-container {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid {{ section.settings.dark_border }};
  }

  #ShippingSection-{{ section.id }} .quality-badge {
    background: linear-gradient(135deg, {{ section.settings.dark_bg }} 0%, {{ section.settings.dark_border }} 100%);
    padding: 8px 16px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 4px;
  }

  #ShippingSection-{{ section.id }} .shimmer {
    background-image: linear-gradient(90deg, transparent, rgba(255,255,255,0.05), transparent);
    background-size: 200% 100%;
    animation: shimmer 2s infinite;
  }

  /* ------------------- CONTACT SECTION ------------------- */
  #ShippingSection-{{ section.id }} .gap-small { gap: 32px; }
  
  #ShippingSection-{{ section.id }} .contact-card {
    display: block;
    background-color: {{ section.settings.bg_secondary }};
    border: 1px solid {{ section.settings.border_color }};
    padding: 32px;
    text-align: center;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  #ShippingSection-{{ section.id }} .contact-card:hover {
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
  }

  #ShippingSection-{{ section.id }} .contact-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 24px auto;
    border-radius: 50%;
    background-color: {{ section.settings.border_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
  }

  #ShippingSection-{{ section.id }} .contact-card:hover .contact-icon {
    background-color: {{ section.settings.title_color }};
  }

  #ShippingSection-{{ section.id }} .contact-icon svg {
    width: 24px;
    height: 24px;
    color: {{ section.settings.title_color }};
    transition: color 0.3s ease;
  }

  #ShippingSection-{{ section.id }} .contact-card:hover .contact-icon svg {
    color: {{ section.settings.bg_primary }};
  }

  /* ------------------- GRIDS & ANIMATIONS ------------------- */
  #ShippingSection-{{ section.id }} .grid-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  #ShippingSection-{{ section.id }} .align-center { align-items: center; }

  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }

  #ShippingSection-{{ section.id }} .fade-in { animation: fadeIn 0.8s ease forwards; opacity: 0; }
  #ShippingSection-{{ section.id }} .slide-up { animation: slideUp 0.6s ease forwards; opacity: 0; }
  
  #ShippingSection-{{ section.id }} .stagger-1 { animation-delay: 0.1s; }
  #ShippingSection-{{ section.id }} .stagger-2 { animation-delay: 0.2s; }
  #ShippingSection-{{ section.id }} .stagger-3 { animation-delay: 0.3s; }
  #ShippingSection-{{ section.id }} .stagger-4 { animation-delay: 0.4s; }

  /* ------------------- RESPONSIVE (DESKTOP) ------------------- */
  @media (min-width: 768px) {
    #ShippingSection-{{ section.id }} .hero-section { padding: 120px 0; }
    #ShippingSection-{{ section.id }} .content-section { padding: 112px 0; }
    
    #ShippingSection-{{ section.id }} .grid-2 { grid-template-columns: 1fr 1fr; gap: 48px; }
    #ShippingSection-{{ section.id }} .grid-3 { grid-template-columns: repeat(3, 1fr); gap: 24px; }
    
    /* Timeline Desktop */
    #ShippingSection-{{ section.id }} .timeline-line { display: block; }
    #ShippingSection-{{ section.id }} .timeline-steps { gap: 0; }
    
    #ShippingSection-{{ section.id }} .step-card {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      align-items: center;
    }
    
    #ShippingSection-{{ section.id }} .step-mt { margin-top: 96px; }
    
    #ShippingSection-{{ section.id }} .step-icon-container {
      display: flex;
    }
    
    #ShippingSection-{{ section.id }} .icon-left { justify-content: flex-start; padding-left: 48px; }
    #ShippingSection-{{ section.id }} .icon-right { justify-content: flex-end; padding-right: 48px; }
    
    #ShippingSection-{{ section.id }} .text-right-desktop { text-align: right; padding-right: 48px; }
    
    #ShippingSection-{{ section.id }} .step-right .step-icon-container { order: 1; }
    #ShippingSection-{{ section.id }} .step-right .step-content { order: 2; padding-left: 48px; }
  }

  /* ------------------- RESPONSIVE (MOBILE) ------------------- */
  @media (max-width: 767px) {
    #ShippingSection-{{ section.id }} {
      margin-top: {{ section.settings.mobile_spacing_above }};
      margin-bottom: {{ section.settings.mobile_spacing_below }};
    }
    #ShippingSection-{{ section.id }} .banner-heading { font-size: 24px; }
    #ShippingSection-{{ section.id }} .featured-heading { font-size: 20px; }
    #ShippingSection-{{ section.id }} .large-number { font-size: 32px; }
    #ShippingSection-{{ section.id }} .content-section { padding: 60px 0; }
    #ShippingSection-{{ section.id }} .section-header { margin-bottom: 40px; }
    #ShippingSection-{{ section.id }} .gap-small { gap: 24px; }
  }
</style>

