{
  "name": "nouvelthelabel-theme-validation",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node scripts/browser-regression.cjs",
    "validate": "python3 scripts/validate-theme.py",
    "theme-check": "node scripts/theme-check.mjs",
    "package": "python3 scripts/package-theme.py",
    "preview:check": "node scripts/shopify-preview.mjs check",
