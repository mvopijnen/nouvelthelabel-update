    "test:performance": "node scripts/preview-performance.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@shopify/cli": "4.8.4",
    "jsdom": "26.1.0",
    "lighthouse": "13.0.1",
    "liquidjs": "10.21.1",
    "playwright-core": "1.56.1"
  }
}
