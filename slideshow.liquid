<!-- sections/slideshow.liquid -->

{%- liquid
  assign arrows_enabled = section.settings.arrows-enabled
  assign aspect_ratio = 100.0 | divided_by: section.settings.aspect-ratio | round: 4
  assign auto_rotate = section.settings.auto-rotate
  assign bg_color = section.settings.background-color
  assign border = section.settings.border
  assign container_width = section.settings.container-width
  assign display_type = section.settings.image-display-type
  assign heading_type = section.settings.heading-type
  assign mobile_display_type = section.settings.mobile-image-display-type
  assign mobile_aspect_ratio = 100.0 | divided_by: section.settings.mobile-aspect-ratio | round: 4
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign overlay_style = section.settings.overlay-style
  assign rotate_frequency = section.settings.rotate-frequency
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign text_bg_color = section.settings.text-background-color
  assign text_style = section.settings.text-style
  assign transition_type = section.settings.transition-type
  assign text_color = section.settings.text-color

  # OPTIMALISATIE: Bepaal of dit de belangrijkste sectie voor de browser is (LCP)
  assign is_lcp_section = false
  if section.index == 1
    assign is_lcp_section = true
  endif
-%}

{%- if is_lcp_section and section.blocks.size > 0 -%}
  {%- comment -%}
    Forceer de browser om de eerste afbeelding direct te downloaden met hoge prioriteit.
    Dit voorkomt dat de browser wacht op scripts of CSS.
  {%- endcomment -%}
  {%- assign lcp_image = section.blocks[0].settings.media-1 -%}
  {%- if lcp_image -%}
    <link rel="preload" as="image" href="{{ lcp_image | image_url: width: 2000 }}" fetchpriority="high">
  {%- endif -%}
{%- endif -%}

{%- capture slideshow_blocks -%}
  {%- # We lopen door de blokken om de 'is_lcp' status per slide door te geven -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign is_lcp_slide = false
      if is_lcp_section and forloop.first
        assign is_lcp_slide = true
      endif
    -%}
    {%-
      render 'slideshow-blocks',
      block: block,
      heading_type: heading_type,
      image_aspect_ratio: aspect_ratio,
      image_display_type: display_type,
      mobile_image_display_type: mobile_display_type,
      mobile_image_aspect_ratio: mobile_aspect_ratio,
      overlay_style: overlay_style,
      section_index: section.index,
      text_bg_color: text_bg_color,
      text_style: text_style,
      text_color: text_color,
      transition_type: transition_type,
      is_lcp: is_lcp_slide
    -%}
    {%- unless forloop.last -%}
      <span class="divider"></span>
    {%- endunless -%}
  {%- endfor -%}
{%- endcapture -%}

{%- assign slideshow_blocks = slideshow_blocks | split: '<span class="divider"></span>' -%}

<div
  class="slideshow--root"
  id="slideshow-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-background-color="{{ bg_color }}"
  data-border="{{ border }}"
  data-container-width="{{ container_width }}"
  data-header-overlap-compatible
  data-mobile-full-width="true"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
>
  <div class="slideshow--wrapper">
    {%-
      render 'slideshow-carousel',
      blocks: slideshow_blocks,
      arrows_enabled: arrows_enabled,
      auto_rotate: auto_rotate,
      pagination_enabled: true,
      rotate_frequency: rotate_frequency,
      transition_type: transition_type
    -%}
  </div>
</div>

